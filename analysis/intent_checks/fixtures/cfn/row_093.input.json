 "resources": [
  {
   "id": "PolicyStore",
   "cfg": "PolicyStore",
   "type": "AWS::VerifiedPermissions::PolicyStore",
   "values": {
    "Description": "Final version of the Cedar policy store that will be recreated independently.",
    "ValidationSettings": {
     "Mode": "STRICT"
    },
    "Schema": {
     "CedarJson": "{\n  \"Bookstore\": {\n    \"actions\": {\n      \"View\": {\n        \"appliesTo\": {\n          \"resourceTypes\": [\n            \"Book\"\n          ],\n          \"context\": {\n            \"type\": \"Record\",\n            \"attributes\": {\n              \"region\": {\n                \"required\": true,\n                \"type\": \"String\"\n              }\n            }\n          },\n          \"principalTypes\": [\n            \"User\"\n          ]\n        },\n        \"memberOf\": []\n      },\n      \"ViewWithPremiumOffers\": {\n        \"appliesTo\": {\n          \"principalTypes\": [\n            \"User\"\n          ],\n          \"context\": {\n            \"type\": \"Record\",\n            \"attributes\": {\n              \"region\": {\n                \"required\": true,\n                \"type\": \"String\"\n              }\n            }\n          },\n          \"resourceTypes\": [\n            \"Book\"\n          ]\n        },\n        \"memberOf\": []\n      }\n    },\n    \"entityTypes\": {\n      \"Role\": {\n        \"memberOfTypes\": [],\n        \"shape\": {\n          \"type\": \"Record\",\n          \"attributes\": {}\n        }\n      },\n      \"User\": {\n        \"memberOfTypes\": [\n          \"Role\"\n        ],\n        \"shape\": {\n          \"type\": \"Record\",\n          \"attributes\": {\n            \"yearsAsMember\": {\n              \"type\": \"Long\",\n              \"required\": false\n            }\n          }\n        }\n      },\n      \"Book\": {\n        \"memberOfTypes\": [],\n        \"shape\": {\n          \"attributes\": {\n            \"owner\": {\n              \"type\": \"Entity\",\n              \"required\": true,\n              \"name\": \"User\"\n            }\n          },\n          \"type\": \"Record\"\n        }\n      }\n    }\n  }\n}\n"
    }
   },
   "refs": []
  },
  {
   "id": "PolicyStoreIdSSM",
   "cfg": "PolicyStoreIdSSM",
   "type": "AWS::SSM::Parameter",
   "values": {
    "Type": "String",
    "Name": "/bookstore-demo-app-with-authz/authorization/policy-store-id",
    "Value": {
     "ref": "PolicyStore"
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "RbacAdminStaticPolicy",
   "cfg": "RbacAdminStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Allows admins to list all books",
      "Statement": "permit (\n  principal in Bookstore::Role::\"Admin\",\n  action in [ Bookstore::Action::\"View\" ],\n  resource\n);\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "RbacAdminForbidStaticPolicy",
   "cfg": "RbacAdminForbidStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Denies admin Frank to list all books",
      "Statement": "forbid (\n  principal == Bookstore::User::\"Frank\",\n  action in [ Bookstore::Action::\"View\" ],\n  resource\n);\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "RbacResourceOwnerStaticPolicy",
   "cfg": "RbacResourceOwnerStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Allows publishers to list books they have published",
      "Statement": "permit (\n  principal in Bookstore::Role::\"Publisher\",\n  action in [ Bookstore::Action::\"View\" ],\n  resource\n)\nwhen {\n  principal == resource.owner\n};\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "RbacExplicitStaticPolicy",
   "cfg": "RbacExplicitStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Allows specific Publisher to list a specific book",
      "Statement": "permit (\n  principal == Bookstore::User::\"Dante\",\n  action in [ Bookstore::Action::\"View\" ],\n  resource == Bookstore::Book::\"em1oadaa-b22k-4ea8-kk33-f6m217604o3m\"\n);\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "PermitAbacStaticPolicy",
   "cfg": "PermitAbacStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Allows customers with specific value for yearsAsMember attribute to list premium offers",
      "Statement": "permit (\n  principal in Bookstore::Role::\"Customer\",\n  action in [ Bookstore::Action::\"ViewWithPremiumOffers\" ],\n  resource\n)\nwhen { principal has yearsAsMember && principal.yearsAsMember >= 2 };\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "DenyAbacStaticPolicy",
   "cfg": "DenyAbacStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Denies customers with specific value for yearsAsMember attribute to list premium offers",
      "Statement": "forbid (\n  principal in Bookstore::Role::\"Customer\",\n  action in [ Bookstore::Action::\"ViewWithPremiumOffers\" ],\n  resource\n)\nwhen { principal has yearsAsMember && principal.yearsAsMember < 2 };\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
  {
   "id": "ContextStaticPolicy",
   "cfg": "ContextStaticPolicy",
   "type": "AWS::VerifiedPermissions::Policy",
   "values": {
    "PolicyStoreId": {
     "ref": "PolicyStore"
    },
    "Definition": {
     "Static": {
      "Description": "Denies access for users outside the US region",
      "Statement": "forbid (\n  principal,\n  action in [ Bookstore::Action::\"View\", Bookstore::Action::\"ViewWithPremiumOffers\" ],\n  resource\n)\nwhen { context.region != \"US\" };\n"
     }
    }
   },
   "refs": [
    "PolicyStore"
   ]
  },
