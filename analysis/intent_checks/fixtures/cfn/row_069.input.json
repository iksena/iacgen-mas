       "Transform": {
        "Expression": "rpm / 60",
        "Variables": [
         {
          "Name": "rpm",
          "Value": {
           "PropertyLogicalId": "TurbineAssetModelRPMMeasurement"
          }
         }
        ]
       },
       "TypeName": "Transform"
      },
      "Unit": "RPS"
     },
     {
      "DataType": "DOUBLE",
      "LogicalId": "TurbineAssetModelOverdriveStateTransform",
      "Name": "Overdrive State",
      "Type": {
       "Transform": {
        "Expression": "gte(torque,3)",
        "Variables": [
         {
          "Name": "torque",
          "Value": {
           "PropertyLogicalId": "TurbineAssetModelTorqueMeasurement"
          }
         }
        ]
       },
       "TypeName": "Transform"
      }
     },
