      "LogicalId": "TurbineAssetModelWindSpeedMeasurement",
      "Name": "Wind Speed",
      "Type": {
       "TypeName": "Measurement"
      },
      "Unit": "m/s"
     },
     {
      "DataType": "DOUBLE",
      "LogicalId": "TurbineAssetModelTorqueTransform",
      "Name": "Torque (Newton Meter)",
      "Type": {
       "Transform": {
        "Expression": "knm * 1000",
