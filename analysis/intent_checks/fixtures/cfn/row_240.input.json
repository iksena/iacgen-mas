  {
   "id": "ShapefileGlueServiceRole",
   "cfg": "ShapefileGlueServiceRole",
   "type": "AWS::IAM::Role",
   "values": {
    "RoleName": "MapAppraiserShapefileGlueServiceRole",
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": [
         "glue.amazonaws.com"
        ]
       },
       "Action": [
        "sts:AssumeRole"
       ]
      }
     ]
    },
    "ManagedPolicyArns": [
     "arn:aws:iam::aws:policy/service-role/AWSGlueServiceRole"
    ],
    "Policies": [
     {
      "PolicyName": "S3AccessPolicy",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "s3:GetObject",
          "s3:ListBucket"
         ],
         "Resource": [
          "arn:aws:s3:::map-appraiser-data-raw-gis",
          "arn:aws:s3:::map-appraiser-data-raw-gis/*"
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "s3:PutObject",
          "s3:GetObject",
          "s3:ListBucket"
         ],
         "Resource": [
          "arn:aws:s3:::map-appraiser-data-knowledge-base",
          "arn:aws:s3:::map-appraiser-data-knowledge-base/*"
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "s3:GetObject",
          "s3:ListBucket"
         ],
         "Resource": [
          "arn:aws:s3:::map-appraiser-glue-scripts",
          "arn:aws:s3:::map-appraiser-glue-scripts/*"
         ]
        }
       ]
      }
     },
     {
      "PolicyName": "CloudWatchLogsPolicy",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": [
          "*"
         ]
        }
       ]
      }
     }
    ]
   },
   "refs": []
  },
  {
   "id": "ShapefileToGeoJsonGlueJob",
   "cfg": "ShapefileToGeoJsonGlueJob",
   "type": "AWS::Glue::Job",
   "values": {
    "Name": "map-appraiser-shapefile-to-geojson-etl",
    "Role": {
     "ref": "ShapefileGlueServiceRole",
     "attr": "Arn"
    },
    "Command": {
     "Name": "glueetl",
     "ScriptLocation": "s3://map-appraiser-glue-scripts/shapefile_to_geojson_etl.py",
     "PythonVersion": "3"
    },
    "DefaultArguments": {
     "--enable-metrics": "true",
     "--enable-continuous-cloudwatch-log": "true",
     "--enable-spark-ui": "true",
     "--spark-event-logs-path": "s3://map-appraiser-glue-scripts/spark-logs/",
     "--job-bookmark-option": "job-bookmark-enable",
     "--job-language": "python",
     "--TempDir": "s3://map-appraiser-glue-scripts/temp/",
     "--additional-python-modules": "geopandas==0.14.1,shapely==2.0.2,pyproj==3.6.1,fiona==1.9.5"
    },
    "ExecutionProperty": {
     "MaxConcurrentRuns": 1
    },
    "GlueVersion": "4.0",
    "MaxRetries": 0,
    "NumberOfWorkers": 5,
    "WorkerType": "G.2X",
    "Timeout": 2880,
    "Description": "ETL job to convert Shapefiles to individual GeoJSON files for knowledge base"
   },
   "refs": [
    "ShapefileGlueServiceRole"
   ]
  },
