   "id": "ArtifactBucketKey",
   "cfg": "ArtifactBucketKey",
   "type": "AWS::KMS::Key",
   "values": {
    "Description": "CMK for IDP artifact bucket encryption \u2014 managed by stack",
    "EnableKeyRotation": true,
    "KeyPolicy": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Sid": "AllowAccountRootFullControl",
       "Effect": "Allow",
       "Principal": {
        "AWS": [
         "arn:aws:iam::123456789012:root"
        ]
       },
       "Action": [
        "kms:*"
       ],
       "Resource": [
        "*"
       ]
      },
      {
       "Sid": "AllowS3ServiceUse",
       "Effect": "Allow",
       "Principal": {
        "Service": [
         "s3.amazonaws.com"
        ]
       },
       "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
       ],
       "Resource": [
        "*"
       ]
      }
     ]
    },
    "Tags": [
     {
      "Key": "Name",
      "Value": "stack-ArtifactBucketKey"
     },
     {
      "Key": "ManagedBy",
      "Value": "CloudFormation"
     }
    ],
    "__resource__": {
     "DeletionPolicy": "Retain",
     "UpdateReplacePolicy": "Retain"
    }
   },
   "refs": []
  },
