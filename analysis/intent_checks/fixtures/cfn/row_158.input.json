     "UserData": "#!/bin/bash\nset -e\ndnf install -y python3\ncat > /home/ec2-user/index.html <<'HTML'\n<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\" />\n  <title>AWS Standby - OCI Primary DR</title>\n</head>\n<body>\n  <h1>Hello from AWS Standby</h1>\n  <p>Blueprint: aws-oci-cross-cloud-dr</p>\n  <p>Role: AWS standby</p>\n  <p>Primary cloud: OCI</p>\n</body>\n</html>\nHTML\nnohup python3 -m http.server 80 --directory /home/ec2-user >/var/log/standby-http.log 2>&1 &\n"
    }
