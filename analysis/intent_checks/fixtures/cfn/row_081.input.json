  {
   "id": "AsyncSFn",
   "cfg": "AsyncSFn",
   "type": "AWS::StepFunctions::StateMachine",
   "values": {
    "DefinitionString": "{\n    \"Comment\": \"Sample Standard Workflow for Asynchronous Execution by API Gateway\",\n    \"StartAt\": \"Wait for 5 Seconds\",\n    \"States\": {\n        \"Send Message to WebSocket Client\": {\n            \"End\": true,\n            \"Parameters\": {\n                \"ApiEndpoint\": \"${definition_substitution_1}\",\n                \"AuthType\": \"IAM_ROLE\",\n                \"Method\": \"POST\",\n                \"Path.$\": \"States.Format('/@connections/{}', $.ConnectionID)\",\n                \"RequestBody\": {\n                    \"Message\": \"Hello from asynchronous workflow execution!\"\n                },\n                \"Stage\": \"${definition_substitution_2}\"\n            },\n            \"Resource\": \"arn:aws:states:::apigateway:invoke\",\n            \"Type\": \"Task\"\n        },\n        \"Wait for 5 Seconds\": {\n            \"Next\": \"Send Message to WebSocket Client\",\n            \"Seconds\": 5,\n            \"Type\": \"Wait\"\n        }\n    }\n}",
    "RoleArn": "${AsyncSFnRole.Arn}",
    "StateMachineType": "STANDARD",
    "Tags": [
     {
      "Key": "stateMachine:createdBy",
      "Value": "SAM"
     }
    ],
    "DefinitionSubstitutions": {
     "definition_substitution_1": "${WebSocketApi}.execute-api.us-east-1.amazonaws.com",
     "definition_substitution_2": "api"
    },
    "TracingConfiguration": {
     "Enabled": true
    }
   },
   "refs": [
    "AsyncSFnRole",
    "WebSocketApi"
   ]
  },
