 "resources": [
  {
   "id": "IAMRoleForDLM",
   "cfg": "IAMRoleForDLM",
   "type": "AWS::IAM::Role",
   "values": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": [
         "dlm.amazonaws.com"
        ]
       },
       "Action": [
        "sts:AssumeRole"
       ]
      }
     ]
    },
    "Description": "A role required for DLM.",
    "Policies": [
     {
      "PolicyName": "EC2Access",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "ec2:CreateSnapshot",
          "ec2:CreateSnapshots",
          "ec2:DeleteSnapshot",
          "ec2:DescribeVolumes",
          "ec2:DescribeInstances",
          "ec2:DescribeSnapshots"
         ],
         "Resource": [
          "*"
         ]
        },
        {
         "Effect": "Allow",
         "Action": [
          "ec2:CreateTags"
         ],
         "Resource": [
          "arn:aws:ec2:*::snapshot/*"
         ]
        }
       ]
      }
     }
    ],
    "RoleName": "WebServers-DataLifecycleManager-us-east-1",
    "Tags": [
     {
      "Key": "environment",
      "Value": "production"
     },
     {
      "Key": "createdby",
      "Value": "aws-cloudformation-templates"
     }
    ]
   },
   "refs": []
  },
  {
   "id": "DataLifecycleManager",
   "cfg": "DataLifecycleManager",
   "type": "AWS::DLM::LifecyclePolicy",
   "values": {
    "Description": "Lifecycle Policy",
    "ExecutionRoleArn": {
     "ref": "IAMRoleForDLM",
     "attr": "Arn"
    },
    "PolicyDetails": {
     "ResourceTypes": [
      "VOLUME"
     ],
     "Schedules": [
      {
       "CopyTags": true,
       "CreateRule": {
        "Interval": 24,
        "IntervalUnit": "HOURS",
        "Times": [
         "17:00"
        ]
       },
       "Name": "Daily Snapshots",
       "RetainRule": {
        "Count": 7
       }
      }
     ],
     "TargetTags": [
      {
       "Key": "environment",
       "Value": "production"
      },
      {
       "Key": "createdby",
       "Value": "aws-cloudformation-templates"
      }
     ]
    },
    "Tags": [
     {
      "Key": "Name",
      "Value": "policy-WebServers-us-east-1"
     },
     {
      "Key": "environment",
      "Value": "production"
     },
     {
      "Key": "createdby",
      "Value": "aws-cloudformation-templates"
     }
    ],
    "State": "ENABLED"
   },
   "refs": [
    "IAMRoleForDLM"
   ]
  },
