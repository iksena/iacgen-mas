  {
   "id": "UpdateMovieFunction",
   "cfg": "UpdateMovieFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "update_movie",
    "Role": {
     "ref": "LambdaExecutionRole",
     "attr": "Arn"
    },
    "Runtime": "python3.12",
    "Timeout": 30,
    "MemorySize": 128,
    "Handler": "index.lambda_handler",
    "Environment": {
     "Variables": {
      "TABLE_NAME": {
       "ref": "MoviesTable"
      }
     }
    },
    "Code": {
     "ZipFile": "import boto3\nfrom decimal import Decimal\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    title  = event['title']  if event.get('title')  else ''\n    rating = event['rating'] if event.get('rating') else '0.0'\n    plot   = event['plot']   if event.get('plot')   else ''\n\n    response = table.update_item(\n        Key={'title': title},\n        UpdateExpression='set info.rating=:r, info.plot=:p',\n        ExpressionAttributeValues={\n            ':r': Decimal(str(rating)),\n            ':p': plot\n        },\n        ReturnValues='UPDATED_NEW'\n    )\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': str(response)\n    }\n"
    },
    "__resource__": {
     "DependsOn": [
      "UpdateMovieLogGroup"
     ]
    }
   },
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ]
  },
  {
   "id": "DeleteMovieFunction",
   "cfg": "DeleteMovieFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "delete_movie",
    "Role": {
     "ref": "LambdaExecutionRole",
     "attr": "Arn"
    },
    "Runtime": "python3.12",
    "Timeout": 30,
    "MemorySize": 128,
    "Handler": "index.lambda_handler",
    "Environment": {
     "Variables": {
      "TABLE_NAME": {
       "ref": "MoviesTable"
      }
     }
    },
    "Code": {
     "ZipFile": "import boto3\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    title = event['title']\n    response = table.delete_item(\n        Key={'title': title},\n        ConditionExpression='attribute_exists(info.actors)',\n        ReturnValues='ALL_OLD'\n    )\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': str(response)\n    }\n"
    },
    "__resource__": {
     "DependsOn": [
      "DeleteMovieLogGroup"
     ]
    }
   },
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ]
