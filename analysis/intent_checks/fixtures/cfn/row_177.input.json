  {
   "id": "__declared__.AWS::Lambda::Function.CreateMovieFunction",
   "cfg": "CreateMovieFunction",
   "type": "__declared__",
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ],
   "values": {
    "type": "AWS::Lambda::Function",
    "name": "CreateMovieFunction",
    "gated": false,
    "gate": null,
    "properties": {
     "FunctionName": "create_movie",
     "Role": {
      "ref": "LambdaExecutionRole",
      "attr": "Arn"
     },
     "Runtime": "python3.12",
     "Timeout": 30,
     "MemorySize": 128,
     "Handler": "index.lambda_handler",
     "Environment": {
      "Variables": {
       "TABLE_NAME": {
        "ref": "MoviesTable"
       }
      }
     },
     "Code": {
      "ZipFile": "import boto3\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    year   = event['year']   if event.get('year')   else '0'\n    title  = event['title']  if event.get('title')  else ''\n    actors = event['actors'] if event.get('actors') else ''\n\n    response = table.put_item(\n        Item={\n            'year': year,\n            'title': title,\n            'info': {\n                'actors': actors\n            }\n        }\n    )\n\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': str(response)\n    }\n"
     }
    }
   }
  },
  {
   "id": "__declared__.AWS::Lambda::Function.GetMovieFunction",
   "cfg": "GetMovieFunction",
   "type": "__declared__",
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ],
   "values": {
    "type": "AWS::Lambda::Function",
    "name": "GetMovieFunction",
    "gated": false,
    "gate": null,
    "properties": {
     "FunctionName": "get_movie",
     "Role": {
      "ref": "LambdaExecutionRole",
      "attr": "Arn"
     },
     "Runtime": "python3.12",
     "Timeout": 30,
     "MemorySize": 128,
     "Handler": "index.lambda_handler",
     "Environment": {
      "Variables": {
       "TABLE_NAME": {
        "ref": "MoviesTable"
       }
      }
     },
     "Code": {
      "ZipFile": "import boto3\nimport json\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    title = event['title']\n    response = table.get_item(Key={'title': title})\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': json.dumps(response.get('Item', {}), default=str)\n    }\n"
     }
    }
   }
  },
  {
   "id": "__declared__.AWS::Lambda::Function.UpdateMovieFunction",
   "cfg": "UpdateMovieFunction",
   "type": "__declared__",
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ],
   "values": {
    "type": "AWS::Lambda::Function",
    "name": "UpdateMovieFunction",
    "gated": false,
    "gate": null,
    "properties": {
     "FunctionName": "update_movie",
     "Role": {
      "ref": "LambdaExecutionRole",
      "attr": "Arn"
     },
     "Runtime": "python3.12",
     "Timeout": 30,
     "MemorySize": 128,
     "Handler": "index.lambda_handler",
     "Environment": {
      "Variables": {
       "TABLE_NAME": {
        "ref": "MoviesTable"
       }
      }
     },
     "Code": {
      "ZipFile": "import boto3\nfrom decimal import Decimal\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    title  = event['title']  if event.get('title')  else ''\n    rating = event['rating'] if event.get('rating') else '0.0'\n    plot   = event['plot']   if event.get('plot')   else ''\n\n    response = table.update_item(\n        Key={'title': title},\n        UpdateExpression='set info.rating=:r, info.plot=:p',\n        ExpressionAttributeValues={\n            ':r': Decimal(str(rating)),\n            ':p': plot\n        },\n        ReturnValues='UPDATED_NEW'\n    )\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': str(response)\n    }\n"
     }
    }
   }
  },
  {
   "id": "__declared__.AWS::Lambda::Function.DeleteMovieFunction",
   "cfg": "DeleteMovieFunction",
   "type": "__declared__",
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ],
   "values": {
    "type": "AWS::Lambda::Function",
    "name": "DeleteMovieFunction",
    "gated": false,
    "gate": null,
    "properties": {
     "FunctionName": "delete_movie",
     "Role": {
      "ref": "LambdaExecutionRole",
      "attr": "Arn"
     },
     "Runtime": "python3.12",
     "Timeout": 30,
     "MemorySize": 128,
     "Handler": "index.lambda_handler",
     "Environment": {
      "Variables": {
       "TABLE_NAME": {
        "ref": "MoviesTable"
       }
      }
     },
     "Code": {
      "ZipFile": "import boto3\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    title = event['title']\n    response = table.delete_item(\n        Key={'title': title},\n        ConditionExpression='attribute_exists(info.actors)',\n        ReturnValues='ALL_OLD'\n    )\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': str(response)\n    }\n"
     }
    }
   }
