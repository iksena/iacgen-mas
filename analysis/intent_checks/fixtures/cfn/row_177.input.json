  {
   "id": "CreateMovieFunction",
   "cfg": "CreateMovieFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "create_movie",
    "Role": {
     "ref": "LambdaExecutionRole",
     "attr": "Arn"
    },
    "Runtime": "python3.12",
    "Timeout": 30,
    "MemorySize": 128,
    "Handler": "index.lambda_handler",
    "Environment": {
     "Variables": {
      "TABLE_NAME": {
       "ref": "MoviesTable"
      }
     }
    },
    "Code": {
     "ZipFile": "import boto3\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    year   = event['year']   if event.get('year')   else '0'\n    title  = event['title']  if event.get('title')  else ''\n    actors = event['actors'] if event.get('actors') else ''\n\n    response = table.put_item(\n        Item={\n            'year': year,\n            'title': title,\n            'info': {\n                'actors': actors\n            }\n        }\n    )\n\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': str(response)\n    }\n"
    },
    "__resource__": {
     "DependsOn": [
      "CreateMovieLogGroup"
     ]
    }
   },
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ]
  },
  {
   "id": "GetMovieFunction",
   "cfg": "GetMovieFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "get_movie",
    "Role": {
     "ref": "LambdaExecutionRole",
     "attr": "Arn"
    },
    "Runtime": "python3.12",
    "Timeout": 30,
    "MemorySize": 128,
    "Handler": "index.lambda_handler",
    "Environment": {
     "Variables": {
      "TABLE_NAME": {
       "ref": "MoviesTable"
      }
     }
    },
    "Code": {
     "ZipFile": "import boto3\nimport json\n\ndynamodb = boto3.resource('dynamodb')\ntable = dynamodb.Table('movies')\n\ndef lambda_handler(event, context):\n    title = event['title']\n    response = table.get_item(Key={'title': title})\n    return {\n        'statusCode': 200,\n        'headers': {'Content-Type': 'application/json'},\n        'body': json.dumps(response.get('Item', {}), default=str)\n    }\n"
    },
    "__resource__": {
     "DependsOn": [
      "GetMovieLogGroup"
     ]
    }
   },
   "refs": [
    "LambdaExecutionRole",
    "MoviesTable"
   ]
