   "id": "__declared__.AWS::KMS::Key.ApiGatewayLogsKMSKey",
   "cfg": "ApiGatewayLogsKMSKey",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "AWS::KMS::Key",
    "name": "ApiGatewayLogsKMSKey",
    "gated": false,
    "gate": null,
    "properties": {
     "Description": "KMS key for encrypting API Gateway CloudWatch Logs",
     "EnableKeyRotation": true,
     "KeyPolicy": {
      "Version": "2012-10-17",
      "Statement": [
       {
        "Sid": "Enable IAM User Permissions",
        "Effect": "Allow",
        "Principal": {
         "AWS": [
          "arn:aws:iam::123456789012:root"
         ]
        },
        "Action": [
         "kms:Create*",
         "kms:Describe*",
         "kms:Enable*",
         "kms:List*",
         "kms:Put*",
         "kms:Update*",
         "kms:Revoke*",
         "kms:Disable*",
         "kms:Get*",
         "kms:Delete*",
         "kms:Decrypt",
         "kms:ScheduleKeyDeletion",
         "kms:CancelKeyDeletion"
        ],
        "Resource": [
         "arn:aws:kms:us-east-1:123456789012:key/*"
        ]
       },
       {
        "Sid": "Allow CloudWatch Logs",
        "Effect": "Allow",
        "Principal": {
         "Service": [
          "logs.us-east-1.amazonaws.com"
         ]
        },
        "Action": [
         "kms:Encrypt*",
         "kms:Decrypt*",
         "kms:ReEncrypt*",
         "kms:GenerateDataKey*",
         "kms:Describe*"
        ],
        "Resource": [
         "arn:aws:kms:us-east-1:123456789012:key/*"
        ],
        "Condition": {
         "ArnLike": {
          "kms:EncryptionContext:aws:logs:arn": "arn:aws:logs:us-east-1:123456789012:*"
         }
        }
       }
      ]
     }
    }
   }
  },
