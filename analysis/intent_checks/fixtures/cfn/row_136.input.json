  {
   "id": "PostSignupFunction",
   "cfg": "PostSignupFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "Handler": "index.lambda_handler",
    "Runtime": "python3.13",
    "Role": {
     "ref": "PostSignupFunctionRole",
     "attr": "Arn"
    },
    "Timeout": 10,
    "Code": {
     "ZipFile": "import boto3\n\ndef lambda_handler(event, context):\n    user_pool_id = event['userPoolId']\n    username = event['userName']\n    client = boto3.client('cognito-idp')\n\n    # Add user to 'customer' group\n    try:\n        client.admin_add_user_to_group(\n            UserPoolId=user_pool_id,\n            Username=username,\n            GroupName='Customer'\n        )\n        print(f\"User {username} added to 'customer' group.\")\n    except Exception as e:\n        print(f\"Error adding user to group: {e}\")\n\n    return event\n"
    }
   },
   "refs": [
    "PostSignupFunctionRole"
   ]
  },
