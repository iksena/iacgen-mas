   "id": "PostSignupFunctionRole",
   "cfg": "PostSignupFunctionRole",
   "type": "AWS::IAM::Role",
   "values": {
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
