        "sts:AssumeRole"
       ]
      }
     ]
    },
    "Policies": [
     {
      "PolicyName": "AllowBasicLogs",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "logs:CreateLogGroup",
          "logs:CreateLogStream",
          "logs:PutLogEvents"
         ],
         "Resource": [
          "arn:aws:logs:*:*:*"
         ]
        }
       ]
      }
     },
     {
