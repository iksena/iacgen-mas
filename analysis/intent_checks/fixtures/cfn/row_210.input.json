        "dynamodb:Create*",
        "dynamodb:Delete*",
        "dynamodb:Update*",
        "dynamodb:PutItem"
       ],
       "Resource": [
        "${ bsdynamodb.Arn}"
       ]
      },
      {
       "Sid": "DDBLSIActions",
       "Action": [
        "dynamodb:Query",
        "dynamodb:Scan"
       ],
       "Effect": "Allow",
       "Resource": [
        "${ bsdynamodb.Arn}/index/*"
       ]
      }
     ]
    },
