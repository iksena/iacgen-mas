  {
   "id": "IDPAuthRoleS3Policy",
   "cfg": "IDPAuthRoleS3Policy",
   "type": "AWS::IAM::Policy",
   "values": {
    "PolicyName": "nih-grants-cognito-auth-role",
    "PolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Action": [
        "s3:PutObject",
        "s3:PutObjectTagging",
        "s3:PutObjectAcl",
        "s3:GetObject",
        "s3:DeleteObject"
       ],
       "Resource": [
        "arn:aws:s3:::nih-grants-context-us-east-1-123456789012/*"
       ]
      },
      {
       "Effect": "Allow",
       "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
       ],
       "Resource": [
        "*"
       ],
       "Condition": {
        "StringLike": {
         "kms:RequestAlias": "alias/nih-grants-s3-key"
        }
       }
      },
      {
       "Effect": "Allow",
       "Action": [
        "execute-api:Invoke"
       ],
       "Resource": [
        "arn:aws:execute-api:us-east-1:123456789012:*/*/$connect"
       ]
      }
     ]
    },
    "Roles": [
     {
      "ref": "IDPAuthRole"
     }
    ],
    "__resource__": {
     "DependsOn": [
      "IDPAuthRole"
     ]
    }
   },
   "refs": [
    "IDPAuthRole"
   ]
  },
