  {
   "id": "CleanupLambdaFunction",
   "cfg": "CleanupLambdaFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "DynamoDBCleanupFunction",
    "Handler": "index.handler",
    "Runtime": "python3.12",
    "Role": {
     "ref": "CleanupFunctionRole",
     "attr": "Arn"
    },
    "Timeout": 300,
    "Environment": {
     "Variables": {
      "TABLE_NAME": "throttle"
     }
    },
    "Code": {
     "ZipFile": "import os\nimport boto3\nfrom zoneinfo import ZoneInfo\nfrom datetime import datetime, timedelta\n\ndef handler(event, context):\n    table_name = os.environ['TABLE_NAME']\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    table_keys = {ks[\"KeyType\"]: ks[\"AttributeName\"] for ks in table.key_schema}\n    timestamp = datetime.now(ZoneInfo('UTC')).isoformat()\n\n    deleted = 0\n    with table.batch_writer() as batch:\n        next_page_token = None\n        while True:\n            response = table.scan(Limit=1_000, **(dict(ExclusiveStartKey=next_page_token) if next_page_token else {}))\n            next_page_token = response.get(\"LastEvaluatedKey\")\n            for item in response.get('Items', []):\n                # Replace this condition with your own cleanup logic\n                if item[table_keys[\"RANGE\"]] <= timestamp:\n                    batch.delete_item(Key={k: item[k] for k in table_keys.values()})\n                    deleted += 1\n            if next_page_token is None:\n                break\n\n    print(f\"Deleted {deleted} items.\")\n"
    },
    "__resource__": {
     "DependsOn": [
      "CleanupLogGroup"
     ]
    }
   },
   "refs": [
    "CleanupFunctionRole"
   ]
  },
