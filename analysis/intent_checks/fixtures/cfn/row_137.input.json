   ]
  },
  {
   "id": "PutPriceFunctionBCEE0C38",
   "cfg": "PutPriceFunctionBCEE0C38",
   "type": "AWS::AppSync::FunctionConfiguration",
   "values": {
    "ApiId": {
     "ref": "AppSyncAPID0E760D2",
     "attr": "ApiId"
    },
    "DataSourceName": "APIDDBTable",
    "FunctionVersion": "2018-05-29",
    "Name": "PutPriceHistoryForTicker",
    "RequestMappingTemplate": "      #set($now = $util.time.nowISO8601())\n      {\n        \"version\" : \"2018-05-29\",\n        \"operation\" : \"PutItem\",\n        \"key\": {\n            \"hk\": $util.dynamodb.toDynamoDBJson($ctx.stash.get(\"ticker\")),\n            \"sk\": $util.dynamodb.toDynamoDBJson(\"price_$now\")\n        },\n        \"attributeValues\" : {\n          \"ticker\": $util.dynamodb.toDynamoDBJson($ctx.stash.get(\"ticker\")),\n          \"timestamp\": $util.dynamodb.toDynamoDBJson($now),\n          \"priceUSD\": $util.dynamodb.toDynamoDBJson($ctx.prev.result.usd)\n        }\n      }",
    "ResponseMappingTemplate": "\n        $util.toJson($ctx.prev.result)\n      ",
    "__resource__": {
     "DependsOn": [
      "AppSyncAPISchemaB1D44998",
      "DDBTableDataSource43262F9B"
     ],
     "Metadata": {
      "aws:cdk:path": "InfraStack/PutPriceFunction/Resource"
     }
    }
   },
   "refs": [
    "AppSyncAPID0E760D2"
   ]
  },
  {
   "id": "QueryTickerResolver3944763D",
   "cfg": "QueryTickerResolver3944763D",
   "type": "AWS::AppSync::Resolver",
   "values": {
    "ApiId": {
     "ref": "AppSyncAPID0E760D2",
     "attr": "ApiId"
    },
    "FieldName": "ticker",
    "TypeName": "Query",
    "Kind": "PIPELINE",
    "PipelineConfig": {
     "Functions": [
      {
       "ref": "GetPriceFunctionD6891917",
       "attr": "FunctionId"
      },
      {
       "ref": "PutPriceFunctionBCEE0C38",
       "attr": "FunctionId"
      }
     ]
    },
    "RequestMappingTemplate": "      $util.qr($ctx.stash.put(\"ticker\", \"$ctx.args.ticker\"))\n      {}\n      ",
    "ResponseMappingTemplate": "{\n        \"ticker\": \"$ctx.args.ticker\",\n        \"latestPrice\": $util.toJson($ctx.prev.result)\n      }",
    "__resource__": {
     "DependsOn": [
      "AppSyncAPISchemaB1D44998"
     ],
     "Metadata": {
      "aws:cdk:path": "InfraStack/QueryTickerResolver/Resource"
     }
    }
   },
   "refs": [
    "AppSyncAPID0E760D2",
    "GetPriceFunctionD6891917",
    "PutPriceFunctionBCEE0C38"
   ]
