   "id": "GetPriceFunctionD6891917",
   "cfg": "GetPriceFunctionD6891917",
   "type": "AWS::AppSync::FunctionConfiguration",
   "values": {
    "ApiId": {
     "ref": "AppSyncAPID0E760D2",
     "attr": "ApiId"
    },
    "DataSourceName": "PricesAPI",
    "FunctionVersion": "2018-05-29",
    "Name": "GetPriceForTicker",
    "RequestMappingTemplate": "      {\n          \"version\": \"2018-05-29\",\n          \"method\": \"GET\",\n          \"resourcePath\": \"/api/v3/simple/price?ids=${ctx.stash.get(\"ticker\")}&vs_currencies=usd\"\n      }",
    "ResponseMappingTemplate": "\n        #set($bodyContent = $util.parseJson($ctx.result.body))\n        $util.toJson($bodyContent.get(\"$ctx.args.ticker\"))\n      ",
    "__resource__": {
     "DependsOn": [
      "AppSyncAPISchemaB1D44998",
      "PriceDataSource1918AE11"
     ],
     "Metadata": {
      "aws:cdk:path": "InfraStack/GetPriceFunction/Resource"
     }
    }
   },
