   "id": "EchoFunction",
   "cfg": "EchoFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "Code": {
     "ZipFile": "import json\ndef handler(event, context):\n    ctx = event.get(\"requestContext\", {})\n    authorizer = ctx.get(\"authorizer\", {})\n    claims = authorizer.get(\"claims\", {})\n    return {\n        \"statusCode\": 200,\n        \"headers\": {\"Content-Type\": \"application/json\"},\n        \"body\": json.dumps({\n            \"path\": event.get(\"path\"),\n            \"method\": event.get(\"httpMethod\"),\n            \"claims\": claims,\n            \"message\": (\n                \"you are authenticated as \" + claims.get(\"email\", \"unknown\")\n                if claims else \"open endpoint \u2014 no claims\"\n            ),\n        }),\n    }\n"
    },
    "FunctionName": "dva-lab-04-05-echo",
    "Handler": "index.handler",
    "Role": {
     "ref": "EchoFunctionRole",
     "attr": "Arn"
    },
    "Runtime": "python3.12",
    "Tags": [
     {
      "Key": "lambda:createdBy",
      "Value": "SAM"
     }
    ]
   },
   "refs": [
    "EchoFunctionRole"
   ]
  },
