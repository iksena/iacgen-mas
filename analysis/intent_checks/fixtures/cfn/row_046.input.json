   "id": "ChaosStateMachine",
   "cfg": "ChaosStateMachine",
   "type": "AWS::StepFunctions::StateMachine",
   "values": {
    "StateMachineName": "ChaosTest",
    "RoleArn": {
     "ref": "StepFunctionRole",
     "attr": "Arn"
    },
    "DefinitionString": "{\n  \"StartAt\": \"TerminateInstance\",\n  \"States\": {\n    \"TerminateInstance\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"${ChaosLambda.Arn}\",\n      \"Next\": \"Wait\",\n      \"Parameters\": {\n        \"InstanceId\": \"i-1234567890abcdef0\"\n      }\n    },\n    \"Wait\": {\n      \"Type\": \"Wait\",\n      \"Seconds\": 300,\n      \"Next\": \"CheckHealth\"\n    },\n    \"CheckHealth\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"${HealthCheckLambda.Arn}\",\n      \"End\": true\n    }\n  }\n}\n"
   },
   "refs": [
    "ChaosLambda",
    "HealthCheckLambda",
    "StepFunctionRole"
   ]
  },
  {
   "id": "ChaosLambda",
   "cfg": "ChaosLambda",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "ChaosLambda",
    "Handler": "index.handler",
    "Role": {
     "ref": "LambdaExecutionRole",
     "attr": "Arn"
    },
    "Code": {
     "ZipFile": "import json\nimport boto3\n\ndef lambda_handler(event, context):\n    ec2 = boto3.client('ec2')\n    instance_id = event['InstanceId']\n    ec2.terminate_instances(InstanceIds=[instance_id])\n    return {'statusCode': 200, 'body': json.dumps('Instance terminated')}\n"
    },
    "Runtime": "python3.9",
    "Timeout": 30
   },
   "refs": [
    "LambdaExecutionRole"
   ]
  },
  {
   "id": "HealthCheckLambda",
   "cfg": "HealthCheckLambda",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "HealthCheckLambda",
    "Handler": "index.handler",
    "Role": {
     "ref": "LambdaExecutionRole",
     "attr": "Arn"
    },
    "Code": {
     "ZipFile": "import json\nimport boto3\n\ndef lambda_handler(event, context):\n    ecs = boto3.client('ecs')\n    response = ecs.describe_services(cluster='my-cluster', services=['my-service'])\n    healthy = response['services'][0]['runningCount'] > 0\n    if not healthy:\n        sns = boto3.client('sns')\n        sns.publish(\n            TopicArn='arn:aws:sns:us-east-1:123456789012:chaos-alerts',\n            Message='Service unhealthy after chaos test'\n        )\n    return {'statusCode': 200, 'body': json.dumps('Health check complete')}\n"
    },
    "Runtime": "python3.9",
    "Timeout": 30
   },
   "refs": [
    "LambdaExecutionRole"
   ]
  },
