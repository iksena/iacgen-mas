          }
         ]
        ]
       }
      },
      "ASGGroupArn": {
       "type": "String"
      }
     },
     "mainSteps": [
      {
       "name": "AutoScalingELBHealthCheck",
       "action": "aws:executeScript",
       "inputs": {
        "Runtime": "python3.6",
        "Handler": "script_handler",
        "Script": "def script_handler(events, context):\n  import boto3\n  import json\n  import os\n  client = boto3.client('autoscaling')\n  try:\n     ASGGroupArn = events['ASGGroupArn']\n     ASGId_1 = ASGGroupArn.split(':')[-1]\n     ASGGroupName = ASGId_1.replace(\"autoScalingGroupName/\",\"\")\n     response = client.update_auto_scaling_group(\n        AutoScalingGroupName= ASGGroupName,\n        HealthCheckType='ELB',\n        HealthCheckGracePeriod=300\n     )\n  except Exception as e:\n     print(e)\n     raise\n",
        "InputPayload": {
         "AutomationAssumeRole": "{{AutomationAssumeRole}}",
         "ASGGroupArn": "{{ASGGroupArn}}"
        }
       }
      }
     ]
    }
