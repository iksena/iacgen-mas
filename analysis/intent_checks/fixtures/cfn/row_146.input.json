     "AttributesRequireVerificationBeforeUpdate": [
      "email"
     ]
    },
    "AdminCreateUserConfig": {
     "InviteMessageTemplate": {
      "EmailSubject": "Your Hospitality Insights account",
      "EmailMessage": "<p>Hello,</p>\n<p>You have been invited to <strong>Hospitality Insights</strong>.</p>\n<p>Your login details:</p>\n<ul>\n  <li><strong>Username:</strong> {username}</li>\n  <li><strong>Temporary password:</strong> {####}</li>\n</ul>\n<p>Sign in at: <a href=\"\"></a></p>\n<p>You will be prompted to set a new password on first login.</p>\n"
     }
    },
    "LambdaConfig": {
     "PostAuthentication": {
      "ref": "PostAuthTriggerFunction",
      "attr": "Arn"
     }
    },
    "UserPoolTags": {
     "Environment": "prod",
     "Project": "hospitality-insights"
    }
   },
   "refs": [
    "PostAuthTriggerFunction"
   ]
  },
