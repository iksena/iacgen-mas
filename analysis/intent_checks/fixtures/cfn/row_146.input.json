  {
   "id": "PostAuthTriggerFunction",
   "cfg": "PostAuthTriggerFunction",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "hospitality-insights-post-auth-trigger-prod",
    "Runtime": "python3.12",
    "Handler": "index.lambda_handler",
    "Role": {
     "ref": "PostAuthTriggerRole",
     "attr": "Arn"
    },
    "Code": {
     "ZipFile": "import boto3\nfrom datetime import datetime, timezone\ncognito = boto3.client('cognito-idp')\ndef lambda_handler(event, context):\n    try:\n        cognito.admin_update_user_attributes(\n            UserPoolId=event['userPoolId'],\n            Username=event['userName'],\n            UserAttributes=[{'Name': 'custom:last_login', 'Value': datetime.now(timezone.utc).isoformat()}],\n        )\n    except Exception as e:\n        print(f\"post_auth_trigger: failed to update last_login: {e}\")\n    return event\n"
    },
    "Timeout": 10
   },
   "refs": [
    "PostAuthTriggerRole"
   ]
  },
  {
   "id": "PostAuthTriggerRole",
   "cfg": "PostAuthTriggerRole",
   "type": "AWS::IAM::Role",
   "values": {
    "RoleName": "hospitality-insights-post-auth-trigger-role-prod",
    "AssumeRolePolicyDocument": {
     "Version": "2012-10-17",
     "Statement": [
      {
       "Effect": "Allow",
       "Principal": {
        "Service": [
         "lambda.amazonaws.com"
        ]
       },
       "Action": [
        "sts:AssumeRole"
       ]
      }
     ]
    },
    "ManagedPolicyArns": [
     "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
    ],
    "Policies": [
     {
      "PolicyName": "CognitoUpdateAttributes",
      "PolicyDocument": {
       "Version": "2012-10-17",
       "Statement": [
        {
         "Effect": "Allow",
         "Action": [
          "cognito-idp:AdminUpdateUserAttributes"
         ],
         "Resource": [
          "arn:aws:cognito-idp:us-east-1:123456789012:userpool/*"
         ]
        }
       ]
      }
     }
    ]
   },
   "refs": []
  },
