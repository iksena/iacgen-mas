   "id": "__declared__.AWS::IAM::Role.AuthenticatedPooledUserRole",
   "cfg": "AuthenticatedPooledUserRole",
   "type": "__declared__",
   "refs": [
    "CognitoIdentityPool"
   ],
   "values": {
    "type": "AWS::IAM::Role",
    "name": "AuthenticatedPooledUserRole",
    "gated": false,
    "gate": null,
    "properties": {
     "RoleName": "authenticated-pooled-user-role",
     "AssumeRolePolicyDocument": {
      "Version": "2012-10-17",
      "Statement": [
       {
        "Effect": "Allow",
        "Principal": {
         "Federated": [
          "cognito-identity.amazonaws.com"
         ]
        },
        "Action": [
         "sts:AssumeRoleWithWebIdentity"
        ],
        "Condition": {
         "ForAnyValue:StringLike": {
          "cognito-identity.amazonaws.com:amr": "authenticated"
         },
         "StringEquals": {
          "cognito-identity.amazonaws.com:aud": {
           "ref": "CognitoIdentityPool"
          }
         }
        }
       },
       {
        "Effect": "Allow",
        "Principal": {
         "Federated": [
          "cognito-identity.amazonaws.com"
         ]
        },
        "Action": [
         "sts:TagSession"
        ],
        "Condition": {
         "ForAnyValue:StringLike": {
          "cognito-identity.amazonaws.com:amr": "authenticated"
         },
         "StringEquals": {
          "cognito-identity.amazonaws.com:aud": {
           "ref": "CognitoIdentityPool"
          }
         }
        }
       }
      ]
     },
     "Policies": [
      {
       "PolicyName": "authenticated-pooled-user-policy",
       "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
         {
          "Effect": "Allow",
          "Action": [
           "dynamodb:UpdateItem",
           "dynamodb:GetItem",
           "dynamodb:PutItem",
           "dynamodb:DeleteItem",
           "dynamodb:Query"
          ],
          "Resource": [
           "arn:aws:dynamodb:us-east-1:123456789012:table/Product-pooled"
          ],
          "Condition": {
           "ForAllValues:StringLike": {
            "dynamodb:LeadingKeys": [
             "${aws:PrincipalTag/tenantId}-*"
            ]
           }
          }
         },
         {
          "Effect": "Allow",
          "Action": [
           "dynamodb:UpdateItem",
           "dynamodb:GetItem",
           "dynamodb:PutItem",
           "dynamodb:DeleteItem",
           "dynamodb:Query"
          ],
          "Resource": [
           "arn:aws:dynamodb:us-east-1:123456789012:table/Order-pooled"
          ],
          "Condition": {
           "ForAllValues:StringLike": {
            "dynamodb:LeadingKeys": [
             "${aws:PrincipalTag/tenantId}-*"
            ]
           }
          }
         },
         {
          "Effect": "Allow",
          "Action": [
           "dynamodb:UpdateItem",
           "dynamodb:GetItem",
           "dynamodb:PutItem",
           "dynamodb:Query"
          ],
          "Resource": [
           "arn:aws:dynamodb:us-east-1:123456789012:table/SaaSOperations-TenantUserMapping",
           "arn:aws:dynamodb:us-east-1:123456789012:table/SaaSOperations-TenantDetails"
          ],
          "Condition": {
           "ForAllValues:StringLike": {
            "dynamodb:LeadingKeys": [
             "${aws:PrincipalTag/tenantId}"
            ]
           },
           "StringEquals": {
            "TenantAdmin": "${aws:PrincipalTag/userRole}"
           }
          }
         },
         {
          "Effect": "Allow",
          "Action": [
           "dynamodb:UpdateItem",
           "dynamodb:GetItem",
           "dynamodb:PutItem",
           "dynamodb:Query",
           "dynamodb:DeleteItem"
          ],
          "Resource": [
           "arn:aws:dynamodb:us-east-1:123456789012:table/SaaSOperations-TenantStackMapping",
           "arn:aws:dynamodb:us-east-1:123456789012:table/SaaSOperations-Settings"
          ],
          "Condition": {
           "StringEquals": {
            "TenantAdmin": "${aws:PrincipalTag/userRole}"
           }
          }
         },
         {
          "Effect": "Allow",
          "Action": [
           "dynamodb:UpdateItem",
           "dynamodb:GetItem",
           "dynamodb:PutItem",
           "dynamodb:Query",
           "dynamodb:DeleteItem",
           "dynamodb:Scan"
          ],
          "Resource": [
           "arn:aws:dynamodb:us-east-1:123456789012:table/*",
           "arn:aws:dynamodb:us-east-1:123456789012:table/*/index/*"
          ],
          "Condition": {
           "StringEquals": {
            "SystemAdmin": "${aws:PrincipalTag/userRole}"
           }
          }
         }
        ]
       }
      }
     ]
    }
   }
  },
