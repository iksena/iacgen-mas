    "value": "aws cognito-idp describe-user-pool-client \\\n  --user-pool-id ${UserPool} \\\n  --client-id ${MCPClient} \\\n  --region us-east-1 \\\n  --query 'UserPoolClient.ClientSecret' --output text\n",
