    "name": "MCPClientCredentialsExample",
    "value": "curl -s -X POST https://${UserPoolDomain}.auth.us-east-1.amazoncognito.com/oauth2/token \\\n  -H \"Content-Type: application/x-www-form-urlencoded\" \\\n  -u \"${MCPClient}:<MCP_CLIENT_SECRET>\" \\\n  -d \"grant_type=client_credentials&scope=api/mcp\"\n",
    "description": "Example: Gateway mints an MCP-bound token via client_credentials",
