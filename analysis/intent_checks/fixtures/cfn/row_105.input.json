  {
   "id": "__output__.PasswordGrantExample",
   "cfg": "__output__.PasswordGrantExample",
   "type": "__output__",
   "values": {
    "name": "PasswordGrantExample",
    "value": "curl -s -X POST https://cognito-idp.us-east-1.amazonaws.com/ \\\n  -H \"Content-Type: application/x-amz-json-1.1\" \\\n  -H \"X-Amz-Target: AWSCognitoIdentityProviderService.InitiateAuth\" \\\n  -d '{\n    \"AuthFlow\":\"USER_PASSWORD_AUTH\",\n    \"ClientId\":\"${WebClient}\",\n    \"AuthParameters\":{\"USERNAME\":\"<your-email>\",\"PASSWORD\":\"<your-password>\"}\n  }'\n",
    "description": "Example: get a JWT via password grant (after self-signup + email verify)",
    "export": null
   },
   "refs": [
    "WebClient"
   ]
  },
