       "ref": "RuleRole",
       "attr": "Arn"
      }
     }
    ]
   },
   "refs": [
    "OrganizationsAccountClosureStateMachine",
    "RuleRole"
   ]
  },
  {
   "id": "RuleRole",
   "cfg": "RuleRole",
   "type": "AWS::IAM::Role",
   "values": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": [
        "sts:AssumeRole"
       ],
       "Effect": "Allow",
       "Principal": {
        "Service": [
         "events.amazonaws.com"
        ]
       }
      }
     ],
     "Version": "2012-10-17"
    },
    "Policies": [
     {
      "PolicyDocument": {
       "Statement": [
        {
         "Action": [
          "states:StartExecution"
         ],
         "Effect": "Allow",
         "Resource": [
          {
           "ref": "OrganizationsAccountClosureStateMachine",
           "attr": "Arn"
          }
         ]
        }
       ],
       "Version": "2012-10-17"
      },
      "PolicyName": "StateMachineInvoke"
     }
    ]
   },
   "refs": [
    "OrganizationsAccountClosureStateMachine"
   ]
  },
  {
   "id": "StateMachineRole",
   "cfg": "StateMachineRole",
   "type": "AWS::IAM::Role",
   "values": {
    "AssumeRolePolicyDocument": {
     "Statement": [
      {
       "Action": [
        "sts:AssumeRole"
       ],
       "Effect": "Allow",
       "Principal": {
        "Service": [
