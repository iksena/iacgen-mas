  {
   "id": "EventBridgeRule",
   "cfg": "EventBridgeRule",
   "type": "AWS::Events::Rule",
   "values": {
    "Description": "Trigger AWSSupport-ConfigureEC2Metadata document to disable IMDSv1 when an EC2 Instance is started.",
    "EventPattern": {
     "source": [
      "aws.ec2"
     ],
     "detail-type": [
      "EC2 Instance State-change Notification"
     ],
     "detail": {
      "state": [
       "running"
      ]
     }
    },
    "Targets": [
     {
      "Arn": "arn:aws:ssm:us-east-1::automation-definition/AWSSupport-ConfigureEC2Metadata",
      "Id": "DisableIMDSv1Rule",
      "RoleArn": {
       "ref": "RuleAssumeRole",
       "attr": "Arn"
      },
      "InputTransformer": {
       "InputPathsMap": {
        "instance": "$.detail.instance-id"
       },
       "InputTemplate": "{\n  \"InstanceId\": [\"<instance>\"],\n  \"HttpPutResponseHopLimit\": [\"1\"],\n  \"EnforceIMDSv2\": [\"required\"],\n  \"MetadataAccess\": [\"enabled\"],\n  \"AutomationAssumeRole\": [\"${AutomationAssumeRole.Arn}\"]\n}"
      }
     }
    ]
   },
   "refs": [
    "AutomationAssumeRole",
    "RuleAssumeRole"
