  {
   "id": "ClientSecretLambda",
   "cfg": "ClientSecretLambda",
   "type": "AWS::Lambda::Function",
   "values": {
    "FunctionName": "protein-engineering-cognito-client-secret",
    "Description": "Custom resource Lambda to retrieve and store Cognito client secret",
    "Runtime": "python3.13",
    "Handler": "index.lambda_handler",
    "Role": {
     "ref": "ClientSecretLambdaRole",
     "attr": "Arn"
    },
    "Timeout": 60,
    "MemorySize": 128,
    "Code": {
     "ZipFile": "import json\nimport boto3\nimport cfnresponse\nimport logging\n\nlogger = logging.getLogger()\nlogger.setLevel(logging.INFO)\n\ncognito_client = boto3.client('cognito-idp')\nsecrets_client = boto3.client('secretsmanager')\n\ndef lambda_handler(event, context):\n    logger.info(f'Event: {json.dumps(event)}')\n\n    response_data = {}\n    physical_resource_id = event.get('PhysicalResourceId', 'CognitoClientSecret')\n\n    try:\n        request_type = event['RequestType']\n\n        if request_type == 'Create' or request_type == 'Update':\n            user_pool_id = event['ResourceProperties']['UserPoolId']\n            client_id = event['ResourceProperties']['ClientId']\n            secret_name = event['ResourceProperties']['SecretName']\n\n            # Retrieve client secret from Cognito\n            logger.info(f'Retrieving client secret for UserPoolId: {user_pool_id}, ClientId: {client_id}')\n            response = cognito_client.describe_user_pool_client(\n                UserPoolId=user_pool_id,\n                ClientId=client_id\n            )\n\n            client_secret = response['UserPoolClient']['ClientSecret']\n\n            # Store secret in Secrets Manager\n            secret_value = json.dumps({\n                'client_id': client_id,\n                'client_secret': client_secret,\n                'user_pool_id': user_pool_id\n            })\n\n            try:\n                # Try to create the secret\n                logger.info(f'Creating secret: {secret_name}')\n                secrets_client.create_secret(\n                    Name=secret_name,\n                    Description=f'Cognito client credentials for {user_pool_id}',\n                    SecretString=secret_value,\n                    Tags=[\n                        {'Key': 'Project', 'Value': event['ResourceProperties'].get('ProjectName', 'protein-engineering')},\n                        {'Key': 'ManagedBy', 'Value': 'CloudFormation'}\n                    ]\n                )\n            except secrets_client.exceptions.ResourceExistsException:\n                # Secret already exists, update it\n                logger.info(f'Secret exists, updating: {secret_name}')\n                secrets_client.put_secret_value(\n                    SecretId=secret_name,\n                    SecretString=secret_value\n                )\n\n            response_data['SecretArn'] = f'arn:aws:secretsmanager:{context.invoked_function_arn.split(\":\")[3]}:{context.invoked_function_arn.split(\":\")[4]}:secret:{secret_name}'\n            response_data['SecretName'] = secret_name\n\n            logger.info('Successfully stored client secret')\n            cfnresponse.send(event, context, cfnresponse.SUCCESS, response_data, physical_resource_id)\n\n        elif request_type == 'Delete':\n            secret_name = event['ResourceProperties']['SecretName']\n\n            try:\n                # Delete the secret\n                logger.info(f'Deleting secret: {secret_name}')\n                secrets_client.delete_secret(\n                    SecretId=secret_name,\n                    ForceDeleteWithoutRecovery=True\n                )\n                logger.info('Successfully deleted secret')\n            except secrets_client.exceptions.ResourceNotFoundException:\n                logger.info('Secret not found, nothing to delete')\n\n            cfnresponse.send(event, context, cfnresponse.SUCCESS, response_data, physical_resource_id)\n\n    except Exception as e:\n        logger.error(f'Error: {str(e)}', exc_info=True)\n        cfnresponse.send(event, context, cfnresponse.FAILED, {'Error': str(e)}, physical_resource_id)\n"
    },
    "Tags": [
     {
      "Key": "Project",
      "Value": "protein-engineering"
     },
     {
      "Key": "ManagedBy",
      "Value": "CloudFormation"
     }
    ]
   },
