  {
   "id": "EC2StateWatcher",
   "cfg": "EC2StateWatcher",
   "type": "AWS::StepFunctions::StateMachine",
   "values": {
    "DefinitionString": "{\n    \"StartAt\": \"What Happened?\",\n    \"States\": {\n        \"It's Gone\": {\n            \"End\": true,\n            \"Type\": \"Pass\"\n        },\n        \"It's Running\": {\n            \"End\": true,\n            \"Type\": \"Pass\"\n        },\n        \"It's Stopped\": {\n            \"End\": true,\n            \"Type\": \"Pass\"\n        },\n        \"What Happened?\": {\n            \"Choices\": [\n                {\n                    \"Next\": \"It's Running\",\n                    \"StringEquals\": \"running\",\n                    \"Variable\": \"$.state\"\n                },\n                {\n                    \"Next\": \"It's Stopped\",\n                    \"StringEquals\": \"stopped\",\n                    \"Variable\": \"$.state\"\n                },\n                {\n                    \"Next\": \"It's Gone\",\n                    \"StringEquals\": \"terminated\",\n                    \"Variable\": \"$.state\"\n                }\n            ],\n            \"Type\": \"Choice\"\n        }\n    }\n}",
    "LoggingConfiguration": {
     "Level": "ERROR",
     "Destinations": [
      {
       "CloudWatchLogsLogGroup": {
        "LogGroupArn": {
         "ref": "EC2StateWatcherLogs",
         "attr": "Arn"
        }
       }
      }
     ]
    },
    "RoleArn": {
     "ref": "EC2StateWatcherRole",
     "attr": "Arn"
    },
    "Tags": [
     {
      "Key": "stateMachine:createdBy",
      "Value": "SAM"
     }
    ]
   },
   "refs": [
    "EC2StateWatcherLogs",
    "EC2StateWatcherRole"
   ]
  },
