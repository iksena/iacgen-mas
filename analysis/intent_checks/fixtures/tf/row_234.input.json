   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "health_omics_user_policy",
    "gated": false,
    "gate": null,
    "properties": {
     "statement": [
      {
       "sid": "AllowPassRole",
       "actions": [
        "iam:PassRole"
       ],
       "resources": [
        "*"
       ],
       "condition": [
        {
         "test": "StringEquals",
         "variable": "iam:PassedToService",
         "values": [
          "omics.amazonaws.com"
         ]
        }
       ]
      },
      {
       "sid": "AllowOmicsActions",
       "actions": [
        "omics:*"
       ],
       "resources": [
        "*"
       ]
      },
      {
       "sid": "AllowS3ReadOnlyAccess",
       "actions": [
        "s3:GetObject",
        "s3:ListBucket"
       ],
       "resources": "${local.buckets}"
      },
      {
       "sid": "AllowReadLogs",
       "actions": [
        "logs:DescribeLogStreams",
        "logs:GetLogEvents"
       ],
       "resources": [
        "arn:aws:logs:${var.region}:${data.aws_caller_identity.current.account_id}:log-group:/aws/omics/*"
       ]
      }
     ]
    }
   }
  },
