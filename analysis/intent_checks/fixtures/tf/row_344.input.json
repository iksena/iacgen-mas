   "type": "__declared__",
   "refs": [
    "aws_iam_role.this"
   ],
   "values": {
    "type": "aws_iam_role_policy_attachment",
    "name": "this",
    "gated": true,
    "gate": "{ for k, v in var.policies : k => v if var.create }",
    "properties": {
     "for_each": "${{for k , v in var.policies : k => v if var.create}}",
     "role": "${aws_iam_role.this[0].name}",
     "policy_arn": "${each.value}"
    }
   }
