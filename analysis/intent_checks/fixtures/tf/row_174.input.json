   "values": {
    "type": "aws_cloudwatch_event_rule",
    "name": "branch_trigger",
    "gated": true,
    "gate": "try({ for t in local.codecommit_triggers : \"${t.pipeline_name}-${t.type}\" => t if t.type == \"branch\" }, {})",
