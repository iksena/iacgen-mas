     "description": "Capture CodeCommit merge to branch events for ${each.value.repository}",
     "event_pattern": "{\n  \"source\": [\n    \"aws.codecommit\"\n  ],\n  \"detail-type\": [\n    \"CodeCommit Repository State Change\"\n  ],\n  \"resources\": [\n    \"${data.aws_codecommit_repository.codecommit_trigger[each.value.repository].arn}\"\n  ],\n  \"detail\": {\n    \"referenceType\": [\n      \"branch\"\n    ],\n    \"referenceName\": [\n      \"${each.value.branch}\"\n    ]\n  }\n}"
