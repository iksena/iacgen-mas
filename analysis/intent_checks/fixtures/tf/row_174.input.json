    "type": "aws_codestarconnections_connection",
    "name": "pipeline",
    "gated": true,
    "gate": "{ for i in local.sources : \"${i.pipeline_name}-${i.stage_name}-${i.name}\" => i if contains(local.codestarconnection_providers, i.provider) }",
    "properties": {
     "for_each": "${{for i in local.sources : \"${i.pipeline_name}-${i.stage_name}-${i.name}\" => i if contains(local.codestarconnection_providers,i.provider)}}",
