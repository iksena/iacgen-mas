  {
   "id": "__declared__.aws_cloudwatch_event_bus.bus",
   "cfg": "aws_cloudwatch_event_bus.bus",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_cloudwatch_event_bus",
    "name": "bus",
    "gated": true,
    "gate": "toset(local.custom_bus ? [\"custom\"] : [])",
    "properties": {
     "for_each": "${toset(local.custom_bus ? ['custom'] : [])}",
     "name": "${local.name}",
     "tags": "${merge(local.default-tags,var.tags)}",
     "event_source_name": "${lookup(var.bus,\"event_source_name\",local.default_bus.event_source_name)}"
    }
   }
  },
  {
   "id": "__declared__.aws_cloudwatch_event_rule.rule",
   "cfg": "aws_cloudwatch_event_rule.rule",
   "type": "__declared__",
   "refs": [
    "aws_cloudwatch_event_bus.bus"
   ],
   "values": {
    "type": "aws_cloudwatch_event_rule",
    "name": "rule",
    "gated": true,
    "gate": "{ for r in var.rules : r.name => r }",
    "properties": {
     "for_each": "${{for r in var.rules : r.name => r}}",
     "name": "${each.key}",
     "tags": "${merge(local.default-tags,var.tags)}",
     "description": "${lookup(each.value,\"description\",local.default_rule.description)}",
     "event_bus_name": "${local.custom_bus ? aws_cloudwatch_event_bus.bus[\"custom\"].id : None}",
     "event_pattern": "${lookup(each.value,\"event_pattern\",local.default_rule.event_pattern)}",
     "schedule_expression": "${lookup(each.value,\"schedule_expression\",local.default_rule.schedule_expression)}"
    }
   }
  },
  {
   "id": "__declared__.aws_iam_role.invoke",
   "cfg": "aws_iam_role.invoke",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_iam_role",
    "name": "invoke",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "${join(\"-\",['${local.name}', 'invoke'])}",
     "tags": "${merge(local.default-tags,var.tags)}",
     "assume_role_policy": "${jsonencode({'Version': '2012-10-17', 'Statement': [{'Action': 'sts:AssumeRole', 'Effect': 'Allow', 'Principal': {'Service': '${format(\"events.%s\",local.aws.dns)}'}}]})}",
     "inline_policy": [
      {
       "name": "${join(\"-\",['${local.name}', 'invoke-targets'])}",
       "policy": "${jsonencode({'Version': '2012-10-17', 'Statement': [{'Action': ['lambda:InvokeFunction', 'states:StartExecution'], 'Effect': 'Allow', 'Resource': ['*']}]})}"
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_cloudwatch_event_target.target",
   "cfg": "aws_cloudwatch_event_target.target",
   "type": "__declared__",
   "refs": [
    "aws_cloudwatch_event_bus.bus",
    "aws_cloudwatch_event_rule.rule",
    "aws_iam_role.invoke"
   ],
   "values": {
    "type": "aws_cloudwatch_event_target",
    "name": "target",
    "gated": true,
    "gate": "{ for t in var.targets : t.name => t }",
    "properties": {
     "depends_on": [
      "${aws_cloudwatch_event_rule.rule}"
     ],
     "for_each": "${{for t in var.targets : t.name => t}}",
     "event_bus_name": "${local.custom_bus ? aws_cloudwatch_event_bus.bus[\"custom\"].id : None}",
     "rule": "${lookup(each.value,\"rule\")}",
     "arn": "${lookup(each.value,\"arn\")}",
     "role_arn": "${strcontains(lookup(each.value,\"arn\",\"\"),\"stateMachine\") ? aws_iam_role.invoke.arn : None}"
    }
   }
