   "id": "__declared__.local_file.ssh_config",
   "cfg": "local_file.ssh_config",
   "type": "__declared__",
   "refs": [
    "aws_iam_user.gitops"
   ],
   "values": {
    "type": "local_file",
    "name": "ssh_config",
    "gated": true,
    "gate": "local.ssh_key_basepath == \"/home/ec2-user/.ssh\" ? 1 : 0",
    "properties": {
     "count": "${local.ssh_key_basepath == \"/home/ec2-user/.ssh\" ? 1 : 0}",
     "content": "${local.ssh_config}",
     "filename": "${pathexpand(local.git_private_ssh_key_config)}",
     "file_permission": "0600"
    }
   }
  },
  {
   "id": "__declared__.null_resource.append_string_block",
   "cfg": "null_resource.append_string_block",
   "type": "__declared__",
   "refs": [
    "aws_iam_user.gitops"
   ],
   "values": {
    "type": "null_resource",
    "name": "append_string_block",
    "gated": true,
    "gate": "local.ssh_key_basepath == \"/home/ec2-user/.ssh\" ? 0 : 1",
    "properties": {
     "count": "${local.ssh_key_basepath == \"/home/ec2-user/.ssh\" ? 0 : 1}",
     "triggers": {
      "always_run": "${timestamp()}",
      "file": "${pathexpand(local.git_private_ssh_key_config)}"
     },
     "provisioner": [
      {
       "local-exec": {
        "when": [
         "${create}"
        ],
        "command": [
         "      start_marker=\"### START BLOCK AWS Workshop ###\"\n      end_marker=\"### END BLOCK AWS Workshop ###\"\n      block=\"$start_marker\\n${local.ssh_config}\\n$end_marker\"\n      file=\"${self.triggers.file}\"\n\n      if ! grep -q \"$start_marker\" \"$file\"; then\n        echo \"$block\" >> \"$file\"\n      fi"
        ]
       }
      },
      {
       "local-exec": {
        "when": [
         "${destroy}"
        ],
        "command": [
         "      start_marker=\"### START BLOCK AWS Workshop ###\"\n      end_marker=\"### END BLOCK AWS Workshop ###\"\n      file=\"${self.triggers.file}\"\n\n      if grep -q \"$start_marker\" \"$file\"; then\n        sed -i '' \"/$start_marker/,/$end_marker/d\" \"$file\"\n      fi"
        ]
       }
      }
     ]
    }
   }
  },
