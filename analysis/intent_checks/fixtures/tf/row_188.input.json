   "id": "__declared__.aws_s3_bucket.s3_default",
   "cfg": "aws_s3_bucket.s3_default",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_s3_bucket",
    "name": "s3_default",
    "gated": true,
    "gate": "var.create_bucket == true ? 1 : 0",
    "properties": {
     "count": "${var.create_bucket == True ? 1 : 0}",
     "bucket": "${module.labels.id}",
     "bucket_prefix": "${var.bucket_prefix}",
     "force_destroy": false,
     "dynamic": {
      "object_lock_configuration": {
       "for_each": "${var.object_lock_configuration != None ? [1] : []}",
       "content": [
        {
         "object_lock_enabled": "Enabled"
        }
       ]
      }
     }
    }
   }
  },
