  {
   "id": "__declared__.data.aws_iam_policy_document.cloudtrail_key_policy",
   "cfg": "data.aws_iam_policy_document.cloudtrail_key_policy",
   "type": "__declared__",
   "refs": [
    "data.aws_caller_identity.current"
   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "cloudtrail_key_policy",
    "gated": false,
    "gate": null,
    "properties": {
     "statement": [
      {
       "sid": "Enable IAM User Permissions",
       "actions": [
        "kms:*"
       ],
       "effect": "Allow",
       "resources": [
        "*"
       ],
       "principals": [
        {
         "type": "AWS",
         "identifiers": [
          "arn:aws:iam::${data.aws_caller_identity.current.account_id}:root",
          "${data.aws_caller_identity.current.arn}"
         ]
        }
       ]
      },
      {
       "sid": "Allow CloudTrail to encrypt logs",
       "actions": [
        "kms:GenerateDataKey*"
       ],
       "effect": "Allow",
       "resources": [
        "*"
       ],
       "principals": [
        {
         "type": "Service",
         "identifiers": [
          "cloudtrail.amazonaws.com"
         ]
        }
       ],
       "condition": [
        {
         "test": "StringLike",
         "variable": "kms:EncryptionContext:aws:cloudtrail:arn",
         "values": [
          "arn:aws:cloudtrail:*:${data.aws_caller_identity.current.account_id}:trail/*"
         ]
        }
       ]
      },
      {
       "sid": "AllowS3ToUseKey",
       "actions": [
        "kms:GenerateDataKey*",
        "kms:Decrypt"
       ],
       "effect": "Allow",
       "resources": [
        "*"
       ],
       "principals": [
        {
         "type": "Service",
         "identifiers": [
          "s3.amazonaws.com"
         ]
        }
       ]
      },
      {
       "sid": "Allow CloudTrail to describe key",
       "actions": [
        "kms:DescribeKey"
       ],
       "effect": "Allow",
       "resources": [
        "*"
       ],
       "principals": [
        {
         "type": "Service",
         "identifiers": [
          "cloudtrail.amazonaws.com"
         ]
        }
       ]
      },
      {
       "sid": "Allow principals in the account to decrypt log files",
       "actions": [
        "kms:Decrypt",
        "kms:ReEncryptFrom"
       ],
       "effect": "Allow",
       "resources": [
        "*"
       ],
       "principals": [
        {
         "type": "AWS",
         "identifiers": [
          "*"
         ]
        }
       ],
       "condition": [
        {
         "test": "StringEquals",
         "variable": "kmsCallerAccount",
         "values": [
          "${data.aws_caller_identity.current.account_id}"
         ]
        },
        {
         "test": "StringLike",
         "variable": "kms:EncryptionContext:aws:cloudtrail:arn",
         "values": [
          "arn:aws:cloudtrail:*:${data.aws_caller_identity.current.account_id}:trail/*"
         ]
        }
       ]
      }
     ]
    }
   }
