  {
   "id": "__declared__.aws_s3_bucket_inventory.default",
   "cfg": "aws_s3_bucket_inventory.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_inventory",
    "name": "default",
    "gated": true,
    "gate": "var.inventory_configuration",
    "properties": {
     "for_each": [
      {}
     ],
     "bucket": "${aws_s3_bucket.default.id}",
     "enabled": "${each.value.enabled}",
     "included_object_versions": "${each.value.included_object_versions}",
     "name": "${each.key}",
     "optional_fields": "${each.value.optional_fields}",
     "destination": [
      {
       "bucket": [
        {
         "account_id": "${each.value.destination.account_id}",
         "bucket_arn": "${each.value.destination.bucket_arn}",
         "format": "${each.value.destination.format}",
         "prefix": "${each.value.destination.prefix}",
         "encryption": [
          {
           "dynamic": {
            "sse_kms": {
             "for_each": "${each.value.destination.encryption.encryption_type == \"sse_kms\" ? {'create': True} : {}}",
             "content": [
              {
               "key_id": "${each.value.destination.encryption.kms_key_id}"
              }
             ]
            },
            "sse_s3": {
             "for_each": "${each.value.destination.encryption.encryption_type == \"sse_s3\" ? {'create': True} : {}}",
             "content": [
              {}
             ]
            }
           }
          }
         ]
        }
       ]
      }
     ],
     "schedule": [
      {
       "frequency": "${each.value.frequency}"
      }
     ],
     "dynamic": {
      "filter": {
       "for_each": "${each.value.filter_prefix != None ? {'create': True} : {}}",
       "content": [
        {
         "prefix": "${each.value.filter_prefix}"
        }
       ]
      }
     }
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_lifecycle_configuration.default",
   "cfg": "aws_s3_bucket_lifecycle_configuration.default",
   "type": "__declared__",
   "refs": [
    "abort_incomplete_multipart_upload.value",
    "aws_s3_bucket.default",
    "noncurrent_version_expiration.value",
    "noncurrent_version_transition.value"
   ],
   "values": {
    "type": "aws_s3_bucket_lifecycle_configuration",
    "name": "default",
    "gated": true,
    "gate": "length(local.lifecycle_rules) > 0 ? 1 : 0",
    "properties": {
     "count": "${length(local.lifecycle_rules) > 0 ? 1 : 0}",
     "bucket": "${aws_s3_bucket.default.bucket}",
     "dynamic": {
      "rule": {
       "for_each": "${local.lifecycle_rules}",
       "content": [
        {
         "id": "${try(rule.value.id,None)}",
         "status": "${try(rule.value.status,\"Enabled\")}",
         "dynamic": {
          "filter": {
           "for_each": "${try(['${rule.value.prefix}'],[])}",
           "content": [
            {
             "prefix": "${try(filter.value,None)}"
            }
           ]
          },
          "abort_incomplete_multipart_upload": {
           "for_each": "${try(flatten(['${rule.value.abort_incomplete_multipart_upload}']),[])}",
           "content": [
            {
             "days_after_initiation": "${try(abort_incomplete_multipart_upload.value.days_after_initiation,None)}"
            }
           ]
          },
          "expiration": {
           "for_each": "${try(flatten(['${rule.value.expiration}']),[])}",
           "content": [
            {
             "date": "${try(expiration.value.date,None)}",
             "days": "${try(expiration.value.days,None)}",
             "expired_object_delete_marker": "${try(expiration.value.expired_object_delete_marker,None)}"
            }
           ]
          },
          "noncurrent_version_expiration": {
           "for_each": "${try(flatten(['${rule.value.noncurrent_version_expiration}']),[])}",
           "content": [
            {
             "newer_noncurrent_versions": "${try(noncurrent_version_expiration.value.newer_noncurrent_versions,None)}",
             "noncurrent_days": "${try(noncurrent_version_expiration.value.noncurrent_days,None)}"
            }
           ]
          },
          "noncurrent_version_transition": {
           "for_each": "${try(flatten(['${rule.value.noncurrent_version_transition}']),[])}",
           "content": [
            {
             "newer_noncurrent_versions": "${try(noncurrent_version_transition.value.newer_noncurrent_versions,None)}",
             "noncurrent_days": "${try(noncurrent_version_transition.value.noncurrent_days,None)}",
             "storage_class": "${noncurrent_version_transition.value.storage_class}"
            }
           ]
          },
          "transition": {
           "for_each": "${try(flatten(['${rule.value.transition}']),[])}",
           "content": [
            {
             "date": "${try(transition.value.date,None)}",
             "days": "${try(transition.value.days,None)}",
             "storage_class": "${transition.value.storage_class}"
            }
           ]
          }
         }
        }
       ]
      }
     }
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_logging.default",
   "cfg": "aws_s3_bucket_logging.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_logging",
    "name": "default",
    "gated": true,
    "gate": "var.logging != null ? 1 : 0",
    "properties": {
     "count": "${var.logging != None ? 1 : 0}",
     "bucket": "${aws_s3_bucket.default.id}",
     "target_bucket": "${var.logging.target_bucket}",
     "target_prefix": "${var.logging.target_prefix}",
     "lifecycle": [
      {
       "precondition": [
        {
         "condition": "${var.logging.target_bucket != aws_s3_bucket.default.id || var.object_lock_mode == None}",
         "error_message": "You're trying to enable server access logging and object locking on the same bucket! Object lock will prevent server access logs from written to the bucket. Either log to a different bucket or remove the object lock configuration."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_object_lock_configuration.default",
   "cfg": "aws_s3_bucket_object_lock_configuration.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_object_lock_configuration",
    "name": "default",
    "gated": true,
    "gate": "local.object_lock_configuration",
    "properties": {
     "for_each": "${local.object_lock_configuration}",
     "bucket": "${aws_s3_bucket.default.bucket}",
     "rule": [
      {
       "default_retention": [
        {
         "mode": "${var.object_lock_mode}",
         "years": "${var.object_lock_years}",
         "days": "${var.object_lock_days}"
        }
       ]
      }
     ],
     "lifecycle": [
      {
       "precondition": [
        {
         "condition": "${var.object_lock_mode == None || length(var.logging_source_bucket_arns) == 0}",
         "error_message": "You're trying to allow (other buckets) logging to this bucket and enable object locking on the same bucket! Object lock will prevent server access logs from written to the bucket. Either remove the logging source buckets configuration or remove the object lock configuration."
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_notification.eventbridge",
   "cfg": "aws_s3_bucket_notification.eventbridge",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_notification",
    "name": "eventbridge",
    "gated": true,
    "gate": "var.eventbridge_enabled ? 1 : 0",
    "properties": {
     "count": "${var.eventbridge_enabled ? 1 : 0}",
     "bucket": "${aws_s3_bucket.default.id}",
     "eventbridge": false
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_replication_configuration.default",
   "cfg": "aws_s3_bucket_replication_configuration.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default",
    "aws_s3_bucket_versioning.default",
    "source_selection_criteria.replica_modifications",
    "source_selection_criteria.sse_kms_encrypted_objects"
   ],
   "values": {
    "type": "aws_s3_bucket_replication_configuration",
    "name": "default",
    "gated": true,
    "gate": "local.replication_configuration",
    "properties": {
     "for_each": "${local.replication_configuration}",
     "role": "${var.replication_configuration.iam_role_arn}",
     "bucket": "${aws_s3_bucket.default.id}",
     "dynamic": {
      "rule": {
       "for_each": "${var.replication_configuration.rules}",
       "content": [
        {
         "id": "${rule.value[\"id\"]}",
         "priority": "${rule.key}",
         "status": "Enabled",
         "delete_marker_replication": [
          {
           "status": "Disabled"
          }
         ],
         "destination": [
          {
           "bucket": "${rule.value[\"dest_bucket\"]}",
           "storage_class": "${rule.value[\"dest_storage_class\"]}",
           "dynamic": {
            "encryption_configuration": {
             "for_each": "${rule.value.replica_kms_key_arn != None ? {'create': True} : {}}",
             "content": [
              {
               "replica_kms_key_id": "${rule.value.replica_kms_key_arn}"
              }
             ]
            }
           }
          }
         ],
         "dynamic": {
          "source_selection_criteria": {
           "for_each": "${rule.value.source_selection_criteria != None ? {'create': True} : {}}",
           "content": [
            {
             "replica_modifications": [
              {
               "status": "${rule.value.source_selection_criteria.replica_modifications ? \"Enabled\" : \"Disabled\"}"
              }
             ],
             "sse_kms_encrypted_objects": [
              {
               "status": "${rule.value.source_selection_criteria.sse_kms_encrypted_objects ? \"Enabled\" : \"Disabled\"}"
              }
             ]
            }
           ]
          }
         },
         "filter": [
          {}
         ]
        }
       ]
      }
     },
     "depends_on": [
      "${aws_s3_bucket_versioning.default}"
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_server_side_encryption_configuration.default",
   "cfg": "aws_s3_bucket_server_side_encryption_configuration.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_server_side_encryption_configuration",
    "name": "default",
    "gated": false,
    "gate": null,
    "properties": {
     "bucket": "${aws_s3_bucket.default.bucket}",
     "rule": [
      {
       "bucket_key_enabled": "${local.bucket_key_enabled}",
       "apply_server_side_encryption_by_default": [
        {
         "kms_master_key_id": "${var.kms_key_arn}",
         "sse_algorithm": "${var.kms_key_arn != None ? \"aws:kms\" : \"AES256\"}"
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_policy.default",
   "cfg": "aws_s3_bucket_policy.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default",
    "data.aws_iam_policy_document.combined"
   ],
   "values": {
    "type": "aws_s3_bucket_policy",
    "name": "default",
    "gated": false,
    "gate": null,
    "properties": {
     "bucket": "${aws_s3_bucket.default.id}",
     "policy": "${data.aws_iam_policy_document.combined.json}"
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_public_access_block.default",
   "cfg": "aws_s3_bucket_public_access_block.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_public_access_block",
    "name": "default",
    "gated": false,
    "gate": null,
    "properties": {
     "bucket": "${aws_s3_bucket.default.id}",
     "block_public_acls": true,
     "block_public_policy": true,
     "ignore_public_acls": true,
     "restrict_public_buckets": true
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_versioning.default",
   "cfg": "aws_s3_bucket_versioning.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_versioning",
    "name": "default",
    "gated": false,
    "gate": null,
    "properties": {
     "bucket": "${aws_s3_bucket.default.id}",
     "versioning_configuration": [
      {
       "status": "${var.versioning ? \"Enabled\" : \"Suspended\"}"
      }
     ]
    }
   }
  }
 ]
}