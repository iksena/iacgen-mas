   "id": "__declared__.aws_s3_bucket_cors_configuration.default",
   "cfg": "aws_s3_bucket_cors_configuration.default",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.default"
   ],
   "values": {
    "type": "aws_s3_bucket_cors_configuration",
    "name": "default",
    "gated": true,
    "gate": "local.cors_rule",
    "properties": {
     "for_each": "${local.cors_rule}",
