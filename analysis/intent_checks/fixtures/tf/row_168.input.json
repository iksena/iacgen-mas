   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "logging_policy",
    "gated": true,
    "gate": "local.logging_permissions",
    "properties": {
     "dynamic": {
      "statement": {
       "for_each": "${local.logging_permissions}",
       "content": [
        {
         "sid": "S3AccessLog",
         "actions": [
          "s3:PutObject"
         ],
         "effect": "Allow",
         "resources": [
          "${aws_s3_bucket.default.arn}/*"
         ],
         "principals": [
          {
           "type": "Service",
           "identifiers": [
            "logging.s3.amazonaws.com"
           ]
          }
         ],
         "condition": [
          {
           "test": "ArnLike",
           "variable": "aws:SourceArn",
           "values": []
          }
         ]
        }
       ]
      }
     }
    }
   }
