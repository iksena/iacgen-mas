  {
   "id": "__declared__.aws_efs_file_system.main",
   "cfg": "aws_efs_file_system.main",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_efs_file_system",
    "name": "main",
    "gated": true,
    "gate": "length(var.transition_to_ia) > 0 ? [1] : []",
    "properties": {
     "creation_token": "${var.creation_token}",
     "availability_zone_name": "${var.availability_zone_name}",
     "encrypted": true,
     "kms_key_id": "${var.kms_key_id}",
     "dynamic": {
      "lifecycle_policy": {
       "for_each": "${length(var.transition_to_primary_storage_class) > 0 ? [1] : []}",
       "content": [
        {
         "transition_to_primary_storage_class": "${try(var.transition_to_primary_storage_class[0],None)}"
        }
       ]
      }
     },
     "performance_mode": "generalPurpose",
     "provisioned_throughput_in_mibps": "${var.provisioned_throughput_in_mibps}",
     "throughput_mode": "bursting",
     "tags": "${merge({'Name': '${var.creation_token}'},var.tags)}"
    }
   }
  },
  {
   "id": "__declared__.aws_efs_mount_target.main",
   "cfg": "aws_efs_mount_target.main",
   "type": "__declared__",
   "refs": [
    "aws_efs_file_system.main",
    "aws_security_group.main"
   ],
   "values": {
    "type": "aws_efs_mount_target",
    "name": "main",
    "gated": true,
    "gate": "length(var.mount_target_subnet_ids) > 0 ? length(var.mount_target_subnet_ids) : 0",
    "properties": {
     "count": "${length(var.mount_target_subnet_ids) > 0 ? length(var.mount_target_subnet_ids) : 0}",
     "file_system_id": "${aws_efs_file_system.main.id}",
     "subnet_id": "${var.mount_target_subnet_ids[count.index]}",
     "ip_address": "${var.mount_target_ip_addresses[count.index]}",
     "security_groups": "${concat(var.external_security_groups,aws_security_group.main.*.id)}"
    }
   }
  },
  {
   "id": "__declared__.aws_efs_file_system_policy.main",
   "cfg": "aws_efs_file_system_policy.main",
   "type": "__declared__",
   "refs": [
    "aws_efs_file_system.main"
   ],
   "values": {
    "type": "aws_efs_file_system_policy",
    "name": "main",
    "gated": true,
    "gate": "var.file_system_policy != \"\" ? 1 : 0",
    "properties": {
     "count": "${var.file_system_policy != \"\" ? 1 : 0}",
     "file_system_id": "${aws_efs_file_system.main.id}",
     "bypass_policy_lockout_safety_check": false,
     "policy": ""
    }
   }
  },
  {
   "id": "__declared__.aws_efs_backup_policy.main",
   "cfg": "aws_efs_backup_policy.main",
   "type": "__declared__",
   "refs": [
    "aws_efs_file_system.main"
   ],
   "values": {
    "type": "aws_efs_backup_policy",
    "name": "main",
    "gated": false,
    "gate": null,
    "properties": {
     "file_system_id": "${aws_efs_file_system.main.id}",
     "backup_policy": [
      {
       "status": "ENABLED"
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_security_group.main",
   "cfg": "aws_security_group.main",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_security_group",
    "name": "main",
    "gated": true,
    "gate": "length(var.mount_target_subnet_ids) > 0 && var.create_security_group ? 1 : 0",
    "properties": {
     "count": "${length(var.mount_target_subnet_ids) > 0 && var.create_security_group ? 1 : 0}",
     "name": "${var.creation_token}-security-group",
     "description": "Efs security Group for ${var.creation_token}",
     "vpc_id": "${var.vpc_id}",
     "dynamic": {
      "ingress": {
       "for_each": [
        {}
       ],
       "content": [
        {
         "description": "${lookup(ingress.value,\"description\",\"Rule to allow port ${try(ingress.value.from_port, null)} inbound traffic\")}",
         "from_port": "${try(ingress.value.from_port,None)}",
         "to_port": "${try(ingress.value.to_port,None)}",
         "protocol": "${try(ingress.value.protocol,None)}",
         "cidr_blocks": "${try(ingress.value.cidr_blocks,[])}",
         "ipv6_cidr_blocks": "${try(ingress.value.ipv6_cidr_blocks,[])}"
        }
       ]
      },
      "egress": {
       "for_each": [
        {}
       ],
       "content": [
        {
         "description": "${try(egress.value.description,0)}",
         "from_port": "${try(egress.value.from_port,0)}",
         "to_port": "${try(egress.value.to_port,0)}",
         "protocol": "${try(egress.value.protocol,\"-1\")}",
         "cidr_blocks": "${try(egress.value.cidr_blocks,['0.0.0.0/0'])}",
         "ipv6_cidr_blocks": "${try(['${egress.value.ipv6_cidr_blocks}'],['::/0'])}"
        }
       ]
      }
     },
     "tags": "${merge({'Name': '${var.creation_token}'},var.tags)}"
    }
   }
  }
 ]
