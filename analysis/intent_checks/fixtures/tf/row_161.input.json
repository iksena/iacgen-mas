    "value": "#!/bin/bash\n\nif [[ '' == '' ]]; then\n  echo \"Skipping deployment because target version () is already the current version\"\n  exit 0\nfi\n\nID=$(aws deploy create-deployment \\\n    --application-name  \\\n    --deployment-group-name  \\\n    --deployment-config-name CodeDeployDefault.LambdaAllAtOnce \\\n    --description \"\" \\\n    --revision '{\"revisionType\": \"AppSpecContent\", \"appSpecContent\": {\"content\": \"{\\\"Resources\\\":[{\\\"MyFunction\\\":{\\\"Properties\\\":{\\\"Alias\\\":\\\"\\\",\\\"CurrentVersion\\\":\\\"\\\",\\\"Name\\\":\\\"\\\",\\\"TargetVersion\\\":\\\"\\\"},\\\"Type\\\":\\\"AWS::Lambda::Function\\\"}}],\\\"version\\\":\\\"0.0\\\"}\", \"sha256\": \"ed8464aca7a1c211ec12791482b43e46b9044efa61ce53586020eaeef7d99aa8\"}}' \\\n    --output text \\\n    --query '[deploymentId]')\n\n\n\naws deploy get-deployment --deployment-id $ID\necho \"Deployment started, but wait deployment completion is disabled!\"\n\n\n",
    "description": "Deployment script"
