    }
   }
  },
  {
   "id": "__declared__.aws_cloudformation_stack.autoscaling_group",
   "cfg": "aws_cloudformation_stack.autoscaling_group",
   "type": "__declared__",
   "refs": [
    "aws_launch_template.node_launch_template",
    "aws_subnet.private",
    "time_sleep.wait_30_seconds"
   ],
   "values": {
    "type": "aws_cloudformation_stack",
    "name": "autoscaling_group",
    "gated": false,
    "gate": null,
    "properties": {
     "depends_on": [
      "${time_sleep.wait_30_seconds}"
     ],
     "name": "eks-cluster-stack",
     "template_body": "Description: \"Node autoscaler\"\nResources:\n  NodeGroup:\n    Type: AWS::AutoScaling::AutoScalingGroup\n    Properties:\n      VPCZoneIdentifier: [\"${aws_subnet.private[0].id}\",\"${aws_subnet.private[1].id}\", \"${aws_subnet.private[2].id}\"]\n      MinSize: \"${var.node_group_min_size}\"\n      MaxSize: \"${var.node_group_max_size}\"\n      DesiredCapacity: \"${var.node_group_desired_capacity}\"\n      HealthCheckType: EC2\n      LaunchTemplate:\n        LaunchTemplateId: \"${aws_launch_template.node_launch_template.id}\"\n        Version: \"${aws_launch_template.node_launch_template.latest_version}\"\n    UpdatePolicy:\n    # Ignore differences in group size properties caused by scheduled actions\n      AutoScalingScheduledAction:\n        IgnoreUnmodifiedGroupSizeProperties: true\n      AutoScalingRollingUpdate:\n        MaxBatchSize: 1\n        MinInstancesInService: \"${var.node_group_desired_capacity}\"\n        PauseTime: PT5M\nOutputs:\n  NodeAutoScalingGroup:\n    Description: The autoscaling group\n    Value: !Ref NodeGroup"
    }
   }
  },
