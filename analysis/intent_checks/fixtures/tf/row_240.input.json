    "type": "data.aws_ami",
    "name": "images",
    "gated": true,
    "gate": "{ for idx, node in var.nodes : idx => node }",
    "properties": {
     "for_each": "${{for idx , node in var.nodes : idx => node}}",
     "most_recent": true,
     "owners": "${each.value.ami_owners}",
     "dynamic": {
      "filter": {
       "for_each": "${each.value.ami_filters}",
