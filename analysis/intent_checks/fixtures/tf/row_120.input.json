                   "for_each": "${length(keys(lookup(source_selection_criteria.value,\"sse_kms_encrypted_objects\",{}))) == 0 ? [] : ['${lookup(source_selection_criteria.value,\"sse_kms_encrypted_objects\",{})}']}",
                   "content": [
