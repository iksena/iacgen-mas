    "aws_subnet.public"
   ],
   "values": {
    "type": "aws_route_table_association",
    "name": "public",
    "gated": true,
    "gate": "var.enable_public_subnets ? aws_subnet.public : {}",
    "properties": {
     "for_each": "${var.enable_public_subnets ? aws_subnet.public : {}}",
     "subnet_id": "${each.value.id}",
     "route_table_id": "${aws_route_table.public[0].id}"
    }
   }
  },
