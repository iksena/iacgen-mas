  {
   "id": "__declared__.aws_subnet.public",
   "cfg": "aws_subnet.public",
   "type": "__declared__",
   "refs": [
    "aws_vpc.main",
    "data.aws_availability_zones.available"
   ],
   "values": {
    "type": "aws_subnet",
    "name": "public",
    "gated": true,
    "gate": "{",
    "properties": {
     "for_each": "${{for index , az_name in slice(data.aws_availability_zones.available.names,0,var.number_of_availability_zones) : az_name => cidrsubnet(aws_vpc.main.cidr_block,local.subnet_newbits,index) if var.enable_public_subnets}}",
     "vpc_id": "${aws_vpc.main.id}",
     "availability_zone": "${each.key}",
     "cidr_block": "${each.value}",
     "map_public_ip_on_launch": true
    }
   }
  },
  {
   "id": "__declared__.aws_route_table.public",
   "cfg": "aws_route_table.public",
   "type": "__declared__",
   "refs": [
    "aws_internet_gateway.main",
    "aws_vpc.main"
   ],
   "values": {
    "type": "aws_route_table",
    "name": "public",
    "gated": true,
    "gate": "var.enable_public_subnets ? 1 : 0",
    "properties": {
     "count": "${var.enable_public_subnets ? 1 : 0}",
     "vpc_id": "${aws_vpc.main.id}",
     "route": [
      {
       "cidr_block": "0.0.0.0/0",
       "gateway_id": "${aws_internet_gateway.main[0].id}"
      },
      {
       "cidr_block": "${aws_vpc.main.cidr_block}",
       "gateway_id": "local"
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_route_table_association.public",
