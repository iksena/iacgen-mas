   "refs": [
    "aws_security_group.custom_vpc_endpoints",
    "aws_vpc.vpc"
   ],
   "values": {
    "type": "aws_vpc_endpoint",
    "name": "custom_vpc_endpoints",
    "gated": true,
    "gate": "{",
    "properties": {
     "for_each": "${{for service in var.custom_vpce_services : service[\"key\"] => service[\"service_name\"]}}",
     "service_name": "${each.value}",
     "vpc_id": "${aws_vpc.vpc.id}",
     "vpc_endpoint_type": "Interface",
     "security_group_ids": [
      "${aws_security_group.custom_vpc_endpoints.id}"
     ],
     "subnet_ids": [],
     "private_dns_enabled": false,
     "tags": "${merge(var.common_tags,{'Name': '${var.vpc_name}'})}"
    }
   }
