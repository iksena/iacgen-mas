     ]
    }
   }
  },
  {
   "id": "__declared__.aws_security_group_rule.custom_vpce_source_ingress",
   "cfg": "aws_security_group_rule.custom_vpce_source_ingress",
   "type": "__declared__",
   "refs": [
    "aws_security_group.custom_vpc_endpoints"
   ],
   "values": {
    "type": "aws_security_group_rule",
    "name": "custom_vpce_source_ingress",
    "gated": true,
    "gate": "length(local.sg_id_to_port_mapping)",
    "properties": {
     "count": "${length(local.sg_id_to_port_mapping)}",
     "description": "Allow instance traffic to Custom VPCE",
     "type": "ingress",
     "protocol": "tcp",
     "from_port": "${local.sg_id_to_port_mapping[count.index][1]}",
     "to_port": "${local.sg_id_to_port_mapping[count.index][1]}",
     "source_security_group_id": "${local.sg_id_to_port_mapping[count.index][0]}",
     "security_group_id": "${aws_security_group.custom_vpc_endpoints.id}"
    }
   }
  },
  {
   "id": "__declared__.aws_security_group_rule.source_custom_vpce_egress",
   "cfg": "aws_security_group_rule.source_custom_vpce_egress",
   "type": "__declared__",
   "refs": [
    "aws_security_group.custom_vpc_endpoints"
   ],
   "values": {
    "type": "aws_security_group_rule",
    "name": "source_custom_vpce_egress",
    "gated": true,
    "gate": "length(local.sg_id_to_port_mapping)",
    "properties": {
     "count": "${length(local.sg_id_to_port_mapping)}",
     "description": "Accept Custom VPCE traffic",
     "type": "egress",
     "protocol": "tcp",
     "from_port": "${local.sg_id_to_port_mapping[count.index][1]}",
     "to_port": "${local.sg_id_to_port_mapping[count.index][1]}",
     "source_security_group_id": "${aws_security_group.custom_vpc_endpoints.id}",
     "security_group_id": "${local.sg_id_to_port_mapping[count.index][0]}"
    }
   }
  }
