  {
   "id": "__declared__.aws_security_group.vpc_endpoints",
   "cfg": "aws_security_group.vpc_endpoints",
   "type": "__declared__",
   "refs": [
    "aws_vpc.vpc"
   ],
   "values": {
    "type": "aws_security_group",
    "name": "vpc_endpoints",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "vpc-endpoints-${var.vpc_name}",
     "description": "Allows instances to reach Interface VPC endpoints",
     "vpc_id": "${aws_vpc.vpc.id}",
     "tags": "${merge(var.common_tags,{'Name': '${var.vpc_name}'})}"
    }
   }
  },
  {
   "id": "__declared__.aws_security_group_rule.vpce_source_https_ingress",
   "cfg": "aws_security_group_rule.vpce_source_https_ingress",
   "type": "__declared__",
   "refs": [
    "aws_security_group.vpc_endpoints"
   ],
   "values": {
    "type": "aws_security_group_rule",
    "name": "vpce_source_https_ingress",
    "gated": true,
    "gate": "length(var.interface_vpce_source_security_group_ids)",
    "properties": {
     "count": "${length(var.interface_vpce_source_security_group_ids)}",
     "description": "Accept VPCE traffic",
     "type": "ingress",
     "protocol": "tcp",
     "from_port": 443,
     "to_port": 443,
     "source_security_group_id": "${var.interface_vpce_source_security_group_ids[count.index]}",
     "security_group_id": "${aws_security_group.vpc_endpoints.id}"
    }
   }
  },
  {
   "id": "__declared__.aws_security_group_rule.source_vpce_https_egress",
   "cfg": "aws_security_group_rule.source_vpce_https_egress",
   "type": "__declared__",
   "refs": [
    "aws_security_group.vpc_endpoints"
   ],
   "values": {
    "type": "aws_security_group_rule",
    "name": "source_vpce_https_egress",
    "gated": true,
    "gate": "length(var.interface_vpce_source_security_group_ids)",
    "properties": {
     "count": "${length(var.interface_vpce_source_security_group_ids)}",
     "description": "Allow outbound requests to VPC endpoints",
     "type": "egress",
     "protocol": "tcp",
     "from_port": 443,
     "to_port": 443,
     "source_security_group_id": "${aws_security_group.vpc_endpoints.id}",
     "security_group_id": "${var.interface_vpce_source_security_group_ids[count.index]}"
    }
   }
  },
