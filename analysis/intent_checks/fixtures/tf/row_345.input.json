    "value": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"AllowBasicVisibilityWithoutMfa\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListVirtualMFADevices\",\n        \"iam:ListUsers\",\n        \"iam:ListAccountAliases\",\n        \"iam:GetAccountSummary\",\n        \"iam:GetAccountPasswordPolicy\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Sid\": \"MFAPersonalCreate\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:DeleteVirtualMFADevice\",\n        \"iam:CreateVirtualMFADevice\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:mfa/${aws:username}\"\n    },\n    {\n      \"Sid\": \"AllowIndividualUserToDeactivateOnlyTheirOwnMFAOnlyWhenUsingMFA\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:DeleteVirtualMFADevice\",\n      \"Resource\": [\n        \"arn:aws:iam::*:user/${aws:username}\",\n        \"arn:aws:iam::*:mfa/${aws:username}\"\n      ],\n      \"Condition\": {\n        \"Bool\": {\n          \"aws:MultiFactorAuthPresent\": \"true\"\n        }\n      }\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListGroupsForUser\",\n        \"iam:GetUser\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:user/${aws:username}\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:ListGroups\",\n      \"Resource\": \"arn:aws:iam::*:group/\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListGroupPolicies\",\n        \"iam:ListAttachedGroupPolicies\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:group/*\"\n    },\n    {\n      \"Sid\": \"AllowToListOnlyOwnMFA\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:ListMFADevices\",\n      \"Resource\": [\n        \"arn:aws:iam::*:user/${aws:username}\",\n        \"arn:aws:iam::*:mfa/*\"\n      ]\n    },\n    {\n      \"Sid\": \"AllowManageOwnUserMFA\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:UpdateUser\",\n        \"iam:UpdateLoginProfile\",\n        \"iam:ListSSHPublicKeys\",\n        \"iam:ListAttachedUserPolicies\",\n        \"iam:ListAccessKeys\",\n        \"iam:GetLoginProfile\",\n        \"iam:CreateLoginProfile\",\n        \"iam:ChangePassword\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:user/${aws:username}\"\n    },\n    {\n      \"Sid\": \"AllowUserToManageOwnMFA\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ResyncMFADevice\",\n        \"iam:EnableMFADevice\",\n        \"iam:DeleteVirtualMFADevice\",\n        \"iam:CreateVirtualMFADevice\"\n      ],\n      \"Resource\": [\n        \"arn:aws:iam::*:user/${aws:username}\",\n        \"arn:aws:iam::*:mfa/${aws:username}\"\n      ]\n    },\n    {\n      \"Sid\": \"KeysAndCertificates\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListSigningCertificates\",\n        \"iam:ListSSHPublicKeys\",\n        \"iam:GetSSHPublicKey\"\n      ],\n      \"Resource\": \"arn:aws:iam::*:user/${aws:username}\"\n    },\n    {\n      \"Sid\": \"AllowUserToDeactivateOnlyOwnMFAWhenUsingMFA\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"iam:DeactivateMFADevice\",\n      \"Resource\": [\n        \"arn:aws:iam::*:user/${aws:username}\",\n        \"arn:aws:iam::*:mfa/${aws:username}\"\n      ],\n      \"Condition\": {\n        \"Bool\": {\n          \"aws:MultiFactorAuthPresent\": \"true\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"AllowBasicVisibilityWhenLoggedInWithMFA\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"iam:ListUserTags\",\n        \"iam:ListUserPolicies\",\n        \"iam:ListServiceSpecificCredentials\",\n        \"iam:ListPolicies\",\n        \"iam:ListGroupsForUser\",\n        \"iam:ListAttachedUserPolicies\",\n        \"iam:GetUser\",\n        \"iam:GetGroup\",\n        \"iam:GenerateServiceLastAccessedDetails\"\n      ],\n      \"Resource\": \"*\",\n      \"Condition\": {\n        \"Bool\": {\n          \"aws:MultiFactorAuthPresent\": \"true\"\n        }\n      }\n    }\n  ]\n}",
