   "id": "__declared__.aws_iam_policy.read",
   "cfg": "aws_iam_policy.read",
   "type": "__declared__",
   "refs": [
    "aws_ecr_repository.repo"
   ],
   "values": {
    "type": "aws_iam_policy",
    "name": "read",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "${format(\"%s-ecr-read\",local.name)}",
     "description": "${format(\"Allow to read images from the ECR\")}",
     "path": "/",
     "policy": "${jsonencode({'Statement': [{'Action': ['ecr:BatchCheckLayerAvailability', 'ecr:BatchGetImage', 'ecr:DescribeImages', 'ecr:DescribeRepositories', 'ecr:GetAuthorizationToken', 'ecr:GetDownloadUrlForLayer', 'ecr:ListImages'], 'Effect': 'Allow', 'Resource': ['${aws_ecr_repository.repo.arn}']}], 'Version': '2012-10-17'})}"
    }
   }
  },
