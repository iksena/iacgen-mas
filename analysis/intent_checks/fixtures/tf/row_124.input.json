    "name": "write",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "${format(\"%s-ecr-write\",local.name)}",
     "description": "${format(\"Allow to push and write images to the ECR\")}",
     "path": "/",
     "policy": "${jsonencode({'Statement': [{'Action': ['ecr:PutImage', 'ecr:UploadLayerPart', 'ecr:InitiateLayerUpload', 'ecr:CompleteLayerUpload'], 'Effect': 'Allow', 'Resource': ['${aws_ecr_repository.repo.arn}']}], 'Version': '2012-10-17'})}"
