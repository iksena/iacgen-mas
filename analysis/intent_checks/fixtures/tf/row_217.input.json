  {
   "id": "__declared__.data.aws_iam_policy_document.manage-self",
   "cfg": "data.aws_iam_policy_document.manage-self",
   "type": "__declared__",
   "refs": [
    "data.aws_caller_identity.current"
   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "manage-self",
    "gated": false,
    "gate": null,
    "properties": {
     "statement": [
      {
       "sid": "AllowUsersToManageTheirUser",
       "actions": [
        "iam:CreateVirtualMFADevice",
        "iam:EnableMFADevice",
        "iam:ResyncMFADevice",
        "iam:DeleteVirtualMFADevice",
        "iam:DeleteAccessKey",
        "iam:UpdateAccessKey",
        "iam:CreateAccessKey",
        "iam:ChangePassword",
        "iam:DeleteLoginProfile",
        "iam:List*",
        "iam:Get*"
       ],
       "resources": [
        "arn:aws:iam::${data.aws_caller_identity.current.account_id}:mfa/&{aws:username}",
        "arn:aws:iam::${data.aws_caller_identity.current.account_id}:user/&{aws:username}"
       ]
      },
      {
       "sid": "AllowUsersToDeactivateTheirOwnVirtualMFADevice",
       "actions": [
        "iam:DeactivateMFADevice"
       ],
