    "gate": "length(var.build_role_policies)",
    "properties": {
     "count": "${length(var.build_role_policies)}",
     "role": "${aws_iam_role.code_build_role.name}",
     "policy_arn": "${element(var.build_role_policies,count.index)}"
    }
   }
  },
  {
   "id": "__declared__.aws_codebuild_project.codebuild_project",
   "cfg": "aws_codebuild_project.codebuild_project",
   "type": "__declared__",
   "refs": [
    "aws_iam_role.code_build_role",
    "environment_variable.value"
   ],
   "values": {
    "type": "aws_codebuild_project",
    "name": "codebuild_project",
    "gated": true,
    "gate": "var.build_environment",
    "properties": {
     "name": "basic-cicd-build-${var.gh_repo}-${var.gh_branch}-${var.cf_distribution}",
     "description": "build site ${var.site_name} for CF dist ${var.cf_distribution} from repo ${var.gh_repo} using branch ${var.gh_branch}",
     "build_timeout": 5,
     "service_role": "${aws_iam_role.code_build_role.arn}",
     "artifacts": [
      {
       "type": "CODEPIPELINE"
      }
     ],
     "cache": [
      {
       "type": "NO_CACHE"
      }
     ],
     "environment": [
      {
       "compute_type": "BUILD_GENERAL1_SMALL",
       "image": "aws/codebuild/standard:2.0",
       "type": "LINUX_CONTAINER",
       "image_pull_credentials_type": "CODEBUILD",
       "privileged_mode": false,
       "environment_variable": [
        {
         "name": "TARGET_BUCKET",
         "value": "benchmark-cicd-target"
        },
        {
         "name": "INVALIDATE",
         "value": "yes"
        },
        {
         "name": "DISTRIBUTION_ID",
         "value": "BENCHMARKCFDIST"
        }
       ],
       "dynamic": {
        "environment_variable": {
         "for_each": [],
         "content": [
          {
           "name": "${environment_variable.value.name}",
           "value": "${environment_variable.value.value}",
           "type": "${environment_variable.value.type}"
          }
         ]
        }
       }
      }
     ],
     "source": [
      {
       "type": "CODEPIPELINE"
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.random_uuid.notify_name",
   "cfg": "random_uuid.notify_name",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "random_uuid",
    "name": "notify_name",
    "gated": false,
    "gate": null,
    "properties": {}
   }
  },
  {
   "id": "__declared__.aws_codestarnotifications_notification_rule.notifications",
   "cfg": "aws_codestarnotifications_notification_rule.notifications",
   "type": "__declared__",
   "refs": [
    "aws_codepipeline.buildpipeline",
    "random_uuid.notify_name"
   ],
   "values": {
    "type": "aws_codestarnotifications_notification_rule",
    "name": "notifications",
    "gated": true,
    "gate": "var.send_notifications == true ? 1 : 0",
    "properties": {
     "count": "${var.send_notifications == True ? 1 : 0}",
     "detail_type": "FULL",
     "event_type_ids": [
      "codepipeline-pipeline-pipeline-execution-failed",
      "codepipeline-pipeline-pipeline-execution-canceled",
      "codepipeline-pipeline-pipeline-execution-started",
      "codepipeline-pipeline-pipeline-execution-resumed",
      "codepipeline-pipeline-pipeline-execution-succeeded",
      "codepipeline-pipeline-pipeline-execution-superseded"
     ],
     "name": "${random_uuid.notify_name.result}",
     "resource": "${aws_codepipeline.buildpipeline.arn}",
     "target": [
      {
       "address": ""
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_codepipeline.buildpipeline",
   "cfg": "aws_codepipeline.buildpipeline",
   "type": "__declared__",
   "refs": [
    "aws_iam_role.code_pipeline_role",
    "aws_s3_bucket.build_bucket"
   ],
   "values": {
    "type": "aws_codepipeline",
    "name": "buildpipeline",
    "gated": true,
    "gate": "var.codestar_connection_arn == \"\" ? [ \"blah\" ] : []",
    "properties": {
     "name": "basic-cicd-pipeline-${var.gh_repo}-${var.gh_branch}-${var.cf_distribution}",
     "role_arn": "${aws_iam_role.code_pipeline_role.arn}",
     "artifact_store": [
      {
       "location": "${aws_s3_bucket.build_bucket.bucket}",
       "type": "S3"
      }
     ],
     "stage": [
      {
       "name": "Source",
       "dynamic": {
        "action": {
         "for_each": "${var.codestar_connection_arn != \"\" ? ['blah'] : []}",
         "content": [
          {
           "name": "Source",
           "category": "Source",
           "owner": "AWS",
           "provider": "CodeStarSourceConnection",
           "version": "1",
           "output_artifacts": [
            "master"
           ],
           "configuration": {
            "ConnectionArn": "",
            "FullRepositoryId": "${var.gh_username}/${var.gh_repo}",
            "BranchName": "master",
            "DetectChanges": true
           }
          }
         ]
        }
       }
      },
      {
       "name": "Build",
       "action": [
        {
         "name": "Build",
         "category": "Build",
         "owner": "AWS",
         "provider": "CodeBuild",
         "input_artifacts": [
          "master"
         ],
         "version": "1",
         "configuration": {
          "ProjectName": "basic-cicd-build-${var.gh_repo}-${var.gh_branch}-${var.cf_distribution}"
         }
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_codepipeline_webhook.webhook",
   "cfg": "aws_codepipeline_webhook.webhook",
   "type": "__declared__",
   "refs": [
    "aws_codepipeline.buildpipeline",
    "data.aws_ssm_parameter.gh_secret"
   ],
   "values": {
    "type": "aws_codepipeline_webhook",
    "name": "webhook",
    "gated": true,
    "gate": "var.codestar_connection_arn == \"\" ? 1 : 0",
    "properties": {
     "count": "${var.codestar_connection_arn == \"\" ? 1 : 0}",
     "name": "github-${var.gh_repo}-${var.gh_branch}-${var.cf_distribution}",
     "authentication": "GITHUB_HMAC",
     "target_action": "Source",
     "target_pipeline": "${aws_codepipeline.buildpipeline.name}",
     "authentication_configuration": [
      {
       "secret_token": "${data.aws_ssm_parameter.gh_secret[0].value}"
      }
     ],
     "filter": [
      {
       "json_path": "$.ref",
       "match_equals": "refs/heads/{Branch}"
      }
     ]
    }
   }
  }
 ]
}