   "values": {
    "type": "aws_s3_bucket",
    "name": "bucket",
    "gated": true,
    "gate": "var.versioning ? [1] : []",
    "properties": {
     "bucket": "${local.bucket_name}",
     "acl": "${var.acl}",
     "tags": "${var.tags}",
     "policy": "${var.policy}",
     "force_destroy": false,
     "acceleration_status": "${var.acceleration_status}",
     "request_payer": "BucketOwner",
     "dynamic": {
      "versioning": {
       "for_each": "${var.versioning ? [1] : []}",
       "content": [
        {
         "enabled": false,
         "mfa_delete": false
        }
       ]
      },
      "server_side_encryption_configuration": {
       "for_each": "${var.encryption ? ['${var.encryption}'] : []}",
       "content": [
        {
         "rule": [
          {
           "apply_server_side_encryption_by_default": [
            {
             "sse_algorithm": "aws:kms",
             "kms_master_key_id": "${local.effective_kms_key}"
            }
           ]
          }
         ]
        }
       ]
      },
      "grant": {
       "for_each": [],
       "content": [
        {
         "type": "${grant.value.type}",
         "permissions": "${grant.value.permissions}",
         "id": "${lookup(grant.value,\"id\",None)}",
         "uri": "${lookup(grant.value,\"uri\",None)}"
        }
       ]
      },
      "logging": {
       "for_each": "${var.logging_target_bucket != None ? ['${var.logging_target_bucket}'] : []}",
       "iterator": "${target_bucket}",
       "content": [
        {
         "target_bucket": "${target_bucket.value}",
         "target_prefix": "${var.logging_target_prefix}"
        }
       ]
      },
      "website": {
       "for_each": "${var.website_redirect_all != None ? ['${var.website_redirect_all}'] : []}",
       "content": [
        {
         "redirect_all_requests_to": "${var.website_redirect_all}"
        }
       ]
      },
      "cors_rule": {
       "for_each": [],
       "content": [
        {
         "allowed_methods": "${cors_rule.value.allowed_methods}",
         "allowed_origins": "${cors_rule.value.allowed_origins}",
         "allowed_headers": "${lookup(cors_rule.value,\"allowed_headers\",None)}",
         "expose_headers": "${lookup(cors_rule.value,\"expose_headers\",None)}",
         "max_age_seconds": "${lookup(cors_rule.value,\"max_age_seconds\",None)}"
        }
       ]
      },
      "lifecycle_rule": {
       "for_each": [],
       "content": [
        {
         "enabled": "${lifecycle_rule.value.enabled}",
         "id": "${lookup(lifecycle_rule.value,\"id\",None)}",
         "prefix": "${lookup(lifecycle_rule.value,\"prefix\",None)}",
         "tags": "${lookup(lifecycle_rule.value,\"tags\",None)}",
         "abort_incomplete_multipart_upload_days": "${lookup(lifecycle_rule.value,\"abort_incomplete_multipart_upload_days\",None)}",
         "dynamic": {
          "transition": {
           "for_each": "${lookup(lifecycle_rule.value,\"transitions\",[])}",
           "content": [
            {
             "storage_class": "${transition.value.storage_class}",
             "days": "${lookup(transition.value,\"days\",None)}",
             "date": "${lookup(transition.value,\"date\",None)}"
            }
           ]
          },
          "noncurrent_version_transition": {
           "for_each": "${lookup(lifecycle_rule.value,\"noncurrent_version_transitions\",[])}",
           "content": [
            {
             "storage_class": "${noncurrent_version_transition.value.storage_class}",
             "days": "${noncurrent_version_transition.value.days}"
            }
           ]
          },
          "noncurrent_version_expiration": {
           "for_each": "${lookup(lifecycle_rule.value,\"noncurrent_version_expiration\",[])}",
           "content": [
            {
             "days": "${noncurrent_version_expiration.value}"
            }
           ]
          },
          "expiration": {
           "for_each": "${lookup(lifecycle_rule.value,\"expiration\",None) != None ? ['${lifecycle_rule.value.expiration}'] : []}",
           "content": [
            {
             "days": "${lookup(expiration.value,\"days\",None)}",
             "date": "${lookup(expiration.value,\"date\",None)}",
             "expired_object_delete_marker": "${lookup(expiration.value,\"expired_object_delete_marker\",None)}"
            }
           ]
          }
         }
        }
       ]
      },
      "replication_configuration": {
       "for_each": "${var.replication_rules != [] ? [1] : []}",
       "content": [
        {
         "role": "${var.replication_role != None ? var.replication_role : aws_iam_role.replication[0].arn}",
         "dynamic": {
          "rules": {
           "for_each": [],
           "content": [
            {
             "status": "${rules.value.status}",
             "id": "${lookup(rules.value,\"id\",None)}",
             "priority": "${lookup(rules.value,\"priority\",None)}",
             "prefix": "${lookup(rules.value,\"prefix\",None)}",
             "dynamic": {
              "source_selection_criteria": {
               "for_each": "${lookup(rules.value,\"replicate_kms_encrypted_objects\",False) ? ['${rules.value.replicate_kms_encrypted_objects}'] : []}",
               "content": [
                {
                 "sse_kms_encrypted_objects": [
                  {
                   "enabled": "${rules.value.replicate_kms_encrypted_objects}"
                  }
                 ]
                }
               ]
              },
              "destination": {
               "for_each": [
                "${rules.value.destination}"
               ],
               "content": [
                {
                 "bucket": "${destination.value.bucket}",
                 "storage_class": "${lookup(destination.value,\"storage_class\",None)}",
                 "replica_kms_key_id": "${lookup(destination.value,\"replica_kms_key_id\",None)}",
                 "account_id": "${lookup(destination.value,\"account_id\",None)}"
                }
               ]
              },
              "filter": {
               "for_each": "${lookup(rules.value,\"filter\",None) != None ? ['${rules.value.filter}'] : []}",
               "content": [
