  {
   "id": "__declared__.aws_sns_topic_policy.sns_topic_publish_policy",
   "cfg": "aws_sns_topic_policy.sns_topic_publish_policy",
   "type": "__declared__",
   "refs": [
    "data.aws_iam_policy_document.sns_topic_policy",
    "sns_topic.arn"
   ],
   "values": {
    "type": "aws_sns_topic_policy",
    "name": "sns_topic_publish_policy",
    "gated": true,
    "gate": "module.this.enabled && local.create_sns_topic ? 1 : 0",
    "properties": {
     "count": "${module.this.enabled && local.create_sns_topic ? 1 : 0}",
     "arn": "${local.findings_notification_arn}",
     "policy": "${data.aws_iam_policy_document.sns_topic_policy[0].json}"
    }
   }
  },
  {
   "id": "__declared__.data.aws_iam_policy_document.sns_topic_policy",
   "cfg": "data.aws_iam_policy_document.sns_topic_policy",
   "type": "__declared__",
   "refs": [
    "sns_topic.arn"
   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "sns_topic_policy",
    "gated": true,
    "gate": "module.this.enabled && local.create_sns_topic ? 1 : 0",
    "properties": {
     "count": "${module.this.enabled && local.create_sns_topic ? 1 : 0}",
     "policy_id": "GuardDutyPublishToSNS",
     "statement": [
      {
       "sid": "",
       "actions": [
        "sns:Publish"
       ],
       "principals": [
        {
         "type": "Service",
         "identifiers": [
          "cloudwatch.amazonaws.com"
         ]
        }
       ],
       "resources": [
        "${module.sns_topic[0].sns_topic.arn}"
       ],
       "effect": "Allow"
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_cloudwatch_event_rule.findings",
   "cfg": "aws_cloudwatch_event_rule.findings",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_cloudwatch_event_rule",
    "name": "findings",
    "gated": true,
    "gate": "local.enable_cloudwatch == true ? 1 : 0",
    "properties": {
     "count": "${local.enable_cloudwatch == True ? 1 : 0}",
     "name": "${module.findings_label.id}",
     "description": "GuardDuty Findings",
     "tags": "${module.this.tags}",
     "event_pattern": "${jsonencode({'source': ['aws.guardduty'], 'detail-type': ['${var.cloudwatch_event_rule_pattern_detail_type}']})}"
    }
   }
  },
  {
   "id": "__declared__.aws_cloudwatch_event_target.imported_findings",
