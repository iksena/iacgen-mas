   "type": "__declared__",
   "refs": [
    "aws_cloudwatch_event_rule.findings",
    "sns_topic.arn"
   ],
   "values": {
    "type": "aws_cloudwatch_event_target",
    "name": "imported_findings",
    "gated": true,
    "gate": "local.enable_notifications == true ? 1 : 0",
    "properties": {
     "count": "${local.enable_notifications == True ? 1 : 0}",
     "rule": "${aws_cloudwatch_event_rule.findings[0].name}",
     "arn": "${local.findings_notification_arn}"
    }
   }
  }
