  {
   "id": "__declared__.aws_cognito_user_pool.pool",
   "cfg": "aws_cognito_user_pool.pool",
   "type": "__declared__",
   "refs": [
    "custom_email_sender.lambda_arn",
    "custom_email_sender.lambda_version",
    "device_configuration.value",
    "recovery_mechanism.value",
    "string_attribute_constraints.max_length",
    "string_attribute_constraints.min_length"
   ],
   "values": {
    "type": "aws_cognito_user_pool",
    "name": "pool",
    "gated": true,
    "gate": "(var.sms_configuration.external_id != \"\" && var.sms_configuration.sns_caller_arn != \"\") ? [1] : []",
    "properties": {
     "name": "Pool name",
     "alias_attributes": [
      "email",
      "phone_number"
     ],
     "auto_verified_attributes": [],
     "email_verification_message": "Some message {####}",
     "email_verification_subject": "Some subject",
     "mfa_configuration": "OPTIONAL",
     "sms_authentication_message": "SMS authentication message {####}",
     "sms_verification_message": "SMS verification message {####}",
     "dynamic": {
      "sms_configuration": {
       "for_each": "${var.sms_configuration.external_id != \"\" && var.sms_configuration.sns_caller_arn != \"\" ? [1] : []}",
       "content": [
        {
         "external_id": "${var.sms_configuration.external_id}",
         "sns_caller_arn": "${var.sms_configuration.sns_caller_arn}"
        }
       ]
      },
      "device_configuration": {
       "for_each": "${var.challenge_required_on_new_device != None || var.device_only_remembered_on_user_prompt != None ? [{'challenge_required_on_new_device': '${var.challenge_required_on_new_device}', 'device_only_remembered_on_user_prompt': '${var.device_only_remembered_on_user_prompt}'}] : []}",
       "content": [
        {
         "challenge_required_on_new_device": "${device_configuration.value.challenge_required_on_new_device}",
         "device_only_remembered_on_user_prompt": "${device_configuration.value.device_only_remembered_on_user_prompt}"
        }
       ]
      },
      "lambda_config": {
       "for_each": "${length(keys(var.lambda_config)) != 0 ? [1] : []}",
       "content": [
        {
         "kms_key_id": "${try(var.lambda_config.kms_key_id,None)}",
         "create_auth_challenge": "${try(var.lambda_config.create_auth_challenge,None)}",
         "define_auth_challenge": "${try(var.lambda_config.define_auth_challenge,None)}",
         "verify_auth_challenge_response": "${try(var.lambda_config.verify_auth_challenge_response,None)}",
         "dynamic": {
          "custom_email_sender": {
           "for_each": "${try(var.lambda_config.custom_email_sender.lambda_arn,None) != None && try(var.lambda_config.custom_email_sender.lambda_version,None) != None ? [1] : []}",
           "content": [
            {
             "lambda_arn": "${var.lambda_config.custom_email_sender.lambda_arn}",
             "lambda_version": "${var.lambda_config.custom_email_sender.lambda_version}"
            }
           ]
          }
         }
        }
       ]
      },
      "schema": {
       "for_each": "${[for item in var.schema : item if try(item.string_attribute_constraints.max_length,None) == None || try(item.string_attribute_constraints.min_length,None) == None]}",
       "content": [
        {
         "attribute_data_type": "${schema.value.attribute_data_type}",
         "developer_only_attribute": "${schema.value.developer_only_attribute}",
         "mutable": "${schema.value.mutable}",
         "name": "${schema.value.name}",
         "required": "${schema.value.required}",
         "string_attribute_constraints": [
          {}
         ]
        }
       ]
      },
      "software_token_mfa_configuration": {
       "for_each": "${var.software_token_mfa_configuration == True || var.software_token_mfa_configuration == False ? [1] : []}",
       "content": [
        {
         "enabled": true
        }
       ]
      },
      "username_configuration": {
       "for_each": "${var.case_sensitive == True || var.case_sensitive == False ? [1] : []}",
       "content": [
        {
         "case_sensitive": "${var.case_sensitive}"
        }
       ]
      }
     },
     "verification_message_template": [
      {
       "email_message_by_link": "${var.verification_message_template.email_message_by_link}",
       "email_subject_by_link": "${var.verification_message_template.email_subject_by_link}"
      }
     ],
     "account_recovery_setting": [
      {
       "dynamic": {
        "recovery_mechanism": {
         "for_each": [
          {
           "name": "verified_email",
           "priority": 2
          },
          {
           "name": "verified_phone_number",
           "priority": 1
          }
         ],
         "content": [
          {
           "name": "${recovery_mechanism.value.name}",
           "priority": "${recovery_mechanism.value.priority}"
          }
         ]
        }
       }
      }
     ],
     "admin_create_user_config": [
      {
       "allow_admin_create_user_only": false,
       "invite_message_template": [
        {
         "email_message": "${var.invite_message_template.email_message}",
         "email_subject": "${var.invite_message_template.email_subject}",
         "sms_message": "${var.invite_message_template.sms_message}"
        }
       ]
      }
     ],
     "lifecycle": [
      {
       "ignore_changes": [
        "${estimated_number_of_users}"
       ]
      }
     ]
    }
   }
  }
 ]
}