   "refs": [
    "aws_vpc.vpc"
   ],
   "values": {
    "type": "aws_route_table",
    "name": "intra",
    "gated": true,
    "gate": "var.module_enabled ? local.intra_subnets_by_group : {}",
    "properties": {
     "for_each": "${var.module_enabled ? local.intra_subnets_by_group : {}}",
     "vpc_id": "${aws_vpc.vpc[0].id}",
     "tags": "${merge({'Name': '${var.vpc_name}-intra-${each.key}', 'mineiros-io/aws/vpc/vpc-name': '${var.vpc_name}', 'mineiros-io/aws/vpc/routetable-name': '${var.vpc_name}-intra-${each.key}', 'mineiros-io/aws/vpc/routetable-class': 'intra'},var.module_tags,var.route_table_tags,var.intra_route_table_tags)}",
