    "name": "public",
    "gated": true,
    "gate": "var.module_enabled ? local.public_subnets_by_group : {}",
    "properties": {
     "for_each": "${var.module_enabled ? local.public_subnets_by_group : {}}",
     "vpc_id": "${aws_vpc.vpc[0].id}",
     "tags": "${merge({'Name': '${var.vpc_name}-public-${each.key}', 'mineiros-io/aws/vpc/vpc-name': '${var.vpc_name}', 'mineiros-io/aws/vpc/routetable-name': '${var.vpc_name}-public-${each.key}', 'mineiros-io/aws/vpc/routetable-class': 'public'},var.module_tags,var.route_table_tags,var.public_route_table_tags)}",
     "depends_on": [
      []
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_route_table_association.public",
   "cfg": "aws_route_table_association.public",
   "type": "__declared__",
   "refs": [
    "aws_route_table.public",
    "aws_subnet.subnet"
   ],
   "values": {
    "type": "aws_route_table_association",
    "name": "public",
    "gated": true,
    "gate": "var.module_enabled ? {",
    "properties": {
     "for_each": "${var.module_enabled ? {for subnet in flatten(values(local.public_subnets_by_group)) : subnet.cidr_block => subnet} : {}}",
     "subnet_id": "${aws_subnet.subnet[each.key].id}",
     "route_table_id": "${aws_route_table.public[each.value.group].id}",
     "depends_on": [
      []
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_route.internet_gateway",
   "cfg": "aws_route.internet_gateway",
   "type": "__declared__",
   "refs": [
    "aws_internet_gateway.internet_gateway",
    "aws_route_table.public"
   ],
   "values": {
    "type": "aws_route",
    "name": "internet_gateway",
    "gated": true,
    "gate": "aws_route_table.public",
    "properties": {
     "for_each": "${aws_route_table.public}",
     "route_table_id": "${each.value.id}",
     "destination_cidr_block": "0.0.0.0/0",
     "gateway_id": "${aws_internet_gateway.internet_gateway[0].id}",
     "timeouts": [
      {
       "create": "10m"
      }
     ],
     "depends_on": [
      []
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_subnet.subnet",
   "cfg": "aws_subnet.subnet",
   "type": "__declared__",
   "refs": [
    "aws_vpc.vpc"
   ],
   "values": {
    "type": "aws_subnet",
    "name": "subnet",
    "gated": true,
    "gate": "var.module_enabled ? local.subnets : {}",
    "properties": {
     "for_each": "${var.module_enabled ? local.subnets : {}}",
     "vpc_id": "${aws_vpc.vpc[0].id}",
     "cidr_block": "${cidrsubnet(each.value.cidr_block,0,0)}",
     "availability_zone": "${each.value.availability_zone}",
     "map_public_ip_on_launch": "${each.value.map_public_ip_on_launch}",
     "ipv6_cidr_block": "${try(cidrsubnet(each.value.ipv6_cidr_block,0,0),None)}",
     "assign_ipv6_address_on_creation": "${try(each.value.assign_ipv6_address_on_creation,None)}",
     "tags": "${merge(var.module_tags,var.subnet_tags,each.value.tags)}",
