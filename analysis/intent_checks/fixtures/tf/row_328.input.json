   ],
   "values": {
    "type": "aws_internet_gateway",
    "name": "internet_gateway",
    "gated": true,
    "gate": "var.module_enabled && length(local.public_subnets) > 0 ? 1 : 0",
    "properties": {
     "count": "${var.module_enabled && length(local.public_subnets) > 0 ? 1 : 0}",
     "vpc_id": "${aws_vpc.vpc[0].id}",
     "tags": "${merge({'Name': '${var.vpc_name}', 'mineiros-io/aws/vpc/vpc-name': '${var.vpc_name}', 'mineiros-io/aws/vpc/igw-name': '${var.vpc_name}'},var.module_tags,var.internet_gateway_tags)}",
     "depends_on": [
      []
     ]
    }
   }
  },
  {
