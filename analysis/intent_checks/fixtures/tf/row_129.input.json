    "name": "daily",
    "gated": true,
    "gate": "var.daily_backups_enabled ? 1 : 0",
    "properties": {
     "name": "rds-daily-backup-plan",
     "count": "${var.daily_backups_enabled ? 1 : 0}",
     "rule": [
      {
       "rule_name": "daily-backup-rule",
       "target_vault_name": "${aws_backup_vault.rds_backup_vault.name}",
