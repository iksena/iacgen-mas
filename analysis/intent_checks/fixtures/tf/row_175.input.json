   "id": "__declared__.data.aws_iam_policy_document.logging",
   "cfg": "data.aws_iam_policy_document.logging",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "logging",
    "gated": true,
    "gate": "var.logging_enabled ? 1 : 0",
    "properties": {
     "count": "${var.logging_enabled ? 1 : 0}",
     "statement": [
      {
       "sid": "AWSTransferLogging",
       "effect": "Allow",
       "actions": [
        "logs:CreateLogStream",
        "logs:DescribeLogStreams",
        "logs:CreateLogGroup",
        "logs:PutLogEvents"
       ],
       "resources": [
        "*"
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.data.aws_iam_policy_document.sftp_user_policy",
   "cfg": "data.aws_iam_policy_document.sftp_user_policy",
   "type": "__declared__",
   "refs": [
    "aws_efs_file_system.efs"
   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "sftp_user_policy",
    "gated": true,
    "gate": "var.create_iam_role ? 1 : 0",
    "properties": {
     "count": "${var.create_iam_role ? 1 : 0}",
     "statement": [
      {
       "effect": "Allow",
       "actions": [
        "elasticfilesystem:ClientMount",
        "elasticfilesystem:ClientRootAccess",
        "elasticfilesystem:ClientRead",
        "elasticfilesystem:ClientExecute",
        "elasticfilesystem:DescribeMountTargets",
        "elasticfilesystem:ClientWrite"
       ],
       "resources": [
        "${aws_efs_file_system.efs.arn}"
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.data.aws_iam_policy_document.assume_role_policy",
   "cfg": "data.aws_iam_policy_document.assume_role_policy",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "assume_role_policy",
    "gated": true,
    "gate": "var.logging_enabled ? 1 : 0",
    "properties": {
     "count": "${var.logging_enabled ? 1 : 0}",
     "statement": [
      {
       "actions": [
        "sts:AssumeRole"
       ],
       "principals": [
        {
         "type": "Service",
         "identifiers": [
          "transfer.amazonaws.com"
         ]
        }
       ]
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_efs_file_system.efs",
   "cfg": "aws_efs_file_system.efs",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_efs_file_system",
    "name": "efs",
    "gated": false,
    "gate": null,
    "properties": {
     "creation_token": "",
     "encrypted": true,
     "kms_key_id": "${var.kms_key_id}",
     "performance_mode": "generalPurpose",
     "provisioned_throughput_in_mibps": 0,
     "tags": "${merge({'Name': '${var.efs_name}'},var.tags)}",
     "throughput_mode": "bursting"
    }
   }
  },
  {
   "id": "__declared__.aws_efs_mount_target.mount_target",
   "cfg": "aws_efs_mount_target.mount_target",
   "type": "__declared__",
   "refs": [
    "aws_efs_file_system.efs",
    "aws_security_group.efs"
   ],
   "values": {
    "type": "aws_efs_mount_target",
    "name": "mount_target",
    "gated": true,
    "gate": "toset(var.subnets)",
    "properties": {
     "for_each": "${toset(var.subnets)}",
     "file_system_id": "${aws_efs_file_system.efs.id}",
     "subnet_id": "${each.value}",
     "security_groups": "${var.create_efs_security_group ? compact(concat(['${aws_security_group.efs[0].id}'],var.security_groups)) : var.security_groups}"
    }
   }
  },
  {
   "id": "__declared__.aws_efs_access_point.user_access_point",
   "cfg": "aws_efs_access_point.user_access_point",
   "type": "__declared__",
   "refs": [
    "aws_efs_file_system.efs"
   ],
   "values": {
    "type": "aws_efs_access_point",
    "name": "user_access_point",
    "gated": true,
    "gate": "var.enable_user_access_point ? var.sftp_users : {}",
    "properties": {
     "for_each": "${var.enable_user_access_point ? var.sftp_users : {}}",
     "file_system_id": "${aws_efs_file_system.efs.id}",
     "posix_user": [
      {
       "uid": "${each.value.uid}",
       "gid": "${each.value.gid}"
      }
     ],
     "root_directory": [
      {
