  {
   "id": "__declared__.aws_backup_plan.plan",
   "cfg": "aws_backup_plan.plan",
   "type": "__declared__",
   "refs": [
    "aws_backup_vault.vault",
    "random_string.random"
   ],
   "values": {
    "type": "aws_backup_plan",
    "name": "plan",
    "gated": true,
    "gate": "var.cold_storage_after != null || var.delete_after != null ? [1] : []",
    "properties": {
     "name": "${local.name}-backup-plan",
     "tags": {
      "Name": "${local.name}-backup-plan"
     },
     "rule": [
      {
       "rule_name": "${local.name}-backup-rule",
       "target_vault_name": "${aws_backup_vault.vault.name}",
       "schedule": "cron(0 12 * * ? *)",
       "dynamic": {
        "lifecycle": {
         "for_each": "${var.cold_storage_after != None || var.delete_after != None ? [1] : []}",
         "content": [
          {
           "cold_storage_after": "${var.cold_storage_after}",
           "delete_after": "${var.delete_after}"
          }
         ]
        },
        "copy_action": {
         "for_each": "${var.secondary_vault_arn != None ? [1] : []}",
         "content": [
          {
           "destination_vault_arn": "${var.secondary_vault_arn}",
           "dynamic": {
            "lifecycle": {
             "for_each": "${local.secondary_vault_cold_storage_after != None || local.secondary_vault_delete_after != None ? [1] : []}",
             "content": [
              {
               "cold_storage_after": "${local.secondary_vault_cold_storage_after}",
               "delete_after": "${local.secondary_vault_delete_after}"
              }
             ]
            }
           }
          }
         ]
        }
       },
       "recovery_point_tags": {
        "Name": "${local.name}-backup-recovery-point"
       }
      }
     ]
    }
   }
  },
