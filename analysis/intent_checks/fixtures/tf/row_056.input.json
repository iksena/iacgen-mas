    "type": "aws_dsql_cluster_peering",
    "name": "this",
    "gated": true,
    "gate": "var.create && var.create_cluster_peering ? 1 : 0",
    "properties": {
     "count": "${var.create && var.create_cluster_peering ? 1 : 0}",
     "region": "${var.region}",
     "clusters": "${var.clusters}",
     "identifier": "${aws_dsql_cluster.this[0].identifier}",
     "witness_region": "${var.witness_region}",
     "dynamic": {
      "timeouts": {
       "for_each": "${var.timeouts != None ? ['${var.timeouts}'] : []}",
       "content": [
        {
         "create": "${timeouts.value.create}"
        }
       ]
      }
     }
    }
   }
