   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_dsql_cluster",
    "name": "this",
    "gated": true,
    "gate": "var.create ? 1 : 0",
    "properties": {
     "count": "${var.create ? 1 : 0}",
     "region": "${var.region}",
     "deletion_protection_enabled": "${var.deletion_protection_enabled}",
     "kms_encryption_key": "${var.kms_encryption_key}",
     "force_destroy": "${var.force_destroy}",
     "dynamic": {
      "multi_region_properties": {
       "for_each": "${var.witness_region != None ? [True] : []}",
       "content": [
        {
         "witness_region": "${var.witness_region}"
        }
       ]
      }
     },
     "tags": "${merge(var.tags,{for k , v in {'Name': '${var.name}'} : k => v if v != \"\"})}"
    }
   }
  },
