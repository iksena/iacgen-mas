  {
   "id": "__declared__.aws_s3_bucket_lifecycle_configuration.private_bucket",
   "cfg": "aws_s3_bucket_lifecycle_configuration.private_bucket",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.private_bucket",
    "noncurrent_version_expiration.value",
    "noncurrent_version_transition.value"
   ],
   "values": {
    "type": "aws_s3_bucket_lifecycle_configuration",
    "name": "private_bucket",
    "gated": true,
    "gate": "local.aiu_has_expiration == true ? [var.lifecycle_abort_incomplete_upload.expiration] : []",
    "properties": {
     "bucket": "${aws_s3_bucket.private_bucket.id}",
     "transition_default_minimum_object_size": "all_storage_classes_128K",
     "rule": [
      {
       "id": "abort-incomplete-multipart-upload",
       "status": "Enabled",
       "filter": [
        {}
       ],
       "abort_incomplete_multipart_upload": [
        {
         "days_after_initiation": 14
        }
       ],
       "dynamic": {
        "expiration": {
         "for_each": "${local.aiu_has_expiration == True ? ['${var.lifecycle_abort_incomplete_upload.expiration}'] : []}",
         "content": [
          {
           "date": "${expiration.value.date}",
           "days": "${expiration.value.days}",
           "expired_object_delete_marker": "${expiration.value.expired_object_delete_marker}"
          }
         ]
        },
        "transition": {
         "for_each": "${local.aiu_has_transition == True ? ['${var.lifecycle_abort_incomplete_upload.transition}'] : []}",
         "content": [
          {
           "days": "${transition.value.days}",
           "storage_class": "${transition.value.storage_class}"
          }
         ]
        },
        "noncurrent_version_transition": {
         "for_each": "${local.aiu_has_nvt == True ? ['${var.lifecycle_abort_incomplete_upload.nvt}'] : []}",
         "content": [
          {
           "newer_noncurrent_versions": "${noncurrent_version_transition.value.newer_noncurrent_versions}",
           "noncurrent_days": "${noncurrent_version_transition.value.noncurrent_days}",
           "storage_class": "${noncurrent_version_transition.value.storage_class}"
          }
         ]
        },
        "noncurrent_version_expiration": {
         "for_each": "${local.aiu_has_nve == True ? ['${var.lifecycle_abort_incomplete_upload.nve}'] : []}",
         "content": [
          {
           "newer_noncurrent_versions": "${noncurrent_version_expiration.value.newer_noncurrent_versions}",
           "noncurrent_days": "${noncurrent_version_expiration.value.noncurrent_days}"
          }
         ]
        }
       }
      },
      {
       "id": "aws-bucket-inventory",
       "status": "${var.enable_bucket_inventory ? \"Enabled\" : \"Disabled\"}",
       "filter": [
        {
         "prefix": "_AWSBucketInventory/"
        }
       ],
       "expiration": [
        {
         "days": 14
        }
       ]
      },
      {
       "id": "aws-bucket-analytics",
       "status": "${var.enable_analytics ? \"Enabled\" : \"Disabled\"}",
       "filter": [
        {
         "prefix": "_AWSBucketAnalytics/"
        }
       ],
       "expiration": [
        {
         "days": 30
        }
       ]
      }
     ],
     "dynamic": {
      "rule": {
       "for_each": [],
       "content": [
        {
         "id": "${rule.value[\"id\"]}",
         "status": "${rule.value[\"status\"]}",
         "dynamic": {
          "filter": {
           "for_each": "${rule.value.filter}",
           "content": [
            {
             "prefix": "${filter.value[\"prefix\"]}"
            }
           ]
          },
          "expiration": {
           "for_each": "${rule.value.expiration}",
           "content": [
            {
             "days": "${expiration.value[\"days\"]}"
            }
           ]
          }
         }
        }
       ]
      }
     }
    }
   }
  },
