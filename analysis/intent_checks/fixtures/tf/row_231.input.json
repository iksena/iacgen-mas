   "values": {
    "type": "aws_ec2_managed_prefix_list",
    "name": "prefix_list",
    "gated": true,
    "gate": "var.enable && var.prefix_list_enabled && length(var.prefix_list_ids) < 1 ? 1 : 0",
    "properties": {
