   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "default",
    "gated": true,
    "gate": "local.prebuilt_policy_enabled ? 1 : 0",
    "properties": {
     "count": "${local.prebuilt_policy_enabled ? 1 : 0}",
     "statement": [
      {
       "sid": "${var.prebuilt_policy.sid}",
