   "id": "__declared__.aws_iam_policy.write",
   "cfg": "aws_iam_policy.write",
   "type": "__declared__",
   "refs": [
    "aws_cloudwatch_log_group.logs"
   ],
   "values": {
    "type": "aws_iam_policy",
    "name": "write",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "${format(\"%s-logs-write\",local.name)}",
     "description": "${format(\"Allow to push and write logs to the cloudwatch logs\")}",
     "path": "/",
     "policy": "${jsonencode({'Statement': [{'Action': ['logs:CreateLogStream', 'logs:DescribeLogStreams', 'logs:PutLogEvents'], 'Effect': 'Allow', 'Resource': ['${aws_cloudwatch_log_group.logs.arn}']}], 'Version': '2012-10-17'})}"
    }
   }
