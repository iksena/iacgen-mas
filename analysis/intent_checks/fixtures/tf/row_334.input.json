  {
   "id": "__declared__.aws_cloudwatch_log_group.logs",
   "cfg": "aws_cloudwatch_log_group.logs",
   "type": "__declared__",
   "refs": [],
   "values": {
    "type": "aws_cloudwatch_log_group",
    "name": "logs",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "${local.log_group_name}",
     "tags": "${merge(local.default-tags,var.tags)}",
     "retention_in_days": "${lookup(local.log_group,\"retension_days\",7)}"
    }
   }
  },
  {
   "id": "__declared__.aws_cloudwatch_log_metric_filter.filters",
   "cfg": "aws_cloudwatch_log_metric_filter.filters",
   "type": "__declared__",
   "refs": [
    "aws_cloudwatch_log_group.logs"
   ],
   "values": {
    "type": "aws_cloudwatch_log_metric_filter",
    "name": "filters",
    "gated": true,
    "gate": "var.log_metric_filters != null ? { for k, v in var.log_metric_filters : k => v } : {}",
    "properties": {
     "for_each": "${var.log_metric_filters != None ? {for k , v in var.log_metric_filters : k => v} : {}}",
     "name": "${lookup(each.value,\"name\",each.key)}",
     "pattern": "${lookup(each.value,\"pattern\",None)}",
     "log_group_name": "${aws_cloudwatch_log_group.logs.name}",
     "metric_transformation": [
      {
       "name": "${lookup(each.value,\"name\",None)}",
       "namespace": "${lookup(each.value,\"namespace\",None)}",
       "value": "${lookup(each.value,\"value\",1)}",
       "default_value": "${lookup(each.value,\"default_value\",None)}"
      }
     ]
    }
   }
