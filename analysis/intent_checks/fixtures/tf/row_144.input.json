    "aws_iam_role.awsconfig",
    "aws_sns_topic.noti"
   ],
   "values": {
    "type": "aws_iam_role_policy",
    "name": "noti",
    "gated": false,
    "gate": null,
    "properties": {
     "name": "${join(\"-\",['${local.name}', 'sns-publish'])}",
     "role": "${aws_iam_role.awsconfig.id}",
     "policy": "${jsonencode({'Version': '2012-10-17', 'Statement': [{'Effect': 'Allow', 'Action': ['SNS:Publish'], 'Resource': ['${aws_sns_topic.noti.arn}']}]})}"
    }
   }
  },
  {
   "id": "__declared__.aws_config_configuration_recorder.recorder",
   "cfg": "aws_config_configuration_recorder.recorder",
   "type": "__declared__",
   "refs": [
    "aws_iam_role.awsconfig"
   ],
   "values": {
    "type": "aws_config_configuration_recorder",
    "name": "recorder",
    "gated": false,
    "gate": null,
    "properties": {
     "depends_on": [
      "${module.snapshot}"
     ],
     "name": "${local.name}",
     "role_arn": "${aws_iam_role.awsconfig.arn}",
     "recording_group": [
      {
       "all_supported": true,
       "include_global_resource_types": true
      }
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_config_configuration_recorder_status.recorder",
   "cfg": "aws_config_configuration_recorder_status.recorder",
   "type": "__declared__",
   "refs": [
    "aws_config_configuration_recorder.recorder",
    "aws_config_delivery_channel.recorder"
   ],
   "values": {
    "type": "aws_config_configuration_recorder_status",
    "name": "recorder",
    "gated": false,
    "gate": null,
    "properties": {
     "depends_on": [
      "${aws_config_delivery_channel.recorder}"
     ],
     "name": "${aws_config_configuration_recorder.recorder.name}",
     "is_enabled": true
    }
   }
  },
  {
   "id": "__declared__.aws_config_delivery_channel.recorder",
   "cfg": "aws_config_delivery_channel.recorder",
   "type": "__declared__",
   "refs": [
    "aws_config_configuration_recorder.recorder",
    "aws_sns_topic.noti"
   ],
   "values": {
    "type": "aws_config_delivery_channel",
    "name": "recorder",
    "gated": true,
    "gate": "{ for k, v in [lookup(var.record_config, \"snapshot_delivery_properties\", {})] : k => v }",
    "properties": {
     "depends_on": [
      "${aws_config_configuration_recorder.recorder}"
     ],
     "name": "${local.name}",
     "s3_bucket_name": "${module.snapshot.bucket.id}",
     "s3_key_prefix": "awsconfig/records",
     "sns_topic_arn": "${aws_sns_topic.noti.arn}"
    }
   }
  },
  {
   "id": "__declared__.aws_config_config_rule.rules",
   "cfg": "aws_config_config_rule.rules",
   "type": "__declared__",
   "refs": [
    "aws_config_configuration_recorder_status.recorder"
   ],
   "values": {
    "type": "aws_config_config_rule",
    "name": "rules",
    "gated": true,
    "gate": "{ for rule in local.default_config_rules : rule.name => rule }",
    "properties": {
     "depends_on": [
      "${aws_config_configuration_recorder_status.recorder}"
     ],
     "for_each": "${{for rule in local.default_config_rules : rule.name => rule}}",
     "name": "${each.key}",
     "tags": "${merge(local.default-tags,var.tags)}",
     "description": "${lookup(each.value,\"description\",None)}",
     "maximum_execution_frequency": "${lookup(each.value,\"maximum_execution_frequency\",None)}",
     "input_parameters": "${lookup(each.value,\"input_parameters\",None)}",
     "source": [
      {
       "owner": "${lookup(each.value.source,\"owner\")}",
       "source_identifier": "${lookup(each.value.source,\"source_identifier\")}"
      }
     ],
     "dynamic": {
      "scope": {
       "for_each": "${{for k , v in ['${lookup(each.value,\"scope\",{})}'] : k => v}}",
       "content": [
        {
         "compliance_resource_types": "${lookup(scope.value,\"compliance_resource_types\",[])}"
        }
       ]
      }
     }
    }
   }
  },
