     "enable_key_rotation": true,
     "policy": "${jsonencode({'Version': '2012-10-17', 'Statement': [{'Sid': 'AllowAccountRoot', 'Effect': 'Allow', 'Principal': {'AWS': '*'}, 'Action': 'kms:*', 'Resource': '*', 'Condition': {'StringEquals': {'kms:CallerAccount': '${data.aws_caller_identity.current.account_id}'}}}, {'Sid': 'AllowCloudWatchToPublish', 'Effect': 'Allow', 'Principal': {'Service': 'cloudwatch.amazonaws.com'}, 'Action': ['kms:Decrypt', 'kms:GenerateDataKey*'], 'Resource': '*'}]})}"
    }
   }
