  {
   "id": "__declared__.aws_subnet.vpc_subnets",
   "cfg": "aws_subnet.vpc_subnets",
   "type": "__declared__",
   "refs": [
    "aws_vpc.main-vpc"
   ],
   "values": {
    "type": "aws_subnet",
    "name": "vpc_subnets",
    "gated": true,
    "gate": "{ for sn in var.sn_details : sn.name => sn }",
    "properties": {
     "for_each": "${{for sn in var.sn_details : sn.name => sn}}",
     "cidr_block": "${module.ipv4_subnets.networks[index([for network in module.ipv4_subnets.networks : network.name],each.value.name)].cidr_block}",
     "ipv6_cidr_block": "${var.is_ipv6_enabled ? module.ipv6_subnets.networks[index([for network in module.ipv6_subnets.networks : network.name],each.value.name)].cidr_block : None}",
     "vpc_id": "${aws_vpc.main-vpc.id}",
     "availability_zone": "${each.value.availability_zone}",
     "assign_ipv6_address_on_creation": true,
     "map_public_ip_on_launch": false,
     "tags": {
      "Name": "${each.value.name}",
      "Public": "${each.value.is_public}"
     }
    }
   }
  },
  {
