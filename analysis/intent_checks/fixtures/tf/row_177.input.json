      "${aws_s3_bucket_public_access_block.this}",
      "${aws_s3_bucket.this}"
     ]
    }
   }
  },
  {
   "id": "__declared__.aws_s3_bucket_intelligent_tiering_configuration.this",
   "cfg": "aws_s3_bucket_intelligent_tiering_configuration.this",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.this"
   ],
   "values": {
    "type": "aws_s3_bucket_intelligent_tiering_configuration",
    "name": "this",
    "gated": true,
    "gate": "{ for k, v in local.intelligent_tiering : k => v if local.create_bucket }",
    "properties": {
     "for_each": "${{for k , v in local.intelligent_tiering : k => v if local.create_bucket}}",
     "name": "${each.key}",
     "bucket": "${aws_s3_bucket.this[0].id}",
     "status": "${try(tobool(each.value.status) ? \"Enabled\" : \"Disabled\",title(lower(each.value.status)),None)}",
     "dynamic": {
      "filter": {
       "for_each": "${length(try(flatten(['${each.value.filter}']),[])) == 0 ? [] : [True]}",
       "content": [
        {
