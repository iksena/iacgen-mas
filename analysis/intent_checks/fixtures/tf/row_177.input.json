         "tags": "${try(each.value.filter.tags,None)}"
        }
       ]
      },
      "tiering": {
       "for_each": "${each.value.tiering}",
       "content": [
        {
         "access_tier": "${tiering.key}",
         "days": "${tiering.value.days}"
        }
       ]
      }
     }
    }
   }
  }
