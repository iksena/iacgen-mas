   "id": "__declared__.data.aws_iam_policy_document.bucket_policy",
   "cfg": "data.aws_iam_policy_document.bucket_policy",
   "type": "__declared__",
   "refs": [
    "data.aws_caller_identity.current",
    "data.aws_partition.current"
   ],
   "values": {
    "type": "data.aws_iam_policy_document",
    "name": "bucket_policy",
    "gated": true,
    "gate": "local.create_log_bucket ? 1 : 0",
    "properties": {
     "count": "${local.create_log_bucket ? 1 : 0}",
     "statement": [
      {
       "effect": "Allow",
       "actions": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetEncryptionConfiguration"
       ],
       "resources": [
        "${format(\"arn:%s:s3:::%s\",local.aws_partition,module.this.id)}",
        "${format(\"arn:%s:s3:::%s/*\",local.aws_partition,module.this.id)}"
       ],
       "principals": [
        {
         "identifiers": [
          "${format(\"arn:%s:iam::%s:root\",local.aws_partition,local.account_id)}"
         ],
         "type": "AWS"
        }
       ]
      }
     ]
    }
   }
  }
