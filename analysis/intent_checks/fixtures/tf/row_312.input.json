  {
   "id": "__declared__.aws_ssm_maintenance_window_task.task_scan_patches",
   "cfg": "aws_ssm_maintenance_window_task.task_scan_patches",
   "type": "__declared__",
   "refs": [
    "aws_ssm_maintenance_window.scan_window",
    "aws_ssm_maintenance_window_target.target_scan"
   ],
   "values": {
    "type": "aws_ssm_maintenance_window_task",
    "name": "task_scan_patches",
    "gated": true,
    "gate": "local.enabled ? 1 : 0",
    "properties": {
     "count": "${local.enabled ? 1 : 0}",
     "window_id": "${aws_ssm_maintenance_window.scan_window[0].id}",
     "task_type": "RUN_COMMAND",
     "task_arn": "AWS-RunPatchBaseline",
     "priority": 1,
     "service_role_arn": "${var.service_role_arn}",
     "max_concurrency": 20,
     "max_errors": 50,
     "targets": [
      {
       "key": "WindowTargetIds",
       "values": "${aws_ssm_maintenance_window_target.target_scan[*].id}"
      }
     ],
     "task_invocation_parameters": [
      {
       "run_command_parameters": [
        {
         "parameter": [
          {
           "name": "Operation",
           "values": [
            "Scan"
           ]
          },
          {
           "name": "RebootOption",
           "values": [
            "NoReboot"
           ]
          }
         ],
         "output_s3_bucket": "${var.s3_log_output_enabled ? local.bucket_id : None}",
         "output_s3_key_prefix": "${var.s3_log_output_enabled ? var.s3_bucket_prefix_scan_logs : None}",
         "service_role_arn": "",
         "dynamic": {
          "notification_config": {
           "for_each": "${var.scan_sns_notification_enabled ? [1] : []}",
           "content": [
            {
             "notification_arn": "",
             "notification_events": [
              "All"
             ],
             "notification_type": "Command"
            }
           ]
          },
          "cloudwatch_config": {
           "for_each": "${var.cloudwatch_log_output_enabled ? [1] : []}",
           "content": [
            {
             "cloudwatch_output_enabled": false,
             "cloudwatch_log_group_name": "${var.cloudwatch_log_group_name}"
            }
           ]
          }
         }
        }
       ]
      }
     ]
    }
   }
  },
  {
