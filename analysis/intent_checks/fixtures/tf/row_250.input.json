  {
   "id": "__declared__.aws_iam_policy.tfstate_stack_backends",
   "cfg": "aws_iam_policy.tfstate_stack_backends",
   "type": "__declared__",
   "refs": [
    "aws_dynamodb_table.stack_tfstate_backends_lock",
    "aws_kms_key.tfstate_backends",
    "aws_s3_bucket.tfstate_backends"
   ],
   "values": {
    "type": "aws_iam_policy",
    "name": "tfstate_stack_backends",
    "gated": true,
    "gate": "local.stacks_info",
    "properties": {
     "for_each": "${local.stacks_info}",
     "name": "${each.key}-tfstate-s3-stack-backends",
     "policy": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"${aws_s3_bucket.tfstate_backends.arn}\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\"s3:GetObject\", \"s3:PutObject\"],\n      \"Resource\": \"${aws_s3_bucket.tfstate_backends.arn}/${each.key}/*\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"dynamodb:GetItem\",\n        \"dynamodb:PutItem\",\n        \"dynamodb:DeleteItem\"\n      ],\n      \"Resource\": \"${aws_dynamodb_table.stack_tfstate_backends_lock[each.key].arn}\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:ListKeys\"\n      ],\n      \"Resource\": \"*\"\n    },\n    {\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"kms:Encrypt\",\n        \"kms:Decrypt\",\n        \"kms:DescribeKey\",\n        \"kms:GenerateDataKey\"\n      ],\n      \"Resource\": \"${aws_kms_key.tfstate_backends.arn}\"\n    }\n  ]\n}"
    }
   }
  },
  {
   "id": "__declared__.local_file.stack_backends",
   "cfg": "local_file.stack_backends",
   "type": "__declared__",
   "refs": [
    "aws_dynamodb_table.stack_tfstate_backends_lock",
    "aws_s3_bucket.tfstate_backends"
   ],
   "values": {
    "type": "local_file",
    "name": "stack_backends",
    "gated": true,
    "gate": "local.stacks_info",
    "properties": {
     "for_each": "${local.stacks_info}",
     "filename": "../eks-stacks/${each.key}/backend.tf",
     "file_permission": "0644",
     "content": "terraform {\n  backend \"s3\" {\n    bucket = \"${aws_s3_bucket.tfstate_backends.id}\"\n    region = \"us-east-1\"\n    encrypt = true\n\n    dynamodb_table = \"${aws_dynamodb_table.stack_tfstate_backends_lock[each.key].id}\"\n    key = \"${each.key}/cluster.tfstate\"\n  }\n}"
    }
   }
  },
