   "id": "__declared__.aws_synthetics_canary.dynamic_canaries_with_vpc",
   "cfg": "aws_synthetics_canary.dynamic_canaries_with_vpc",
   "type": "__declared__",
   "refs": [
    "aws_s3_bucket.artifcats_bucket",
    "data.aws_iam_role.execution_role"
   ],
   "values": {
    "type": "aws_synthetics_canary",
    "name": "dynamic_canaries_with_vpc",
    "gated": true,
    "gate": "local.canaries_with_vpc",
    "properties": {
     "for_each": "${local.canaries_with_vpc}",
     "name": "${each.value.name}",
     "artifact_s3_location": "s3://${aws_s3_bucket.artifcats_bucket.id}/",
     "execution_role_arn": "${data.aws_iam_role.execution_role.arn}",
     "handler": "${each.value.handler}",
     "runtime_version": "${each.value.runtime_version}",
     "start_canary": "${each.value.start_canary}",
     "failure_retention_period": "${each.value.failure_retention_period}",
     "success_retention_period": "${each.value.success_retention_period}",
     "schedule": [
      {
       "expression": "${each.value.schedule_expression}"
      }
     ],
     "vpc_config": [
      {
       "subnet_ids": [
        ""
       ],
       "security_group_ids": [
        ""
       ]
      }
     ],
