  {
   "id": "role",
   "tier": "core",
   "kind": "exists",
   "select": {
    "types": [
     "aws_iam_role"
    ],
    "where": []
   },
   "quote": "creates a custom cross-account IAM role and policy integration"
  },
  {
   "id": "role_name",
   "tier": "core",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_iam_role"
      ],
      "where": []
     },
     "cond": {
      "path": [
       "name"
      ],
      "op": "eq",
      "value": "WizAccess-Role"
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": [
         "type"
        ],
        "op": "eq",
        "value": "aws_iam_role"
       }
      ]
     },
     "cond": {
      "path": [
       "properties",
       "name"
      ],
      "op": "contains",
      "value": "WizAccess-Role"
     }
    }
   ],
   "quote": "whose name is configurable via a rolename variable defaulting to \"WizAccess-Role\""
  },
  {
   "id": "var_rolename",
   "tier": "detail",
   "kind": "attr",
