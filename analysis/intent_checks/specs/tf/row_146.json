  {
   "id": "ecr_sg_egress_vpc_only",
   "kind": "any_of",
   "tier": "core",
   "checks": [
    {
     "kind": "attr",
     "select": "sg",
     "cond": {
      "path": "egress.*.cidr_blocks.*",
      "op": "eq",
      "value": "10.0.0.0/16",
      "every": true
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_security_group_rule"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "egress"
       }
      ]
     },
     "quantifier": "all",
     "cond": {
      "path": "cidr_blocks.*",
      "op": "eq",
      "value": "10.0.0.0/16",
      "every": true
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_vpc_security_group_egress_rule"
      ]
     },
     "quantifier": "all",
     "cond": {
      "path": "cidr_ipv4",
      "op": "eq",
      "value": "10.0.0.0/16"
     }
    }
   ],
   "quote": "an ECR security group that allows egress only within the VPC CIDR",
   "justify": "egress only within the VPC CIDR: every egress destination is the vpc_cidr default 10.0.0.0/16"
