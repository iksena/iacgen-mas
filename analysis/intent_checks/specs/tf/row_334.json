  {
   "id": "scoped_to_group",
   "tier": "core",
   "kind": "any_of",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_iam_policy",
         "aws_iam_role_policy",
         "aws_iam_user_policy",
         "aws_iam_group_policy"
        ]
       },
       {
        "path": "properties.policy",
        "op": "regex",
        "value": "^(?s)(?:[^'\"]|['\"]+(?:[^'\"*]|\\*[^'\"]))*(?:['\"]+\\*?)?$"
       }
      ]
     },
     "to": {
      "types": [
       "aws_cloudwatch_log_group"
      ]
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_iam_policy_document"
       },
       {
        "path": "properties.statement.*.resources.*",
        "op": "none_eq",
        "value": "*"
       }
      ]
     },
     "to": {
      "types": [
       "aws_cloudwatch_log_group"
      ]
     }
    }
   ],
   "quote": "only on that log group"
  },
