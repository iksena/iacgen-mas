  {
   "id": "policy_allow",
   "kind": "any_of",
   "tier": "core",
   "quote": "explicitly allows all Elastic File System actions for any AWS principal",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_efs_file_system_policy"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "regex",
      "value": "(?is)\"Action\":\\[?(\"[^\"]*\",)*\"(elasticfilesystem:\\*|\\*)\"(,\"[^\"]*\")*\\]?,(?:\"Condition\":\\{(?:[^{}]|\\{[^{}]*\\})*\\},)?\"Effect\":\"Allow\",\"Principal\":(\\{\"AWS\":\\[?)?\"\\*\""
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_efs_file_system_policy"
       }
      ]
     },
     "cond": {
      "path": "properties.policy",
      "op": "regex",
      "value": "(?is)(?:[\"']action[\"']\\s*:\\s*\\[?\\s*[\"'](elasticfilesystem:\\*|\\*)[\"'][^{}]{0,40}?\\}?(?:[^{}]|\\{[^{}]*\\}){0,300}[\"']principal[\"']\\s*:\\s*(\\{\\s*[\"']aws[\"']\\s*:\\s*)?\\[?\\s*[\"']\\*[\"']|[\"']principal[\"']\\s*:\\s*(\\{\\s*[\"']aws[\"']\\s*:\\s*)?\\[?\\s*[\"']\\*[\"'][^{}]{0,40}?\\}?(?:[^{}]|\\{[^{}]*\\}){0,300}[\"']action[\"']\\s*:\\s*\\[?\\s*[\"'](elasticfilesystem:\\*|\\*)[\"'])"
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_efs_file_system_policy"
      ]
     },
     "to": {
      "types": [
       "data.aws_iam_policy_document"
      ],
      "where": [
       {
        "path": "statement.*",
        "op": "match",
        "value": [
         {
          "path": "effect",
          "op": "eq",
          "value": "Allow"
         },
         {
          "path": "actions.*",
          "op": "in",
          "value": [
           "elasticfilesystem:*",
           "*"
          ]
         },
         {
          "path": "principals.*.identifiers.*",
          "op": "eq",
          "value": "*"
         }
        ]
       }
      ]
     }
    }
   ]
