    {
      "id": "codebuild_artifact_bucket",
      "tier": "core",
      "quote": "specific CodePipeline S3 bucket artifact access in us-east-1",
      "justify": "CodePipeline artifact buckets in us-east-1 are named codepipeline-us-east-1-*; a pipeline artifact bucket the template creates (in its us-east-1 provider) also counts",
      "kind": "any_of",
      "checks": [
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
                "value": [
                  "aws_iam_role",
                  "aws_iam_role_policy",
                  "aws_iam_policy",
                  "data.aws_iam_policy_document"
                ]
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "(?i)codepipeline-([^'\\\"\\s]*us-east-1|\\$\\{[^}]*region)"
              }
            ]
          }
        },
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
                "value": [
                  "aws_iam_role",
                  "aws_iam_role_policy",
                  "aws_iam_policy",
                  "data.aws_iam_policy_document"
                ]
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "(?i)us-east-1[^'\\\"\\s]*codepipeline"
              }
            ]
          }
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
                "value": [
                  "aws_iam_role",
                  "aws_iam_role_policy",
                  "aws_iam_policy",
                  "data.aws_iam_policy_document"
                ]
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "(?i)s3:(GetObject|PutObject|\\*)"
              }
            ]
          },
          "to": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_s3_bucket"
              },
              {
                "path": "properties.bucket",
                "op": "regex",
                "value": "(?i)codepipeline"
              }
            ]
          }
        }
      ]
    },
