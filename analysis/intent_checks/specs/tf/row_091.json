  "gt": "484e3cb225e15fd6154e85ee7114c35150a034a1038d7cea045adf438d1d1e42",
  "prompt": "3ae3de7d3ff2b618fa1389b08526a9538e67fd2e099c063cf87f936d8d8d043a"
 },
 "selectors": {
  "vpc": {
   "types": [
    "aws_vpc"
   ],
   "where": [
    {
     "path": "cidr_block",
     "op": "eq",
     "value": "10.0.0.0/16"
    }
   ]
  },
  "subnet_a": {
   "types": [
    "aws_subnet"
   ],
   "where": [
    {
     "path": "cidr_block",
     "op": "eq",
     "value": "10.0.1.0/24"
    }
   ]
  },
  "subnet_b": {
   "types": [
    "aws_subnet"
   ],
   "where": [
    {
     "path": "cidr_block",
     "op": "eq",
     "value": "10.0.2.0/24"
    }
   ]
  },
  "subnet_c": {
   "types": [
    "aws_subnet"
   ],
   "where": [
    {
     "path": "cidr_block",
     "op": "eq",
     "value": "10.0.3.0/24"
    }
   ]
  },
  "subnets": {
   "types": [
    "aws_subnet"
   ]
  },
  "igw": {
   "types": [
    "aws_internet_gateway"
   ]
  },
  "public_rt": {
   "types": [
    "aws_route_table"
   ],
   "where": [
    {
     "path": "route.*.cidr_block",
     "op": "eq",
     "value": "0.0.0.0/0"
    }
   ]
  },
  "any_rt": {
   "types": [
    "aws_route_table"
   ]
  },
  "nat": {
   "types": [
    "aws_nat_gateway"
   ]
  },
  "eip": {
   "types": [
    "aws_eip"
   ],
   "where": [
