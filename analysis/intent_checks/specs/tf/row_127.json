  {
   "id": "sg_egress_all",
   "kind": "any_of",
   "tier": "core",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_security_group_rule"
       },
       {
        "path": "properties.type",
        "op": "eq",
        "value": "egress"
       },
       {
        "path": "properties.cidr_blocks.*",
        "op": "eq",
        "value": "0.0.0.0/0"
       },
       {
        "path": "properties.protocol",
        "op": "in",
        "value": [
         "-1",
         "all"
        ]
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
