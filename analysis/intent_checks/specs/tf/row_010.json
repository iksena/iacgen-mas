   },
   "quote": "an IAM role named \"ecsTaskExecutionRole\""
  },
  {
   "id": "role_assumed_by_ecs",
   "kind": "any_of",
   "tier": "core",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_iam_role"
      ],
      "where": [
       {
        "path": "name",
        "op": "eq",
        "value": "ecsTaskExecutionRole"
       }
      ]
     },
     "cond": {
      "path": "assume_role_policy",
      "op": "regex",
      "value": "(?s)\"Action\":\\[?(\"[^\"]*\",)*\"sts:(AssumeRole|\\*)\"(,\"[^\"]*\")*\\]?,(?:\"Condition\":\\{(?:[^{}]|\\{[^{}]*\\})*\\},)?\"Effect\":\"Allow\",\"Principal\":\\{(?:\"AWS\":(?:\"[^\"]*\"|\\[[^\\]]*\\]),)?\"Service\":\\[?(\"[^\"]*\",)*\"ecs-tasks\\.amazonaws\\.com\""
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_iam_role"
      ],
      "where": [
       {
        "path": "name",
        "op": "eq",
        "value": "ecsTaskExecutionRole"
       }
      ]
     },
     "to": {
      "types": [
       "data.aws_iam_policy_document"
      ],
      "where": [
       {
        "path": "statement.*",
        "op": "match",
        "value": [
         {
          "path": "effect",
          "op": "eq",
          "value": "Allow"
         },
         {
          "path": "actions.*",
          "op": "glob_covers",
          "value": "sts:AssumeRole"
         },
         {
          "path": "principals.*.identifiers.*",
          "op": "eq",
          "value": "ecs-tasks.amazonaws.com"
         }
        ]
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_iam_role"
       },
       {
        "path": "properties.name",
        "op": "eq",
        "value": "ecsTaskExecutionRole"
       }
      ]
     },
     "cond": {
      "path": "properties.assume_role_policy",
      "op": "regex",
      "value": "(?i)ecs-tasks\\.amazonaws\\.com"
     }
    }
   ],
   "quote": "allows ECS tasks to assume it"
