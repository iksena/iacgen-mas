  {
   "id": "role_named",
   "kind": "exists",
   "tier": "core",
   "select": {
    "types": [
     "aws_iam_role"
    ],
    "where": [
     {
      "path": "name",
      "op": "eq",
      "value": "ecsTaskExecutionRole"
