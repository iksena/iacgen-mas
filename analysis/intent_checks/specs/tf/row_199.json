          "cond": {
            "path": "custom_error_response.*",
            "op": "match",
            "value": [
              {
                "path": "error_code",
                "op": "eq",
                "value": 403
              },
              {
                "path": "response_code",
                "op": "eq",
                "value": 404
              }
            ]
