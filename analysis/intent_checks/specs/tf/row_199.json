                "value": "aws_cloudfront_distribution"
              }
            ]
          },
          "cond": {
            "path": "properties",
            "op": "regex",
            "value": "(?is)error_code[^0-9]{1,8}403[^0-9].{0,200}response_code[^0-9]{1,8}404"
          }
        }
      ],
      "quote": "mapping HTTP 403 and 404 error codes to a 404 response code"
