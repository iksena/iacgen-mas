  {
   "id": "latest_al2_ami",
   "kind": "any_of",
   "tier": "core",
   "quote": "using the latest Amazon Linux 2 AMI",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_instance"
      ]
     },
     "to": {
      "types": [
       "__declared__"
      ],
      "where": [
