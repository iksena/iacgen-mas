    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_instance"
       }
      ]
     },
     "cond": {
      "path": "properties.ami",
      "op": "regex",
      "value": "(?i)ami-amazon-linux-latest/amzn2-ami"
     }
    }
   ],
   "justify": "latest AL2: a most_recent AMI lookup filtered on the amzn2-ami name, or the public SSM 'ami-amazon-linux-latest/amzn2-ami' parameter, used by the instance"
