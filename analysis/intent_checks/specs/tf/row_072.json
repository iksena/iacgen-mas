     "to": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_ssm_parameter"
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "(?i)ami-amazon-linux-latest/amzn2-ami"
       }
      ]
     }
