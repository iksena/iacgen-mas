          "kind": "ref",
          "from": "pl_d",
          "to": "cb_d"
        },
        {
          "kind": "attr",
          "select": "pl",
          "cond": {
            "path": "stage.*.action.*.provider",
            "op": "eq",
            "value": "CodeBuild"
          }
        }
      ],
      "quote": "hand it to the build stage"
    },
    {
      "id": "pl_artifact_bucket",
      "tier": "detail",
      "kind": "ref",
      "from": "pl",
      "to": "buckets",
      "quote": "a separate pipeline artifact bucket"
    },
    {
      "id": "branch_default_master",
      "tier": "detail",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
              "__parameter__"
            ],
            "where": []
          },
          "cond": {
            "path": "default",
            "op": "eq",
            "value": "master"
          }
        },
        {
          "kind": "attr",
          "select": "pl_d",
          "cond": {
            "path": "properties.stage",
            "op": "contains",
            "value": "master"
          }
        },
        {
          "kind": "attr",
          "select": "pl",
          "cond": {
            "path": "stage.*.action.*.configuration.Branch",
            "op": "eq",
            "value": "master"
          }
        }
      ],
      "quote": "(defaulting to \"master\")"
    },
    {
      "id": "ssm_secure_strings",
      "tier": "core",
      "kind": "exists",
      "select": "ssm",
      "min": 2,
      "quote": "a GitHub OAuth token and a webhook secret stored as SecureString SSM parameters that the template creates with placeholder values",
      "justify": "token and secret = two parameters"
    },
    {
      "id": "github_webhook",
      "tier": "core",
      "kind": "exists",
      "select": "hook",
      "quote": "together with a GitHub webhook"
    },
    {
      "id": "webhook_hmac",
      "tier": "core",
      "kind": "attr",
      "select": "hook",
      "cond": {
        "path": "authentication",
        "op": "regex",
        "value": "(?i)HMAC"
      },
      "quote": "that authenticates with HMAC"
    },
    {
      "id": "webhook_push_branch",
      "tier": "core",
      "kind": "attr",
      "select": "hook",
      "cond": {
        "path": "filter.*",
        "op": "match",
        "value": [
          {
            "path": "json_path",
            "op": "regex",
            "value": "\\$\\.ref"
          },
          {
            "path": "match_equals",
            "op": "regex",
            "value": "refs/heads/"
          }
        ]
      },
      "quote": "triggers only on pushes to that branch",
      "justify": "a push to a branch is the refs/heads/<branch> ref"
    },
    {
      "id": "webhook_targets_pipeline",
      "tier": "detail",
      "kind": "ref",
      "from": "hook",
      "to": "pl",
      "quote": "a GitHub webhook"
    },
    {
      "id": "codestar_alternative",
      "tier": "detail",
      "kind": "attr",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_codepipeline"
            ]
          }
        ]
      },
      "cond": {
        "path": "properties.stage",
        "op": "regex",
        "value": "(?i)(codestarsourceconnection|ConnectionArn)"
      },
      "quote": "a CodeStar connection can be used instead when its ARN is supplied",
      "justify": "a CodeStar connection source action is the CodeStarSourceConnection provider"
    },
    {
      "id": "optional_notifications_declared",
      "tier": "detail",
      "kind": "exists",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_codestarnotifications_notification_rule",
              "aws_sns_topic",
              "aws_cloudwatch_event_rule"
            ]
          },
          {
            "path": "gated",
            "op": "truthy"
          }
        ]
      },
      "quote": "Optional pipeline notifications to an SNS topic"
    },
    {
      "id": "optional_access_logging_declared",
      "tier": "detail",
      "kind": "any_of",
      "checks": [
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_s3_bucket_logging"
              },
              {
                "path": "gated",
                "op": "truthy"
              }
            ]
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_s3_bucket"
              }
            ]
          },
          "cond": {
            "path": "properties.logging",
            "op": "present"
          }
        }
      ],
      "quote": "optional access logging for the artifact bucket"
    },
    {
      "id": "x_cb_source",
      "kind": "attr",
      "select": "cb",
      "cond": {
        "path": "source.*.type",
        "op": "eq",
        "value": "CODEPIPELINE"
      },
      "tier": "extra"
    },
    {
      "id": "x_cb_not_privileged",
      "kind": "attr",
      "select": "cb",
      "cond": {
        "path": "environment.*.privileged_mode",
        "op": "falsy"
      },
      "tier": "extra"
    },
    {
      "id": "x_pl_store",
      "kind": "attr",
      "select": "pl",
      "cond": {
        "path": "artifact_store.*.type",
        "op": "eq",
        "value": "S3"
      },
      "tier": "extra"
    },
    {
      "id": "extra_type_aws_iam_policy_attachment",
      "kind": "exists",
      "tier": "extra",
      "select": {
        "types": [
          "aws_iam_policy_attachment"
        ],
        "where": []
      }
    },
    {
      "id": "extra_type_aws_iam_role_policy_attachment",
      "kind": "exists",
      "tier": "extra",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "eq",
            "value": "aws_iam_role_policy_attachment"
          }
        ]
      }
    }
  ],
  "notes": "Account-ID suffix on bucket names is not checked beyond the prefix. 'Defaulting to us-east-1' is not checked: the adapter plans every resource in us-east-1, so the region is not observable as a template choice. Optional notifications/access logging are checked as declared and gated (count/for_each); 'off by default' beyond that cannot be expressed (exists needs min>=1). The CodeBuild role's S3/KMS/SSM grants are bound to the policy document that also allows CloudFront invalidation (the CodePipeline role also grants S3/KMS), so a split of the CodeBuild permissions over several policies fails them; scoping to the two buckets themselves is not checked. The TLS-deny policy and the pipeline role are not bound to the artifact bucket / a distinct role (no chained selectors). Environment-variable names, placeholder values and policy resource scoping are not pinned. Candidate review: DSV4F names the target bucket only through a local, which is not observable, so target_bucket fails it; DSV4F also has no CodeStar connection alternative."
}
