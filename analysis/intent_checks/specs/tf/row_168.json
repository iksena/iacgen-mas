   "id": "ssl_only_deny",
   "kind": "any_of",
   "tier": "core",
   "quote": "an enforced SSL-only access policy (denying s3:* requests when \"aws:SecureTransport\" is false)",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "data.aws_iam_policy_document"
      ]
     },
     "cond": {
      "path": "statement.*",
      "op": "match",
      "value": [
       {
        "path": "effect",
        "op": "eq",
        "value": "Deny"
       },
       {
        "path": "condition.*.variable",
        "op": "eq",
        "value": "aws:SecureTransport"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_s3_bucket_policy"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "regex",
      "value": "(?is)deny.{0,600}?aws:SecureTransport|aws:SecureTransport.{0,600}?deny"
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_s3_bucket_policy",
         "data.aws_iam_policy_document"
        ]
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "(?is)deny.{0,600}?aws:SecureTransport|aws:SecureTransport.{0,600}?deny"
