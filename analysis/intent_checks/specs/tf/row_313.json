  {
   "id": "bucket_policy_cloudtrail_write",
   "tier": "core",
   "quote": "grants CloudTrail the permissions it needs to write logs",
   "kind": "any_of",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_s3_bucket_policy",
         "data.aws_iam_policy_document"
        ]
