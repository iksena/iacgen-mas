   "kind": "any_of",
   "tier": "detail",
   "checks": [
    {
     "kind": "attr",
     "select": "bas",
     "cond": {
      "path": "ingress.*.cidr_blocks.*",
      "op": "eq",
      "value": "10.32.0.0/20",
      "every": true
     }
    },
    {
     "kind": "attr",
     "select": "bas",
     "cond": {
      "path": "ingress.*.cidr_blocks.*",
      "op": "none_eq",
      "value": "0.0.0.0/0"
     }
    }
   ],
   "quote": "only from within the VPC CIDR block"
