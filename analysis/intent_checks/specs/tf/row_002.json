      "op": "present"
     }
    }
   ]
  },
  {
   "id": "policy_all_actions",
   "kind": "any_of",
   "tier": "core",
   "quote": "allows all actions from any AWS principal",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_kms_key",
       "aws_kms_key_policy"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "regex",
      "value": "(?s)\"Action\":\\[?\"(kms:)?\\*\"\\]?,\"Effect\":\"Allow\",\"Principal\":(\\{\"AWS\":\\[?)?\"\\*\""
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_kms_key",
         "aws_kms_key_policy"
        ]
       }
      ]
     },
     "cond": {
      "path": "properties.policy",
      "op": "regex",
      "value": "(?is)'action':\\s*\\[?\\s*'(kms:)?\\*'[^{}]{0,40}?\\}?(?:[^{}]|\\{[^{}]*\\}){0,300}'principal':\\s*(\\{\\s*'aws':\\s*)?\\[?\\s*'\\*'|'principal':\\s*(\\{\\s*'aws':\\s*)?\\[?\\s*'\\*'[^{}]{0,40}?\\}?(?:[^{}]|\\{[^{}]*\\}){0,300}'action':\\s*\\[?\\s*'(kms:)?\\*'"
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_kms_key",
       "aws_kms_key_policy"
      ]
     },
     "to": {
      "types": [
       "data.aws_iam_policy_document"
      ],
      "where": [
       {
        "path": "statement.*",
        "op": "match",
        "value": [
         {
          "path": "effect",
          "op": "eq",
          "value": "Allow"
         },
         {
          "path": "actions.*",
          "op": "in",
          "value": [
           "*",
           "kms:*"
          ]
         },
         {
          "path": "principals.*.identifiers.*",
          "op": "eq",
          "value": "*"
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "id": "policy_any_principal",
   "kind": "any_of",
   "tier": "core",
   "quote": "allows all actions from any AWS principal",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_kms_key",
       "aws_kms_key_policy"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "regex",
      "value": "(?s)\"Effect\":\"Allow\",(?:\"NotAction\"[^]]*\\],)?\"Principal\":(\\{\"AWS\":\\[?)?\"\\*\""
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_kms_key",
         "aws_kms_key_policy"
        ]
       }
      ]
     },
     "cond": {
      "path": "properties.policy",
      "op": "regex",
      "value": "(?is)'principal':\\s*(\\{\\s*'aws':\\s*)?\\[?\\s*'\\*'"
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_kms_key",
       "aws_kms_key_policy"
      ]
     },
     "to": {
      "types": [
       "data.aws_iam_policy_document"
      ],
      "where": [
       {
        "path": "statement.*",
        "op": "match",
        "value": [
         {
          "path": "effect",
          "op": "eq",
          "value": "Allow"
         },
         {
          "path": "principals.*.identifiers.*",
          "op": "eq",
          "value": "*"
         }
        ]
       }
      ]
     }
    }
   ]
  },
  {
   "id": "alias_exists",
   "kind": "ref",
   "tier": "core",
   "quote": "assign the key an alias of \"alias/bar\"",
   "from": {
    "types": [
     "aws_kms_alias"
    ],
    "where": [
     {
      "path": "name",
      "op": "eq",
      "value": "alias/bar"
     }
    ]
   },
   "to": {
    "types": [
     "aws_kms_key"
    ]
   }
  }
 ],
 "notes": "Policy forms: planned JSON (aws_kms_key.policy or aws_kms_key_policy; the provider normalises keys alphabetically, so Action/Effect/Principal of one statement are adjacent), declared jsonencode text, or a policy document referenced by the key. policy_all_actions binds Allow + all actions + any principal to one statement (declared text: '*' Action and '*' Principal within one statement's text); policy_any_principal binds Allow + '*' principal. 'explicitly disabled' rotation: planned false and the attribute set in the template."
}