  {
   "id": "sg_ssh_only",
   "tier": "core",
   "kind": "any_of",
   "quote": "allows SSH only from within the VPC CIDR",
   "justify": "within the VPC CIDR is the stated VPC CIDR 10.0.0.0/16; every ingress rule covering port 22 must use only it",
   "checks": [
