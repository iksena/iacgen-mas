      "value": "^\\{[^{}]*(\"cidr_ipv4\": (null|\"10\\.0\\.0\\.0/16\"), \"cidr_ipv6\": null|\"from_port\": (2[3-9]|[3-9][0-9]|[1-9][0-9]{2,}),[^{}]*\"ip_protocol\": \"(tcp|udp|icmp|icmpv6|6|17|1|58)\"|\"ip_protocol\": \"(tcp|udp|icmp|icmpv6|6|17|1|58)\"[^{}]*\"to_port\": (-1|[0-9]|1[0-9]|2[01])[,}])[^{}]*\\}$"
