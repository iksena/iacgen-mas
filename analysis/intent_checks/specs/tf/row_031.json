  {
   "id": "policy_s3_all",
   "tier": "core",
   "quote": "grants full S3 access (\"s3:*\") to a specified AWS account ID",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "data.aws_iam_policy_document"
      ]
     },
     "cond": {
      "path": "statement.*",
      "op": "match",
      "value": [
       {
        "path": "actions.*",
        "op": "eq",
        "value": "s3:*"
       },
       {
        "path": "principals.*.identifiers.*",
        "op": "regex",
        "value": "566373416292"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_iam_policy_document"
       }
      ]
     },
     "cond": {
      "path": "properties.statement.*",
      "op": "match",
      "value": [
       {
        "path": "actions.*",
        "op": "eq",
        "value": "s3:*"
       },
       {
        "path": "principals.*.identifiers.*",
        "op": "regex",
        "value": "566373416292|\\$\\{var\\."
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_s3_bucket_policy"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "match",
      "value": [
       {
        "path": "",
        "op": "contains",
        "value": "s3:*"
       },
       {
        "path": "",
        "op": "regex",
        "value": "566373416292"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_s3_bucket_policy"
       }
      ]
     },
     "cond": {
      "path": "properties.policy",
      "op": "match",
      "value": [
       {
        "path": "",
        "op": "contains",
        "value": "s3:*"
       },
       {
        "path": "",
        "op": "regex",
        "value": "566373416292|\\$\\{var\\."
       }
      ]
     }
    }
   ]
