            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "egress"
              }
            ]
          },
          "to": {
            "types": [
              "aws_vpc",
              "data.aws_vpc"
            ]
          }
        },
        {
          "kind": "join",
          "from": "sg",
