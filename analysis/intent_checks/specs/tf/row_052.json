    {
      "id": "ssh_inbound",
      "tier": "core",
      "quote": "allows inbound SSH",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "sg",
          "cond": {
            "path": "ingress.*",
            "op": "match",
            "value": [
              {
                "path": "",
                "op": "port_covers",
                "value": 22
              },
              {
                "path": "protocol",
                "op": "in",
                "value": [
                  "tcp",
                  "6"
                ]
              }
            ]
          }
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "aws_security_group_rule"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "ingress"
              },
              {
                "path": "",
                "op": "port_covers",
                "value": 22
              },
              {
                "path": "protocol",
                "op": "in",
                "value": [
                  "tcp",
                  "6"
                ]
              }
            ]
          },
          "to": "sg"
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "aws_vpc_security_group_ingress_rule"
            ],
            "where": [
              {
                "path": "",
                "op": "port_covers",
                "value": 22
              },
              {
                "path": "ip_protocol",
                "op": "in",
                "value": [
                  "tcp",
                  "6"
                ]
              }
            ]
          },
          "to": "sg"
        }
      ],
      "justify": "SSH implies TCP port 22"
    },
    {
      "id": "egress_only_vpc",
      "tier": "core",
      "quote": "outbound traffic only within the VPC CIDR",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_vpc_security_group_egress_rule"
              }
            ]
          },
          "quantifier": "all",
          "cond": {
            "path": "properties.cidr_ipv4",
            "op": "regex",
            "value": "^\\$\\{|/([1-9]|[12][0-9]|3[0-2])$",
            "every": true
          }
        },
        {
          "kind": "attr",
          "select": "sg",
          "cond": {
            "path": "egress.*.cidr_blocks.*",
            "op": "regex",
            "value": "/([1-9]|[12][0-9]|3[0-2])$",
            "every": true
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_security_group"
              }
            ]
          },
          "cond": {
            "path": "properties.egress.*.cidr_blocks.*",
            "op": "regex",
            "value": "^\\$\\{|/([1-9]|[12][0-9]|3[0-2])$",
            "every": true
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "aws_security_group_rule"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "egress"
              }
            ]
          },
          "quantifier": "all",
          "cond": {
            "path": "cidr_blocks.*",
            "op": "regex",
            "value": "/([1-9]|[12][0-9]|3[0-2])$",
            "every": true
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_security_group_rule"
              },
              {
                "path": "properties.type",
                "op": "eq",
                "value": "egress"
              }
            ]
          },
          "quantifier": "all",
          "cond": {
            "path": "properties.cidr_blocks.*",
            "op": "regex",
            "value": "^\\$\\{|/([1-9]|[12][0-9]|3[0-2])$",
            "every": true
          }
        }
      ],
      "justify": "anywhere (a /0 range) is outside the VPC CIDR"
    },
    {
      "id": "egress_vpc_cidr",
      "tier": "core",
      "quote": "outbound traffic only within the VPC CIDR",
      "kind": "any_of",
      "checks": [
        {
          "kind": "ref",
          "from": {
            "types": [
              "aws_vpc_security_group_egress_rule"
            ]
          },
          "to": {
            "types": [
