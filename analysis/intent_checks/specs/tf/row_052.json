          "from_path": "cidr_ipv4",
          "to": {
            "types": [
              "aws_vpc"
            ]
          },
          "to_path": "cidr_block"
        },
        {
          "kind": "join",
          "from": {
            "types": [
              "aws_security_group_rule"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "egress"
              }
            ]
          },
          "from_path": "cidr_blocks.*",
          "to": {
            "types": [
              "aws_vpc"
            ]
          },
          "to_path": "cidr_block"
        }
