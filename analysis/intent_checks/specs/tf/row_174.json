              "aws_iam_role_policy_attachment"
            ]
          },
          "to": {
            "types": [
              "aws_iam_policy"
            ],
            "where": [
              {
                "path": "policy",
                "op": "contains",
                "value": "codecommit:"
              },
              {
                "path": "policy",
                "op": "contains",
                "value": "codebuild:"
              },
              {
                "path": "policy",
                "op": "contains",
                "value": "ecr:"
              }
            ]
          }
        },
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
