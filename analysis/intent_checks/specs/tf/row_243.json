  {
   "id": "sg_ingress_https",
   "tier": "core",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_security_group"
      ]
     },
     "cond": {
      "path": "ingress.*",
      "op": "match",
      "value": [
       {
        "path": "",
        "op": "port_covers",
        "value": 443
       },
       {
        "path": "cidr_blocks.*",
        "op": "eq",
        "value": "10.0.0.0/16"
       },
       {
        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "aws_security_group_rule"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "ingress"
       },
       {
        "path": "",
        "op": "port_covers",
        "value": 443
       },
       {
        "path": "cidr_blocks.*",
        "op": "eq",
        "value": "10.0.0.0/16"
       },
       {
        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "aws_vpc_security_group_ingress_rule"
      ],
      "where": [
       {
        "path": "",
        "op": "port_covers",
        "value": 443
       },
       {
        "path": "cidr_ipv4",
        "op": "eq",
        "value": "10.0.0.0/16"
       },
       {
        "path": "ip_protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       }
      ]
     }
    }
   ],
   "quote": "permits inbound HTTPS port 443 traffic from the VPC CIDR",
   "justify": "HTTPS implies 443/tcp"
  },
  {
   "id": "sg_egress_vpc",
   "tier": "core",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_security_group"
      ],
      "where": [
       {
        "path": "ingress.*",
        "op": "match",
        "value": [
         {
          "path": "",
          "op": "port_covers",
          "value": 443
         },
         {
