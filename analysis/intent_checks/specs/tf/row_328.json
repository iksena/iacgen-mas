  "checks": [
    {
      "id": "vpc_exists",
      "kind": "exists",
      "tier": "core",
      "quote": "provisions a single VPC",
      "select": "vpc",
      "min": 1,
      "max": 1,
      "justify": "\"a single VPC\" means exactly one"
    },
    {
      "id": "vpc_name_main",
      "kind": "any_of",
      "tier": "core",
      "quote": "named \"main\"",
      "checks": [
        {
          "kind": "attr",
          "select": "vpc",
          "cond": {
            "path": "tags.Name",
            "op": "eq",
            "value": "main"
          }
        },
        {
          "kind": "attr",
          "select": "vpc",
          "cond": {
            "path": "tags_all.Name",
            "op": "eq",
            "value": "main"
          }
        }
      ]
    },
    {
      "id": "vpc_cidr",
      "kind": "attr",
      "tier": "core",
      "quote": "the CIDR block 10.0.0.0/16",
      "select": "vpc",
      "cond": {
        "path": "cidr_block",
        "op": "eq",
        "value": "10.0.0.0/16"
      }
    },
    {
      "id": "vpc_tenancy_default",
      "kind": "attr",
      "tier": "core",
      "quote": "default instance tenancy",
      "select": "vpc",
      "cond": {
        "path": "instance_tenancy",
        "op": "eq",
        "value": "default"
      }
    },
    {
      "id": "vpc_dns_support",
      "kind": "attr",
      "tier": "core",
      "quote": "DNS support enabled",
      "select": "vpc",
      "cond": {
        "path": "enable_dns_support",
        "op": "eq",
        "value": true
      }
    },
    {
      "id": "vpc_dns_hostnames_off",
      "kind": "attr",
      "tier": "core",
      "quote": "DNS hostnames disabled",
      "select": "vpc",
      "cond": {
        "path": "enable_dns_hostnames",
        "op": "none_eq",
        "value": true
      }
    },
    {
      "id": "vpc_no_ipv6",
      "kind": "attr",
      "tier": "core",
      "quote": "no IPv6 CIDR block",
      "select": "vpc",
      "cond": {
        "path": "assign_generated_ipv6_cidr_block",
        "op": "none_eq",
        "value": true
      }
    },
    {
      "id": "subnets_declared",
      "kind": "all_of",
      "tier": "core",
      "quote": "accept an optional list of subnet definitions",
      "checks": [
        {
          "kind": "exists",
          "select": "decl_subnet"
        },
        {
          "kind": "attr",
          "select": "decl_subnet",
          "cond": {
            "path": "properties.cidr_block",
            "op": "present"
          }
        },
        {
          "kind": "attr",
          "select": "decl_subnet",
          "cond": {
            "path": "properties",
            "op": "regex",
            "value": "(?i)availability_zone"
          }
        }
      ]
    },
    {
      "id": "intra_class_supported",
      "kind": "attr",
      "tier": "detail",
      "quote": "class (public, private, or intra)",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
