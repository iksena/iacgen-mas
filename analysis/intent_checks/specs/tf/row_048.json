      ]
    },
    {
      "id": "managed_policies_supported",
      "tier": "core",
      "quote": "support for attaching a configurable set of inline and managed IAM policies",
      "kind": "any_of",
      "checks": [
        {
          "kind": "ref",
          "from": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
                "value": [
                  "aws_iam_role_policy_attachment",
                  "aws_iam_policy_attachment",
                  "aws_iam_role_policy_attachments_exclusive"
                ]
              }
            ]
          },
          "to": "role"
        },
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
                "value": [
                  "aws_iam_role"
                ]
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "managed_policy_arns"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "policies_configurable",
      "tier": "detail",
      "quote": "a configurable set of inline and managed IAM policies",
      "kind": "any_of",
      "checks": [
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
