                  "aws_iam_role_policies_exclusive"
                ]
              }
            ]
          },
          "to": "role"
        },
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "in",
                "value": [
                  "aws_iam_role"
                ]
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "inline_policy"
              }
            ]
          }
