{
  "lang": "tf",
  "row_number": 53,
  "source_hash": {
    "gt": "3d6e429e6d4d30fa3e50f74bf7fb2b7f8489f3696e79b62a3a9acc0c0d0940bd",
    "prompt": "404393339dcece94d45d42d027ce862c75cceb6f83c64620f59354d3463c47ea"
  },
  "selectors": {
    "repo": {
      "types": [
        "aws_ecr_repository"
      ]
    }
  },
  "checks": [
    {
      "id": "ecr_repo",
      "tier": "core",
      "quote": "creates an Amazon ECR repository for container images",
      "kind": "exists",
      "select": "repo"
    },
    {
      "id": "aes256_default",
      "tier": "core",
      "quote": "falling back to AES256 by default",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "repo",
          "cond": {
            "path": "encryption_configuration.*.encryption_type",
            "op": "eq",
            "value": "AES256"
          }
        },
        {
          "kind": "attr",
          "select": "repo",
          "cond": {
            "path": "encryption_configuration.*",
            "op": "absent"
          }
        }
      ]
    },
    {
      "id": "optional_kms",
      "tier": "core",
      "quote": "optional customer-managed KMS encryption",
      "kind": "any_of",
      "checks": [
        {
          "kind": "exists",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_ecr_repository"
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "(?s)encryption_type.{0,120}KMS"
              }
            ]
          }
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_ecr_repository"
              }
            ]
          },
          "to": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_kms_key"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "repo_policy",
      "tier": "core",
      "quote": "an optional repository access policy",
      "kind": "exists",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_ecr_repository_policy"
            ]
          }
        ]
      }
    },
    {
      "id": "repo_policy_on_repo",
      "tier": "detail",
      "quote": "an optional repository access policy",
      "kind": "ref",
      "from": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_ecr_repository_policy"
            ]
          }
        ]
      },
      "to": "repo"
    },
    {
      "id": "repo_policy_pull",
      "tier": "detail",
      "quote": "restricting pull access to specified AWS principals",
      "kind": "exists",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "data.aws_iam_policy_document",
              "aws_ecr_repository_policy"
            ]
          },
          {
            "path": "properties",
            "op": "regex",
            "value": "(?i)(BatchGetImage|GetDownloadUrlForLayer)"
          },
          {
            "path": "properties",
            "op": "regex",
            "value": "(?i)principal"
          }
        ]
      }
    },
    {
      "id": "lifecycle_policy",
      "tier": "core",
      "quote": "an optional lifecycle policy for image cleanup",
      "kind": "exists",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_ecr_lifecycle_policy"
            ]
          }
        ]
      }
    },
    {
      "id": "lifecycle_on_repo",
      "tier": "detail",
      "quote": "an optional lifecycle policy for image cleanup",
      "kind": "ref",
      "from": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_ecr_lifecycle_policy"
            ]
          }
        ]
      },
      "to": "repo"
    },
    {
      "id": "scan_on_push",
      "tier": "extra",
      "kind": "attr",
      "select": "repo",
      "cond": {
        "path": "image_scanning_configuration.*.scan_on_push",
        "op": "eq",
        "value": true
      }
    },
    {
      "id": "immutable_tags",
      "tier": "extra",
      "kind": "attr",
      "select": "repo",
      "cond": {
        "path": "image_tag_mutability",
        "op": "eq",
        "value": "IMMUTABLE"
      }
    },
    {
      "id": "kms_rotation",
      "tier": "extra",
      "kind": "attr",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "in",
            "value": [
              "aws_kms_key"
            ]
          }
        ]
      },
      "cond": {
        "path": "properties.enable_key_rotation",
        "op": "eq",
        "value": true
      }
    },
    {
      "id": "extra_type_aws_kms_alias",
      "kind": "exists",
      "tier": "extra",
      "select": {
        "types": [
          "__declared__"
        ],
        "where": [
          {
            "path": "type",
            "op": "eq",
            "value": "aws_kms_alias"
          }
        ]
      }
    }
  ],
  "notes": "Optional capabilities are checked as declared (count-gated) resources since defaults create only the repository. Optional KMS is accepted as a KMS encryption_type expression on the repository or as a reference from the repository to a declared (gated) KMS key, since the switch is often held in a local."
}
