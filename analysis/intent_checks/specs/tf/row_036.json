     },
     "cond": {
      "path": "assume_role_policy",
      "op": "regex",
      "value": "(?is)(cognito-identity\\.amazonaws\\.com:amr.{0,300}[^a-z]authenticated|[^a-z]authenticated.{0,300}cognito-identity\\.amazonaws\\.com:amr)"
     }
    },
