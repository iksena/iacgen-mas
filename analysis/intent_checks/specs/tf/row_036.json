  {
   "id": "trust_federated",
   "tier": "core",
   "quote": "a trust policy allowing federated access from \"cognito-identity.amazonaws.com\"",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_iam_role"
      ],
      "where": [
       {
        "path": "name",
        "op": "eq",
        "value": "user-group-role"
       }
      ]
     },
     "cond": {
      "path": "assume_role_policy",
      "op": "regex",
      "value": "(?i)(federated[\"']?\\s*[:=]\\s*\\[?\\s*[\"']?cognito-identity\\.amazonaws\\.com|identifiers:\\[cognito-identity\\.amazonaws\\.com\\][^\\]]{0,40}type:federated)"
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_iam_role"
       },
       {
        "path": "properties.name",
        "op": "eq",
        "value": "user-group-role"
       }
      ]
     },
     "cond": {
      "path": "properties.assume_role_policy",
      "op": "regex",
      "value": "(?i)(federated[\"']?\\s*[:=]\\s*\\[?\\s*[\"']?cognito-identity\\.amazonaws\\.com|identifiers:\\[cognito-identity\\.amazonaws\\.com\\][^\\]]{0,40}type:federated)"
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_iam_policy_document"
       }
      ]
     },
     "cond": {
      "path": "properties",
      "op": "regex",
      "value": "(?i)(federated[\"']?\\s*[:=]\\s*\\[?\\s*[\"']?cognito-identity\\.amazonaws\\.com|identifiers:\\[cognito-identity\\.amazonaws\\.com\\][^\\]]{0,40}type:federated)"
     }
    }
   ]
  },
