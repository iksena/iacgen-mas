   "id": "mrap_policy_get_put",
   "kind": "any_of",
   "tier": "detail",
   "quote": "allows only the owning account to get and put objects through it",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
