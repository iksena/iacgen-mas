       }
      ]
     },
     "to": {
      "types": [
       "data.aws_iam_policy_document"
      ],
      "where": [
       {
        "path": "",
        "op": "regex",
        "value": "(?i)s3:(GetObject|Get\\*|\\*)"
       },
       {
        "path": "",
        "op": "regex",
        "value": "(?i)s3:(PutObject|Put\\*|\\*)"
       }
      ]
     }
    },
