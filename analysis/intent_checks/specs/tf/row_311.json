      "types": [
       "aws_s3control_multi_region_access_point_policy"
      ]
     },
     "cond": {
      "path": "details.*.policy",
      "op": "regex",
      "value": "(?is)s3:(GetObject|Get\\*|\\*).{0,300}?s3:(PutObject|Put\\*|\\*)|s3:(PutObject|Put\\*|\\*).{0,300}?s3:(GetObject|Get\\*|\\*)"
