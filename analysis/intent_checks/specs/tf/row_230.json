  {
   "id": "endpoint_sg_443",
   "kind": "any_of",
   "tier": "core",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_security_group"
      ]
     },
     "cond": {
      "path": "ingress.*",
      "op": "match",
      "value": [
       {
        "path": "",
        "op": "port_covers",
        "value": 443
       },
       {
        "path": "cidr_blocks.*",
        "op": "regex",
        "value": "^10\\.0\\.0\\.0/16$"
       },
       {
        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       }
      ]
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_security_group_rule"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "ingress"
       },
       {
        "path": "",
        "op": "match",
        "value": [
         {
          "path": "",
          "op": "port_covers",
          "value": 443
         },
         {
          "path": "cidr_blocks.*",
          "op": "regex",
          "value": "^10\\.0\\.0\\.0/16$"
         },
         {
          "path": "protocol",
          "op": "in",
          "value": [
           "tcp",
           "6"
          ]
         }
        ]
       }
      ]
     },
     "to": {
      "types": [
       "aws_security_group"
      ]
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_vpc_security_group_ingress_rule"
      ],
      "where": [
       {
        "path": "",
        "op": "match",
        "value": [
         {
          "path": "",
          "op": "port_covers",
          "value": 443
         },
         {
          "path": "cidr_ipv4",
          "op": "regex",
          "value": "^10\\.0\\.0\\.0/16$"
         },
         {
          "path": "ip_protocol",
          "op": "in",
          "value": [
           "tcp",
           "6"
          ]
         }
        ]
       }
      ]
     },
     "to": {
      "types": [
       "aws_security_group"
      ]
     }
    }
   ],
   "quote": "an interface VPC endpoint security group permitting inbound TCP port 443 from the VPC CIDR block",
   "justify": "HTTPS 443 over TCP as stated (an all-protocol rule does not count); the VPC CIDR block defaults to 10.0.0.0/16"
