    },
    {
      "id": "alarm_threshold_periods",
      "kind": "attr",
      "tier": "detail",
      "quote": "alarming when it is at least 1 for 5 consecutive periods",
      "select": "alarm",
      "cond": {
        "path": "",
        "op": "match",
        "value": [
          {
