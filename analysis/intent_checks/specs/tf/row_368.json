    {
      "id": "sg_egress_only_vpc",
      "kind": "any_of",
      "tier": "core",
      "quote": "whose only rule allows egress to the VPC's own CIDR block",
      "justify": "egress limited to the VPC CIDR excludes the any-IP destination 0.0.0.0/0",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_security_group_rule"
              },
              {
                "path": "properties.type",
                "op": "eq",
                "value": "egress"
              }
            ]
          },
          "quantifier": "all",
          "cond": {
            "path": "properties.cidr_blocks.*",
            "op": "none_eq",
            "value": "0.0.0.0/0"
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_security_group"
              },
              {
                "path": "properties.egress",
                "op": "present"
              }
            ]
          },
          "quantifier": "all",
          "cond": {
            "path": "properties.egress.*.cidr_blocks.*",
            "op": "none_eq",
            "value": "0.0.0.0/0"
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_vpc_security_group_egress_rule"
              }
            ]
          },
          "quantifier": "all",
          "cond": {
            "path": "properties.cidr_ipv4",
            "op": "none_eq",
            "value": "0.0.0.0/0"
          }
        }
      ]
