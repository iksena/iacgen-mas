              }
            ]
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_iam_role"
              }
            ]
          },
          "cond": {
