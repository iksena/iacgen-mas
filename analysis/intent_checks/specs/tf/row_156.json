   "quote": "a security group allowing port 5678 only from the load balancer",
   "justify": "only from the load balancer = not open to 0.0.0.0/0",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_security_group"
      ],
      "where": [
       {
        "path": "ingress.*",
        "op": "port_covers",
        "value": 5678
       },
       {
        "path": "ingress.*.cidr_blocks.*",
        "op": "none_eq",
        "value": "0.0.0.0/0"
       }
      ]
     },
     "to": "sg"
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_security_group_rule"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "ingress"
       },
       {
        "path": "",
        "op": "port_covers",
        "value": 5678
       },
       {
        "path": "cidr_blocks.*",
        "op": "none_eq",
        "value": "0.0.0.0/0"
       }
      ]
     },
     "to": "sg"
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_vpc_security_group_ingress_rule"
      ],
      "where": [
       {
        "path": "from_port",
        "op": "lte",
        "value": 5678
       },
       {
        "path": "to_port",
        "op": "gte",
        "value": 5678
       },
       {
        "path": "cidr_ipv4",
        "op": "absent"
       }
      ]
     },
     "to": "sg"
    }
   ]
  },
  {
   "id": "service_to_target_group",
   "kind": "ref",
   "from": "service",
   "to": "tg",
   "tier": "detail",
   "quote": "forwarding traffic to an IP target group on port 80"
  },
  {
   "id": "taskdef_cpu_memory",
   "kind": "attr",
   "select": "taskdef",
   "tier": "core",
   "quote": "The Fargate task definition must use 256 CPU and 512 memory",
   "cond": {
    "path": "",
    "op": "match",
    "value": [
     {
      "path": "cpu",
      "op": "eq",
      "value": 256
     },
     {
      "path": "memory",
      "op": "eq",
      "value": 512
     }
    ]
   }
  },
  {
   "id": "taskdef_efs_volume",
   "kind": "attr",
   "select": "taskdef",
   "tier": "core",
   "quote": "mount the EFS volume with transit encryption and IAM authorization",
   "cond": {
    "path": "volume.*.efs_volume_configuration.*",
    "op": "match",
    "value": [
     {
      "path": "transit_encryption",
      "op": "eq",
      "value": "ENABLED"
     },
     {
      "path": "authorization_config.*.iam",
      "op": "eq",
      "value": "ENABLED"
     }
    ]
   }
  },
  {
   "id": "container_mount_path",
   "kind": "any_of",
   "tier": "detail",
   "quote": "to \"/home/node/.n8n\"",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_ecs_task_definition"
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "/home/node/\\.n8n"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "taskdef",
     "cond": {
      "path": "container_definitions",
      "op": "regex",
      "value": "/home/node/\\.n8n"
     }
    }
   ]
  },
  {
   "id": "container_port_5678",
   "kind": "any_of",
   "tier": "detail",
   "quote": "run an essential container on port 5678",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_ecs_task_definition"
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "5678"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "taskdef",
     "cond": {
      "path": "container_definitions",
      "op": "regex",
      "value": "5678"
     }
    }
   ]
  },
  {
   "id": "container_awslogs",
   "kind": "any_of",
   "tier": "detail",
   "quote": "logs through the awslogs driver",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_ecs_task_definition"
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "awslogs"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "taskdef",
     "cond": {
      "path": "container_definitions",
      "op": "regex",
      "value": "awslogs"
     }
    }
   ]
  },
  {
   "id": "container_env_skip_deregistration",
   "kind": "any_of",
   "tier": "detail",
   "quote": "setting N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN to \"true\"",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_ecs_task_definition"
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "(?is)N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN.{0,60}?true"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "taskdef",
     "cond": {
      "path": "container_definitions",
      "op": "regex",
      "value": "(?is)N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN.{0,60}?true"
     }
    }
   ]
  },
  {
   "id": "container_env_webhook_url",
   "kind": "any_of",
   "tier": "detail",
   "quote": "WEBHOOK_URL to the url variable or otherwise the HTTPS load balancer endpoint",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_ecs_task_definition"
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "WEBHOOK_URL"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "taskdef",
     "cond": {
      "path": "container_definitions",
      "op": "regex",
      "value": "WEBHOOK_URL"
     }
    }
   ]
  },
  {
   "id": "log_group_named",
   "kind": "exists",
   "tier": "detail",
   "quote": "a CloudWatch log group named with the prefix followed by \"-logs\" with 1-day retention",
   "justify": "prefix defaults to n8n, so the group is n8n-logs",
   "select": {
    "types": [
     "aws_cloudwatch_log_group"
    ],
    "where": [
     {
      "path": "name",
      "op": "eq",
      "value": "n8n-logs"
     },
     {
      "path": "retention_in_days",
      "op": "eq",
      "value": 1
     }
    ]
   }
  },
  {
   "id": "sg_egress_vpc_only",
   "kind": "attr",
   "select": "sg",
   "quantifier": "all",
   "tier": "detail",
   "quote": "All security groups must limit outbound traffic to the VPC CIDR",
   "justify": "limited to the VPC CIDR = no 0.0.0.0/0 egress",
   "cond": {
    "path": "egress.*.cidr_blocks.*",
    "op": "none_eq",
    "value": "0.0.0.0/0"
   }
  },
  {
   "id": "ecs_task_roles",
   "kind": "exists",
   "select": "ecs_role",
   "min": 2,
   "tier": "core",
   "quote": "create task and execution IAM roles assumable by \"ecs-tasks.amazonaws.com\"",
   "justify": "a task role and an execution role"
  },
  {
   "id": "roles_logs_inline_policy",
   "kind": "any_of",
   "tier": "detail",
   "quote": "each with an inline policy permitting CloudWatch log group and stream operations",
   "justify": "one inline policy per role, two roles",
   "checks": [
    {
     "kind": "exists",
     "min": 2,
     "select": {
      "types": [
       "aws_iam_role"
      ],
      "where": [
       {
        "path": "inline_policy.*.policy",
        "op": "regex",
        "value": "(?i)logs:(\\*|Create|Put|Describe)"
       }
      ]
     }
    },
    {
     "kind": "exists",
     "min": 2,
     "select": {
      "types": [
       "aws_iam_role_policy"
      ],
      "where": [
       {
        "path": "policy",
        "op": "regex",
        "value": "(?i)logs:(\\*|Create|Put|Describe)"
       }
      ]
     }
    },
    {
     "kind": "exists",
     "min": 2,
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_iam_role_policy",
         "aws_iam_role"
        ]
       },
       {
        "path": "properties",
        "op": "regex",
        "value": "(?i)logs:(\\*|Create|Put|Describe)"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "taskdef_uses_roles",
   "kind": "ref",
   "from": "taskdef",
   "to": "ecs_role",
   "tier": "detail",
   "quote": "create task and execution IAM roles"
  }
 ],
 "notes": "Container definitions are unknown at plan in the GT (WEBHOOK_URL embeds the LB DNS name), so container-level checks accept either the planned container_definitions string or the declared task-definition configuration. 'No NAT or VPN gateways' is not checked: the schema cannot express that a resource type is absent (exists min must be >= 1)."
}