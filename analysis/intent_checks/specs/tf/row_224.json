{
 "lang": "tf",
 "row_number": 224,
 "source_hash": {
  "gt": "6f46e0da8154ee7f437053e155beffc140be29addb85404cb38f927ea3efd69a",
  "prompt": "6f9d2ac41f47c229f0e9f2fcf4d66d507bf2ed20ba82eb70ea97d5beffe7ae24"
 },
 "selectors": {
  "role": {
   "types": [
    "aws_iam_role"
   ]
  },
  "profile": {
   "types": [
    "aws_iam_instance_profile"
   ]
  }
 },
 "checks": [
  {
   "id": "role",
   "kind": "exists",
   "tier": "core",
   "quote": "creates an IAM role and instance profile for an EC2 instance",
   "select": "role"
  },
  {
   "id": "role_trust_ec2",
   "kind": "any_of",
   "tier": "core",
   "quote": "an IAM role allowing assume role permissions for EC2 services",
   "checks": [
    {
     "kind": "attr",
     "select": "role",
     "cond": {
      "path": "assume_role_policy",
      "op": "contains",
      "value": "ec2.amazonaws.com"
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_iam_role"
       },
       {
        "path": "properties",
        "op": "contains",
        "value": "ec2.amazonaws.com"
       }
      ]
     }
    },
    {
     "kind": "ref",
     "from": "role",
     "to": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_iam_policy_document"
       },
       {
        "path": "properties",
        "op": "contains",
        "value": "ec2.amazonaws.com"
       }
      ]
     }
    }
   ],
   "justify": "EC2 service principal is ec2.amazonaws.com"
  },
  {
   "id": "role_name_default",
   "kind": "attr",
   "tier": "core",
   "quote": "a default name of \"tamr-instance-role\"",
   "select": "role",
   "cond": {
    "path": "name",
    "op": "eq",
    "value": "tamr-instance-role"
   }
  },
  {
   "id": "permissions_boundary_optional",
   "kind": "exists",
   "tier": "detail",
   "quote": "an optional permissions boundary",
   "select": {
    "types": [
     "__declared__"
    ],
    "where": [
     {
      "path": "type",
      "op": "eq",
      "value": "aws_iam_role"
     },
     {
      "path": "properties.permissions_boundary",
      "op": "regex",
      "value": "\\$\\{"
     }
    ]
   }
  },
  {
   "id": "profile",
   "kind": "exists",
   "tier": "core",
   "quote": "an associated IAM instance profile",
   "select": "profile"
  },
  {
   "id": "profile_uses_role",
   "kind": "any_of",
   "tier": "core",
   "quote": "an associated IAM instance profile",
   "checks": [
    {
     "kind": "ref",
     "from": "profile",
     "to": "role"
    },
    {
     "kind": "join",
     "from": "profile",
     "from_path": "role",
     "to": "role",
     "to_path": "name"
    }
   ]
  },
  {
   "id": "profile_name_default",
   "kind": "attr",
   "tier": "core",
   "quote": "defaulting to \"tamr-instance-profile\"",
   "select": "profile",
   "cond": {
    "path": "name",
    "op": "eq",
    "value": "tamr-instance-profile"
   }
  },
  {
   "id": "tags_map",
   "kind": "any_of",
   "tier": "detail",
   "quote": "supporting a customizable map of resource tags",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_iam_role",
         "aws_iam_instance_profile"
        ]
       },
       {
        "path": "properties.tags",
        "op": "present"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "role",
     "cond": {
      "path": "tags",
      "op": "present"
     }
    }
   ]
  }
 ],
 "notes": "permissions_boundary_optional requires the boundary to be an expression (input-driven), so a hardcoded boundary ARN fails 'optional'. Trust is bound to the role or a policy document it references."
}