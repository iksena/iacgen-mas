              {
                "path": "properties",
                "op": "regex",
                "value": "(\"identifiers\": \\[\"\\*\"\\]|[\"']AWS[\"']\\s*:\\s*\\[?\\s*[\"']\\*[\"']|[\"']Principal[\"']\\s*:\\s*[\"']\\*[\"'])"
              },
