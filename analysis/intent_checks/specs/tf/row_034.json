    {
      "id": "stmt2_events_publish",
      "tier": "core",
      "quote": "must explicitly allow the Amazon EventBridge service principal (events.amazonaws.com) to perform the sns:Publish action",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
