        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       },
       {
        "path": "from_port",
        "op": "eq",
        "value": 443
       },
       {
        "path": "to_port",
        "op": "eq",
        "value": 443
       },
       {
        "path": "cidr_block",
        "op": "eq",
        "value": "0.0.0.0/0"
       },
       {
        "path": "rule_action",
        "op": "eq",
        "value": "allow"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "nacl",
     "cond": {
      "path": "egress.*",
      "op": "match",
      "value": [
       {
        "path": "rule_no",
        "op": "eq",
        "value": 100
       },
       {
        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       },
       {
        "path": "from_port",
        "op": "eq",
        "value": 443
       },
       {
        "path": "to_port",
        "op": "eq",
        "value": 443
       },
       {
        "path": "cidr_block",
        "op": "eq",
        "value": "0.0.0.0/0"
       },
       {
        "path": "action",
        "op": "eq",
        "value": "allow"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "nacl_outbound_only_443",
   "kind": "any_of",
   "tier": "detail",
   "quote": "allowing only TCP port 443",
   "checks": [
    {
     "kind": "attr",
     "quantifier": "all",
     "select": {
      "types": [
       "aws_network_acl_rule"
      ],
      "where": [
       {
        "path": "egress",
        "op": "truthy"
       },
       {
        "path": "rule_action",
        "op": "eq",
        "value": "allow"
