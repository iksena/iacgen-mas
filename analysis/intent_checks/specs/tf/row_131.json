  {
   "id": "nacl_inbound_return_traffic",
   "kind": "any_of",
   "tier": "core",
   "quote": "the inbound rule defaulting to rule number 100 allowing TCP ports 1024 to 65535 from \"0.0.0.0/0\" for return traffic",
   "checks": [
    {
     "kind": "ref",
     "to": "nacl",
     "from": {
      "types": [
       "aws_network_acl_rule"
      ],
      "where": [
       {
        "path": "egress",
        "op": "eq",
        "value": false
       },
       {
        "path": "rule_number",
        "op": "eq",
        "value": 100
       },
       {
        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       },
       {
        "path": "from_port",
        "op": "eq",
        "value": 1024
       },
       {
        "path": "to_port",
        "op": "eq",
        "value": 65535
       },
       {
        "path": "cidr_block",
        "op": "eq",
        "value": "0.0.0.0/0"
       },
       {
        "path": "rule_action",
        "op": "eq",
        "value": "allow"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "nacl",
     "cond": {
      "path": "ingress.*",
      "op": "match",
      "value": [
       {
        "path": "rule_no",
        "op": "eq",
        "value": 100
       },
       {
        "path": "protocol",
        "op": "in",
        "value": [
         "tcp",
         "6"
        ]
       },
       {
        "path": "from_port",
        "op": "eq",
        "value": 1024
       },
       {
        "path": "to_port",
        "op": "eq",
        "value": 65535
       },
       {
        "path": "cidr_block",
        "op": "eq",
        "value": "0.0.0.0/0"
       },
       {
        "path": "action",
        "op": "eq",
        "value": "allow"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "nacl_outbound_https",
   "kind": "any_of",
   "tier": "core",
