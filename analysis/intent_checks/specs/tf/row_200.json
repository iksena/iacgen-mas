          "cond": {
            "path": "service_name",
            "op": "regex",
            "value": "(?i)\\.s3$"
          }
        }
      ],
      "justify": "Gateway endpoint: type Gateway or omitted (the default), not Interface"
    },
    {
      "id": "s3_endpoint_policy",
      "kind": "any_of",
      "tier": "detail",
      "quote": "using a full access policy",
      "justify": "a full access policy is an Allow statement with a wildcard action",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_vpc_endpoint"
              },
              {
                "path": "properties.service_name",
                "op": "regex",
                "value": "(?i)\\.s3$"
              },
              {
                "path": "properties",
                "op": "regex",
                "value": "(?i)allow"
              }
            ]
          },
          "cond": {
            "path": "properties",
            "op": "regex",
            "value": "(?i)action\\W{1,8}(s3:)?\\*"
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "aws_vpc_endpoint"
            ],
            "where": [
              {
                "path": "policy",
                "op": "regex",
                "value": "(?i)allow"
              }
            ]
          },
          "cond": {
            "path": "policy",
            "op": "regex",
            "value": "(?i)action\\W{1,8}(s3:)?\\*"
          }
        }
      ]
    },
