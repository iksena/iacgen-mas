    {
      "id": "s3_endpoint",
      "kind": "any_of",
      "tier": "core",
      "quote": "An S3 Gateway VPC Endpoint must be conditionally provisioned",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
              "__declared__"
            ],
            "where": [
              {
                "path": "type",
                "op": "eq",
                "value": "aws_vpc_endpoint"
              },
              {
                "path": "properties.vpc_endpoint_type",
                "op": "none_eq",
                "value": "Interface"
              }
            ]
          },
          "cond": {
            "path": "properties.service_name",
            "op": "regex",
            "value": "(?i)\\.s3$"
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "aws_vpc_endpoint"
            ],
            "where": [
              {
                "path": "vpc_endpoint_type",
