    },
    {
     "kind": "attr",
     "select": "ssm",
     "cond": {
      "path": "tags.Environment",
      "op": "eq",
      "value": "production"
     }
    }
   ],
   "tier": "detail",
   "quote": "the environment as \"production\""
  }
 ],
 "notes": "Route 53 delegation sets do not support tags; tag checks apply to the SSM parameter only."
