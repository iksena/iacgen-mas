    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_kms_key_policy"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "regex",
      "value": "(?i)budgets\\.amazonaws\\.com"
