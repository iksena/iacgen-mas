  {
   "id": "notif_threshold",
   "kind": "attr",
   "tier": "core",
   "select": "bud",
   "cond": {
    "path": "notification.*",
    "op": "match",
    "value": [
     {
      "path": "notification_type",
      "op": "eq",
      "value": "ACTUAL"
     },
     {
      "path": "comparison_operator",
      "op": "eq",
      "value": "GREATER_THAN"
     },
     {
      "path": "threshold",
      "op": "eq",
      "value": 100
     },
     {
      "path": "threshold_type",
      "op": "eq",
      "value": "PERCENTAGE"
     }
    ]
   },
   "quote": "triggers when actual costs exceed 100% of the budget limit",
   "justify": "100% of the budget limit means threshold 100 PERCENTAGE"
  },
