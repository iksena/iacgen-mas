    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "aws_kms_key"
       }
      ]
     },
     "cond": {
      "path": "properties.policy",
      "op": "regex",
      "value": "(?i)budgets\\.amazonaws\\.com"
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
