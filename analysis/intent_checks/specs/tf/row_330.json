      "types": [
        "aws_sqs_queue"
      ],
      "where": [
        {
          "path": "name",
          "op": "eq",
          "value": "aggregation-lambda-dead-letter-queue"
        }
      ]
    },
    "key": {
      "types": [
        "aws_kms_key"
      ],
      "where": []
    },
    "alias": {
      "types": [
        "__declared__"
      ],
      "where": [
        {
          "path": "type",
          "op": "eq",
          "value": "aws_kms_alias"
        },
        {
          "path": "properties.target_key_id",
          "op": "contains",
          "value": "aws_kms_key."
        }
      ]
    },
    "any_queue": {
      "types": [
        "aws_sqs_queue"
      ],
      "where": []
