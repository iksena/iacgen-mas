{
 "lang": "tf",
 "row_number": 220,
 "source_hash": {
  "gt": "b9a910b7d2087ddffcaec94f13ca71ea50a31a44f87110dd19556bda1a972473",
  "prompt": "5ade8ce44ed07f6d589be4004a67850d014a397afec1e7e1357272d8c54d157c"
 },
 "selectors": {
  "agg": {
   "types": [
    "aws_config_configuration_aggregator"
   ]
  }
 },
 "checks": [
  {
   "id": "aggregator",
   "kind": "exists",
   "tier": "core",
   "quote": "creates an AWS Config configuration aggregator",
   "select": "agg"
  },
  {
   "id": "aggregator_name",
   "kind": "attr",
   "tier": "core",
   "quote": "named \"default\"",
   "select": "agg",
   "cond": {
    "path": "name",
    "op": "eq",
    "value": "default"
   }
  },
  {
   "id": "all_regions",
   "kind": "any_of",
   "tier": "core",
   "quote": "across all AWS regions",
   "checks": [
    {
     "kind": "attr",
     "select": "agg",
     "cond": {
      "path": "account_aggregation_source.*.all_regions",
      "op": "truthy"
     }
    },
    {
     "kind": "ref",
     "from": "agg",
     "to": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_regions"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "current_account",
   "kind": "any_of",
   "tier": "core",
   "quote": "for the current AWS account",
   "checks": [
    {
     "kind": "ref",
     "from": "agg",
     "to": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "eq",
        "value": "data.aws_caller_identity"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "agg",
     "cond": {
      "path": "account_aggregation_source.*.account_ids.*",
      "op": "eq",
      "value": "000000000000"
     }
    }
   ],
   "justify": "000000000000 is the plan adapter's account id, i.e. this stack's account"
  },
  {
   "id": "default_tags_terraform",
   "kind": "any_of",
   "tier": "detail",
   "quote": "applying default tags that indicate the stack is managed by Terraform",
   "checks": [
    {
     "kind": "attr",
     "select": "agg",
     "cond": {
      "path": "tags_all",
      "op": "contains",
      "value": "terraform"
     }
    },
    {
     "kind": "attr",
     "select": "agg",
     "cond": {
      "path": "tags",
      "op": "contains",
      "value": "terraform"
     }
    }
   ]
  }
 ],
 "notes": "current_account accepts a reference to aws_caller_identity or the planned account id of this stack; a literal foreign account id fails. all_regions accepts all_regions = true or a region list taken from data.aws_regions."
}