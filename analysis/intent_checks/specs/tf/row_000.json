  {
   "id": "policy_current_account",
   "kind": "any_of",
   "tier": "core",
   "quote": "allows only the current AWS account",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "aws_sqs_queue_policy"
      ]
     },
     "to": {
      "types": [
       "data.aws_iam_policy_document"
      ],
      "where": [
       {
        "path": "statement.*",
        "op": "match",
        "value": [
         {
          "path": "effect",
          "op": "eq",
          "value": "Allow"
         },
         {
          "path": "principals.*.identifiers.*",
          "op": "regex",
          "value": "^(arn:aws[a-z-]*:iam::\\d{12}:root|\\d{12})$"
         },
         {
          "path": "principals.*.identifiers.*",
          "op": "none_eq",
          "value": "*"
         }
        ]
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "aws_sqs_queue_policy",
       "aws_sqs_queue"
      ]
     },
     "cond": {
      "path": "policy",
      "op": "regex",
      "value": "(?i)\"principal\":\\s*\\{\\s*\"aws\":\\s*\\[?\\s*\"(arn:aws[a-z-]*:iam::\\d{12}:root|\\d{12})\"\\s*\\]?\\s*\\}"
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
       {
        "path": "type",
        "op": "in",
        "value": [
         "aws_sqs_queue_policy",
         "aws_sqs_queue"
        ]
       }
      ]
     },
     "cond": {
      "path": "properties.policy",
      "op": "regex",
      "value": "(?i)'principal':\\s*\\{'aws':\\s*\\[?'([^']*(caller_identity|account|:root)[^']*|\\d{12})'\\]?\\}"
     }
    }
   ]
  }
 ],
 "notes": "Value checks bind to any SQS queue (one queue in the prompt); only queue_named needs the exact name, so a name_prefix (which yields notificationQueue<suffix>) fails queue_named only. Policy checks bind to the policy attached to a queue: a data.aws_iam_policy_document referenced by aws_sqs_queue_policy, a planned policy string, or the declared jsonencode text. 'only the current account' is enforced as an Allow statement with a 12-digit account ID or account-root ARN principal and no '*' principal; a second, separate Allow statement for another principal is not detected (no negated match over statements), and a Deny statement for '*' (e.g. secure transport) is deliberately allowed."
}