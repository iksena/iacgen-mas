     "to_path": "AliasName"
    }
   ]
  },
  {
   "id": "same_key",
   "kind": "any_of",
   "tier": "core",
   "quote": "encrypted with that same key",
   "checks": [
    {
     "kind": "join",
     "from": "rg",
