   "kind": "attr",
   "select": "rg",
   "cond": {
    "path": "TransitEncryptionEnabled",
    "op": "eq",
    "value": true
   },
   "tier": "core",
   "quote": "both at-rest and in-transit encryption turned on"
  },
  {
   "id": "kms_key",
   "kind": "exists",
   "select": "key",
   "tier": "core",
