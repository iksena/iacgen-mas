 "checks": [
  {
   "id": "vpc",
   "kind": "exists",
   "select": "vpc22",
   "tier": "core",
   "quote": "build its own VPC (defaulting to a 10.0.0.0/22 CIDR block)"
  },
  {
   "id": "subnet_cidr1",
   "kind": "exists",
   "select": "sn1",
   "tier": "core",
   "quote": "(defaulting to 10.0.0.0/24 and 10.0.1.0/24)"
  },
  {
   "id": "subnet_cidr2",
   "kind": "exists",
   "select": "sn2",
   "tier": "core",
   "quote": "(defaulting to 10.0.0.0/24 and 10.0.1.0/24)"
  },
  {
   "id": "subnets_two_azs",
   "kind": "exists",
   "select": "named_subnets",
   "distinct_path": "AvailabilityZone",
   "min": 2,
   "tier": "core",
   "quote": "two private subnets in different Availability Zones",
   "justify": "the two subnets the prompt gives CIDRs for"
  },
  {
   "id": "subnets_in_vpc",
   "kind": "ref",
   "from": "named_subnets",
   "to": "vpc22",
   "tier": "detail",
   "quote": "build its own VPC (defaulting to a 10.0.0.0/22 CIDR block) with two private subnets"
  },
  {
   "id": "subnets_private",
   "kind": "attr",
   "select": "named_subnets",
   "cond": {
    "path": "MapPublicIpOnLaunch",
    "op": "none_eq",
    "value": true
   },
   "quantifier": "all",
   "tier": "core",
   "quote": "two private subnets"
  },
  {
   "id": "security_group",
   "kind": "exists",
   "select": "sg",
   "tier": "core",
   "quote": "a security group permitting traffic between those subnets"
  },
  {
   "id": "sg_permits_subnets",
   "kind": "any_of",
   "tier": "detail",
   "quote": "a security group permitting traffic between those subnets",
   "justify": "a rule per subnet, a rule for the VPC CIDR that holds both, a CIDR read from the subnet or VPC, or a security-group source all let the subnets talk",
   "checks": [
    {
     "kind": "attr",
     "select": "sg",
     "cond": {
      "path": "SecurityGroupIngress",
      "op": "regex",
      "value": "(?s)10\\.0\\.0\\.0/24.*10\\.0\\.1\\.0/24|10\\.0\\.1\\.0/24.*10\\.0\\.0\\.0/24"
     }
    },
    {
     "kind": "attr",
     "select": "sg",
     "cond": {
      "path": "SecurityGroupIngress.*.CidrIp",
      "op": "eq",
      "value": "10.0.0.0/22"
     }
    },
    {
     "kind": "attr",
     "select": "sg",
     "cond": {
      "path": "SecurityGroupIngress.*.CidrIp.attr",
      "op": "eq",
      "value": "CidrBlock"
     }
    },
    {
     "kind": "attr",
     "select": "sg",
     "cond": {
      "path": "SecurityGroupIngress.*.SourceSecurityGroupId",
      "op": "present"
     }
    },
    {
     "kind": "exists",
     "select": "sgi",
     "distinct_path": "CidrIp",
     "min": 2
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "AWS::EC2::SecurityGroupIngress"
      ],
      "where": [
       {
        "path": "CidrIp",
        "op": "eq",
        "value": "10.0.0.0/22"
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "AWS::EC2::SecurityGroupIngress"
      ],
      "where": [
       {
        "path": "CidrIp.attr",
        "op": "eq",
        "value": "CidrBlock"
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "AWS::EC2::SecurityGroupIngress"
      ],
      "where": [
       {
        "path": "SourceSecurityGroupId",
        "op": "present"
       }
      ]
     }
    }
   ]
  },
  {
   "id": "subnet_group",
   "kind": "exists",
   "select": "sng",
   "tier": "core",
   "quote": "an ElastiCache subnet group"
  },
  {
   "id": "subnet_group_subnets",
   "kind": "all_of",
   "tier": "detail",
   "quote": "an ElastiCache subnet group",
   "checks": [
    {
     "kind": "ref",
     "from": "sng",
     "to": "sn1"
    },
    {
     "kind": "ref",
     "from": "sng",
     "to": "sn2"
    }
   ]
  },
  {
   "id": "rg_in_subnet_group",
   "kind": "any_of",
   "tier": "detail",
   "quote": "an ElastiCache subnet group",
   "checks": [
    {
     "kind": "ref",
     "from": "rg",
     "to": "sng"
    },
    {
     "kind": "join",
     "from": "rg",
     "from_path": "CacheSubnetGroupName",
     "to": "sng",
     "to_path": "CacheSubnetGroupName"
    }
   ]
  },
  {
   "id": "rg_uses_sg",
   "kind": "ref",
   "from": "rg",
   "to": "sg",
   "tier": "detail",
   "quote": "a security group permitting traffic between those subnets"
  },
  {
   "id": "replication_group",
   "kind": "exists",
   "select": "rg",
   "tier": "core",
   "quote": "an Amazon ElastiCache for Redis replication group with cluster mode enabled"
  },
  {
   "id": "redis_engine",
   "kind": "any_of",
   "tier": "core",
   "quote": "ElastiCache for Redis replication group",
   "justify": "Redis engine; the property is optional and defaults to redis",
   "checks": [
    {
     "kind": "attr",
     "select": "rg",
     "cond": {
      "path": "Engine",
      "op": "eq",
      "value": "redis"
     }
    },
    {
     "kind": "attr",
     "select": "rg",
     "cond": {
      "path": "Engine",
      "op": "absent"
     }
    }
   ]
  },
  {
   "id": "cluster_mode_two_shards",
   "kind": "any_of",
   "tier": "core",
   "quote": "two shards with one replica each",
   "justify": "shards are node groups",
   "checks": [
    {
     "kind": "attr",
     "select": "rg",
     "cond": {
      "path": "NumNodeGroups",
      "op": "eq",
      "value": 2
     }
    },
    {
     "kind": "attr",
     "select": "rg",
     "cond": {
      "path": "NodeGroupConfiguration",
      "op": "len_eq",
      "value": 2
     }
    }
   ]
  },
  {
   "id": "one_replica",
   "kind": "any_of",
   "tier": "core",
   "quote": "two shards with one replica each",
   "justify": "one replica each",
   "checks": [
    {
     "kind": "attr",
     "select": "rg",
     "cond": {
      "path": "ReplicasPerNodeGroup",
      "op": "eq",
      "value": 1
     }
    },
    {
     "kind": "attr",
     "select": "rg",
     "cond": {
      "path": "NodeGroupConfiguration.*.ReplicaCount",
      "op": "eq",
      "value": 1,
      "every": true
     }
    }
   ]
  },
  {
   "id": "multi_az",
   "kind": "attr",
   "select": "rg",
   "cond": {
    "path": "MultiAZEnabled",
    "op": "eq",
    "value": true
   },
   "tier": "core",
   "quote": "Multi-AZ and automatic failover enabled"
  },
  {
   "id": "auto_failover",
   "kind": "attr",
   "select": "rg",
   "cond": {
    "path": "AutomaticFailoverEnabled",
    "op": "eq",
    "value": true
   },
   "tier": "core",
   "quote": "Multi-AZ and automatic failover enabled"
  },
  {
   "id": "at_rest_encryption",
   "kind": "attr",
   "select": "rg",
   "cond": {
    "path": "AtRestEncryptionEnabled",
    "op": "eq",
    "value": true
   },
   "tier": "core",
   "quote": "both at-rest and in-transit encryption turned on"
  },
  {
