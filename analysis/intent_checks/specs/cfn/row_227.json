     "kind": "exists",
     "select": {
      "types": [
       "AWS::IAM::Role"
      ],
      "where": [
       {
        "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
        "op": "glob_covers",
        "value": "ssm:SendAutomationSignal"
       },
       {
        "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
        "op": "none_eq",
        "value": "*"
       },
       {
        "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
        "op": "none_eq",
        "value": "ssm:*"
