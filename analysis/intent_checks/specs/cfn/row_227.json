      ]
     }
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "AWS::IAM::Policy",
       "AWS::IAM::ManagedPolicy"
      ],
      "where": [
       {
        "path": "PolicyDocument.Statement.*.Action.*",
        "op": "glob_covers",
        "value": "ssm:SendAutomationSignal"
       },
       {
        "path": "PolicyDocument.Statement.*.Action.*",
        "op": "none_eq",
        "value": "*"
       },
       {
        "path": "PolicyDocument.Statement.*.Action.*",
