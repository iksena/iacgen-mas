   "checks": [
    {
     "kind": "ref",
     "from": "rg",
     "to": "key"
    },
    {
     "kind": "ref",
     "from": "rg",
     "to": "alias"
    },
    {
     "kind": "join",
     "from": "rg",
     "from_path": "KmsKeyId",
     "to": "alias",
     "to_path": "AliasName"
    }
   ]
  },
  {
   "id": "sns_topic",
   "kind": "exists",
   "select": "topic",
   "tier": "core",
