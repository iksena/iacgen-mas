        "op": "eq",
        "value": "CidrBlock"
       }
      ]
     },
     "to": "sg"
    },
    {
     "kind": "join",
     "from": {
      "types": [
       "AWS::EC2::SecurityGroupIngress"
      ],
      "where": [
       {
        "path": "",
        "op": "port_covers",
        "value": 443
       },
       {
        "path": "IpProtocol",
        "op": "in",
        "value": [
