  {
   "id": "https_in",
   "kind": "any_of",
   "tier": "core",
   "quote": "allows inbound HTTPS traffic from within the VPC's own address range",
   "checks": [
    {
     "kind": "attr",
     "select": "sg",
     "cond": {
      "path": "SecurityGroupIngress.*",
      "op": "match",
      "value": [
       {
        "path": "",
        "op": "port_covers",
