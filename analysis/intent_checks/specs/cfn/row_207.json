  {
   "id": "s3ep_read",
   "kind": "attr",
   "tier": "core",
   "quote": "allows read access from any principal",
   "select": "s3ep",
   "cond": {
    "path": "PolicyDocument.Statement.*",
    "op": "match",
    "value": [
     {
      "path": "Effect",
      "op": "eq",
      "value": "allow"
     },
     {
      "path": "Action.*",
      "op": "glob_covers",
      "value": "s3:GetObject"
     },
     {
      "path": "Principal",
      "op": "regex",
      "value": "^(\\*|\\{\"AWS\": ?\\[?\"\\*\"\\]?\\})$"
     }
    ]
   },
   "justify": "read access = s3:GetObject (s3:Get*, s3:* and * also count); any principal = * in one Allow statement"
  },
