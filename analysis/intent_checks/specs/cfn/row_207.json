          "path": "",
          "op": "port_covers",
          "value": 443
         },
         {
          "path": "IpProtocol",
          "op": "in",
          "value": [
           "tcp",
           "6"
          ]
         }
        ]
       }
      ]
     },
     "from_path": "SecurityGroupIngress.*.CidrIp",
     "to": "vpc",
     "to_path": "CidrBlock"
    },
    {
     "kind": "ref",
     "from": {
      "types": [
       "AWS::EC2::SecurityGroupIngress"
      ],
      "where": [
       {
        "path": "",
        "op": "port_covers",
