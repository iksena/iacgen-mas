  "checks": [
    {
      "id": "api",
      "kind": "exists",
      "select": "api",
      "tier": "core",
      "quote": "creates an AWS AppSync GraphQL API"
    },
    {
      "id": "api_iam_auth",
      "kind": "attr",
      "select": "api",
      "cond": {
        "path": "AuthenticationType",
        "op": "eq",
        "value": "AWS_IAM"
      },
      "tier": "core",
      "quote": "with AWS IAM authentication",
      "justify": "\"AWS IAM authentication\" = AWS_IAM authentication type"
    },
    {
      "id": "schema_note_type",
      "kind": "attr",
      "select": "schema",
      "cond": {
        "path": "Definition",
        "op": "regex",
        "value": "(?s)type\\s+Note\\b[^{]*\\{"
      },
      "tier": "core",
      "quote": "a Note type"
    },
    {
      "id": "schema_note_fields",
      "kind": "all_of",
      "checks": [
        {
          "kind": "attr",
          "select": "schema",
          "cond": {
            "path": "Definition",
            "op": "regex",
            "value": "(?s)type\\s+Note\\b[^{]*\\{[^}]*\\bNoteId\\b"
          }
        },
        {
          "kind": "attr",
          "select": "schema",
          "cond": {
            "path": "Definition",
            "op": "regex",
            "value": "(?s)type\\s+Note\\b[^{]*\\{[^}]*\\btitle\\b"
          }
        },
        {
          "kind": "attr",
          "select": "schema",
          "cond": {
            "path": "Definition",
            "op": "regex",
            "value": "(?s)type\\s+Note\\b[^{]*\\{[^}]*\\bcontent\\b"
          }
        }
      ],
      "tier": "detail",
      "quote": "fields for NoteId, title, and content"
    },
    {
      "id": "schema_get_note",
      "kind": "attr",
      "select": "schema",
      "cond": {
        "path": "Definition",
        "op": "regex",
        "value": "(?s)type\\s+Query\\b[^{]*\\{[^}]*\\bgetNote\\b"
      },
      "tier": "core",
      "quote": "a getNote query"
    },
    {
      "id": "schema_save_note",
      "kind": "attr",
      "select": "schema",
      "cond": {
        "path": "Definition",
        "op": "regex",
        "value": "(?s)type\\s+Mutation\\b[^{]*\\{[^}]*\\bsaveNote\\b"
      },
      "tier": "core",
      "quote": "a saveNote mutation"
    },
    {
      "id": "eventbridge_datasource",
      "kind": "exists",
      "select": "ds",
      "tier": "core",
      "quote": "an Amazon EventBridge data source",
      "justify": "EventBridge data source = AMAZON_EVENTBRIDGE type"
    },
    {
      "id": "event_bus",
      "kind": "exists",
      "select": "bus",
      "tier": "core",
      "quote": "a custom EventBridge event bus"
    },
    {
      "id": "ds_targets_bus",
      "kind": "any_of",
      "checks": [
        {
          "kind": "ref",
          "from": "ds",
          "to": "bus"
        },
        {
          "kind": "attr",
          "select": "ds",
          "cond": {
            "path": "EventBridgeConfig.EventBusArn",
            "op": "regex",
            "value": "event-bus/([^d]|d[^e]|de[^f])"
          }
        }
      ],
      "tier": "core",
      "quote": "configured to put events onto a custom EventBridge event bus",
      "justify": "a literal ARN naming any bus but default"
    },
    {
