    {
      "id": "https_egress_only",
      "kind": "any_of",
      "tier": "core",
      "quote": "allows HTTPS-only egress to the VPC endpoints",
      "justify": "HTTPS implies TCP 443",
      "checks": [
        {
          "kind": "attr",
          "select": "sge",
          "quantifier": "all",
          "cond": {
            "path": "",
            "op": "match",
            "value": [
              {
                "path": "IpProtocol",
                "op": "eq",
                "value": "tcp"
              },
              {
                "path": "FromPort",
                "op": "eq",
                "value": 443
              },
              {
                "path": "ToPort",
                "op": "eq",
                "value": 443
              }
            ]
          }
        },
        {
          "kind": "attr",
          "quantifier": "all",
          "select": {
            "types": [
              "AWS::EC2::SecurityGroup"
            ],
            "where": [
              {
                "path": "SecurityGroupEgress.*.FromPort",
                "op": "eq",
                "value": 443
              }
            ]
          },
          "cond": {
            "path": "SecurityGroupEgress.*.IpProtocol",
            "op": "eq",
            "value": "tcp",
            "every": true
          }
        }
      ]
    },
