      "tier": "core",
      "quote": "CIDR blocks of 10.50.0.0/16 and 10.60.0.0/16 respectively",
      "select": "vpc_fog"
    },
    {
      "id": "users_subnet",
      "kind": "ref",
      "tier": "core",
      "quote": "each with one subnet and route table",
      "from": "subnet",
      "to": "vpc_users"
    },
    {
      "id": "fog_subnet",
      "kind": "ref",
      "tier": "core",
      "quote": "each with one subnet and route table",
      "from": "subnet",
      "to": "vpc_fog"
    },
    {
      "id": "users_route_table",
      "kind": "ref",
      "tier": "detail",
      "quote": "each with one subnet and route table",
      "from": "rt",
      "to": "vpc_users"
    },
    {
      "id": "fog_route_table",
      "kind": "ref",
      "tier": "detail",
      "quote": "each with one subnet and route table",
      "from": "rt",
      "to": "vpc_fog"
    },
    {
      "id": "one_subnet_and_route_table_each",
      "kind": "all_of",
      "tier": "detail",
      "quote": "each with one subnet and route table",
      "checks": [
        {
          "kind": "exists",
          "select": "subnet",
          "min": 2,
          "max": 2
        },
        {
          "kind": "exists",
          "select": "rt",
          "min": 2,
          "max": 2
        }
      ],
      "justify": "two VPCs with one of each make two"
    },
    {
      "id": "subnets_have_az",
      "kind": "attr",
      "tier": "detail",
      "quote": "placed in the first available availability zone in the region",
      "select": "subnet",
      "quantifier": "all",
      "cond": {
        "path": "AvailabilityZone",
        "op": "regex",
        "value": "\\da$"
      },
      "justify": "the first AZ of a region ends in a; Fn::Select 0 of Fn::GetAZs resolves to it"
    },
    {
      "id": "users_s3_gateway",
      "kind": "ref",
      "tier": "core",
      "quote": "private connectivity to Amazon S3 through a gateway VPC endpoint",
