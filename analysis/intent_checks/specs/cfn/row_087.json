    "vpc_users": {
      "types": [
        "AWS::EC2::VPC"
      ],
      "where": [
        {
          "path": "CidrBlock",
          "op": "eq",
          "value": "10.50.0.0/16"
        }
      ]
    },
    "vpc_fog": {
      "types": [
        "AWS::EC2::VPC"
      ],
      "where": [
        {
          "path": "CidrBlock",
          "op": "eq",
          "value": "10.60.0.0/16"
        }
      ]
    },
    "s3gw": {
      "types": [
        "AWS::EC2::VPCEndpoint"
      ],
      "where": [
        {
          "path": "ServiceName",
          "op": "regex",
          "value": "\\.s3$"
        },
        {
          "path": "VpcEndpointType",
          "op": "none_eq",
          "value": "Interface"
        }
      ]
    }
  },
  "checks": [
    {
      "id": "two_vpcs",
      "kind": "exists",
      "tier": "core",
      "quote": "creates two separate, self-contained VPCs",
      "select": "vpc",
      "min": 2
    },
    {
      "id": "users_vpc_cidr",
      "kind": "exists",
      "tier": "core",
      "quote": "CIDR blocks of 10.50.0.0/16 and 10.60.0.0/16 respectively",
      "select": "vpc_users"
    },
    {
      "id": "fog_vpc_cidr",
