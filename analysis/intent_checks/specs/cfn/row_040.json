{
  "lang": "cfn",
  "row_number": 40,
  "source_hash": {
    "gt": "aeee8139107974b210b4d23d6e7d8a2430198179652c4a86989b4d2784581ba3",
    "prompt": "43d3d3dcb6e8311da7030a53b33ed61a4aa271aa4f7f28027eaa505d0bef2d2c"
  },
  "selectors": {
    "fn": {
      "types": [
        "AWS::Lambda::Function"
      ]
    },
    "cr": {
      "types": [
        "__declared__"
      ],
      "where": [
        {
          "path": "type",
          "op": "regex",
          "value": "^(AWS::CloudFormation::CustomResource|Custom::.+)$"
        },
        {
          "path": "gated",
          "op": "eq",
          "value": false
        }
      ]
    },
    "role": {
      "types": [
        "AWS::IAM::Role"
      ]
    },
    "iotpol": {
      "types": [
        "AWS::IoT::Policy"
      ]
    },
    "out": {
      "types": [
        "__output__"
      ]
    },
    "out_name": {
      "types": [
        "__output__"
      ],
      "where": [
        {
          "path": "value.attr",
          "op": "none_eq",
          "value": "Arn"
        },
        {
          "path": "value.attr",
          "op": "none_eq",
          "value": "PolicyArn"
        }
      ]
    }
  },
  "checks": [
    {
      "id": "lambda",
      "tier": "core",
      "quote": "a Lambda-backed custom resource",
      "kind": "exists",
      "select": "fn"
    },
    {
      "id": "runtime",
      "tier": "core",
      "quote": "running Node.js 24.x",
      "kind": "attr",
      "select": "fn",
      "cond": {
        "path": "Runtime",
        "op": "eq",
        "value": "nodejs24.x"
      }
    },
    {
      "id": "custom_resource",
      "tier": "core",
      "quote": "a Lambda-backed custom resource",
      "kind": "exists",
      "select": "cr"
    },
    {
      "id": "custom_uses_fn",
      "tier": "core",
      "quote": "a Lambda-backed custom resource",
      "kind": "ref",
      "from": "cr",
      "to": "fn"
    },
    {
      "id": "connect",
      "tier": "core",
      "quote": "allows devices to connect",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "iotpol",
          "cond": {
            "path": "PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "iot:Connect"
          }
        },
        {
          "kind": "attr",
          "select": "fn",
          "cond": {
            "path": "Code.ZipFile",
            "op": "regex",
            "value": "(?i)iot:(Connect|\\*)"
          }
        },
        {
          "kind": "attr",
          "select": "cr",
          "cond": {
            "path": "properties",
            "op": "regex",
            "value": "(?i)iot:(Connect|\\*)"
          }
        }
      ]
    },
    {
      "id": "publish",
      "tier": "core",
      "quote": "publish",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "iotpol",
          "cond": {
            "path": "PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "iot:Publish"
          }
        },
        {
          "kind": "attr",
          "select": "fn",
          "cond": {
            "path": "Code.ZipFile",
            "op": "regex",
            "value": "(?i)iot:(Publish|\\*)"
          }
        },
        {
          "kind": "attr",
          "select": "cr",
          "cond": {
            "path": "properties",
            "op": "regex",
            "value": "(?i)iot:(Publish|\\*)"
          }
        }
      ]
    },
    {
      "id": "subscribe",
      "tier": "core",
      "quote": "subscribe to topics",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "iotpol",
          "cond": {
            "path": "PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "iot:Subscribe"
          }
        },
        {
          "kind": "attr",
          "select": "fn",
          "cond": {
            "path": "Code.ZipFile",
            "op": "regex",
            "value": "(?i)iot:(Subscribe|\\*)"
          }
        },
        {
          "kind": "attr",
          "select": "cr",
          "cond": {
            "path": "properties",
            "op": "regex",
            "value": "(?i)iot:(Subscribe|\\*)"
          }
        }
      ]
    },
    {
      "id": "thing_scoped",
      "tier": "core",
      "quote": "scoped to their own thing name",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "iotpol",
          "cond": {
            "path": "PolicyDocument",
            "op": "contains",
            "value": "ThingName"
          }
        },
        {
          "kind": "attr",
          "select": "fn",
          "cond": {
            "path": "Code.ZipFile",
            "op": "contains",
            "value": "ThingName"
          }
        },
        {
          "kind": "attr",
          "select": "cr",
          "cond": {
            "path": "properties",
            "op": "contains",
            "value": "ThingName"
          }
        }
      ]
    },
    {
      "id": "output",
      "tier": "detail",
      "quote": "the template should output the generated policy name",
      "kind": "any_of",
      "checks": [
        {
          "kind": "ref",
          "from": "out_name",
          "to": "cr"
        },
        {
          "kind": "ref",
          "from": "out_name",
          "to": "iotpol"
        }
      ]
    },
    {
      "id": "fn_role_create_policy",
      "tier": "extra",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "role",
          "cond": {
            "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "iot:CreatePolicy"
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "AWS::IAM::Policy",
              "AWS::IAM::ManagedPolicy"
            ]
          },
          "cond": {
            "path": "PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "iot:CreatePolicy"
          }
        }
      ]
    },
    {
      "id": "role_trust_lambda",
      "tier": "extra",
      "kind": "attr",
      "select": "role",
      "cond": {
        "path": "AssumeRolePolicyDocument.Statement.*.Principal.Service.*",
        "op": "eq",
        "value": "lambda.amazonaws.com"
      }
    },
    {
      "id": "basic_exec",
      "tier": "extra",
      "kind": "attr",
      "select": "role",
      "cond": {
        "path": "ManagedPolicyArns.*",
        "op": "regex",
        "value": "service-role/AWSLambdaBasicExecutionRole$"
      }
    }
  ],
  "notes": "Policy document lives in the Lambda inline code in the GT, so connect/publish/subscribe/thing-name checks accept an AWS::IoT::Policy resource, the function code text, or the document passed as custom-resource properties. Runtime stays pinned to nodejs24.x because the prompt states it; templates using nodejs22.x fail it on purpose."
}
