 "checks": [
  {
   "id": "pool",
   "kind": "attr",
   "tier": "core",
   "quote": "a user pool named \"agentcore-gateway-pool\"",
   "select": "pool",
   "cond": {
    "path": "UserPoolName",
    "op": "eq",
    "value": "agentcore-gateway-pool"
   }
  },
  {
   "id": "email_username",
   "kind": "attr",
   "tier": "core",
   "quote": "uses email as the username",
   "select": "pool",
   "cond": {
    "path": "UsernameAttributes.*",
    "op": "eq",
    "value": "email"
   }
  },
  {
   "id": "autoverify",
   "kind": "attr",
   "tier": "core",
   "quote": "auto-verifies email",
   "select": "pool",
   "cond": {
    "path": "AutoVerifiedAttributes.*",
    "op": "eq",
    "value": "email"
   }
  },
  {
   "id": "mfa_off",
   "kind": "any_of",
   "tier": "core",
   "quote": "has MFA turned off",
   "checks": [
    {
     "kind": "attr",
     "select": "pool",
     "cond": {
      "path": "MfaConfiguration",
      "op": "eq",
      "value": "OFF"
     }
    },
    {
     "kind": "attr",
     "select": "pool",
     "cond": {
      "path": "MfaConfiguration",
      "op": "absent"
     }
    }
   ]
  },
  {
   "id": "pw_len",
   "kind": "attr",
   "tier": "core",
   "quote": "a minimum length of 12 characters",
   "select": "pool",
   "cond": {
    "path": "Policies.PasswordPolicy.MinimumLength",
    "op": "eq",
    "value": 12
   }
  },
  {
   "id": "pw_classes",
   "kind": "all_of",
   "tier": "core",
   "quote": "requiring uppercase, lowercase, numbers, and symbols",
   "checks": [
    {
     "kind": "attr",
     "select": "pool",
     "cond": {
      "path": "Policies.PasswordPolicy.RequireUppercase",
      "op": "eq",
      "value": "true"
     }
    },
    {
     "kind": "attr",
     "select": "pool",
     "cond": {
      "path": "Policies.PasswordPolicy.RequireLowercase",
      "op": "eq",
      "value": "true"
     }
    },
    {
     "kind": "attr",
     "select": "pool",
     "cond": {
      "path": "Policies.PasswordPolicy.RequireNumbers",
      "op": "eq",
      "value": "true"
     }
    },
    {
     "kind": "attr",
     "select": "pool",
     "cond": {
      "path": "Policies.PasswordPolicy.RequireSymbols",
      "op": "eq",
      "value": "true"
     }
    }
   ]
  },
  {
   "id": "symbols_param",
   "kind": "attr",
   "tier": "detail",
   "quote": "symbols should be controllable through a true/false parameter",
   "justify": "a true/false parameter for symbols: a boolean default on a parameter whose name says symbols/special characters",
   "select": {
    "types": [
     "__parameter__"
    ],
    "where": [
     {
      "path": "name",
      "op": "regex",
      "value": "(?i)(symbol|special)"
     }
    ]
   },
   "cond": {
    "path": "default",
    "op": "regex",
    "value": "(?i)^(true|false)$"
   }
  },
  {
   "id": "domain",
   "kind": "exists",
   "tier": "core",
   "quote": "a hosted domain",
   "select": "domain"
  },
  {
   "id": "domain_pool",
   "kind": "ref",
   "tier": "detail",
   "quote": "Give the pool a hosted domain",
   "from": "domain",
   "to": "pool"
  },
  {
   "id": "domain_prefix",
   "kind": "attr",
   "tier": "detail",
   "quote": "whose prefix is built from the region name plus a fragment of the stack ID",
