   "select": "ssm",
   "cond": {
    "path": "Value",
    "op": "regex",
    "value": "\\.well-known/openid-configuration"
   }
  },
  {
   "id": "ssm_arn_domain",
   "kind": "all_of",
   "tier": "detail",
   "quote": "user pool ARN, and hosted domain URL as SSM String parameters",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "AWS::SSM::Parameter"
      ],
      "where": [
       {
        "path": "Name",
        "op": "regex",
