    {
     "kind": "attr",
     "select": "rs",
     "cond": {
      "path": "Scopes.*.ScopeName",
      "op": "eq",
      "value": "write"
     }
    },
    {
     "kind": "attr",
     "select": "rs",
     "cond": {
      "path": "Scopes.*.ScopeName",
      "op": "eq",
      "value": "admin"
     }
    }
   ]
  },
  {
   "id": "rs_pool",
   "kind": "ref",
   "tier": "detail",
   "quote": "a resource server with the identifier",
