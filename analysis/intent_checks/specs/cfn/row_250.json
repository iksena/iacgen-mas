   "cond": {
    "path": "Domain",
    "op": "contains",
    "value": "us-east-1"
   },
   "justify": "the prefix includes the region name; the adapter resolves AWS::Region to us-east-1"
  },
  {
   "id": "rs",
   "kind": "exists",
   "tier": "core",
   "quote": "a resource server with the identifier \"agentcore-gateway\"",
   "select": "rs"
