    {
      "id": "scope_alarms",
      "tier": "core",
      "quote": "The first four should be scoped to CloudWatch alarm resources",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": {
            "types": [
              "AWS::Config::ConfigRule"
            ],
            "where": [
              {
                "path": "Source.SourceIdentifier",
                "op": "in",
                "value": [
                  "CLOUDWATCH_ALARM_ACTION_CHECK",
                  "CLOUDWATCH_ALARM_ACTION_ENABLED_CHECK",
                  "CLOUDWATCH_ALARM_SETTINGS_CHECK"
                ]
              }
            ]
          },
          "cond": {
            "path": "Scope.ComplianceResourceTypes.*",
            "op": "eq",
            "value": "AWS::CloudWatch::Alarm"
          },
          "quantifier": "all"
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "AWS::Config::ConformancePack"
            ]
          },
          "cond": {
            "path": "TemplateBody",
            "op": "regex",
            "value": "(?s)(ComplianceResourceTypes.{0,80}AWS::CloudWatch::Alarm.*){3}"
          }
        }
      ]
    },
    {
      "id": "params_exist",
      "tier": "core",
      "quote": "Expose the rule inputs as parameters",
      "justify": "the stated defaults are three action flags, a metric and a resource type; a pack may hold its parameters itself",
      "kind": "any_of",
      "checks": [
        {
          "kind": "exists",
          "select": {
            "types": [
              "__parameter__"
            ],
            "where": [
              {
                "path": "default",
                "op": "in",
                "value": [
                  "true",
                  "false",
                  "CPUUtilization",
                  "AWS::EC2::Instance"
                ]
              }
            ]
          },
          "min": 3
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "AWS::Config::ConformancePack"
            ]
          },
          "cond": {
            "path": "ConformancePackInputParameters",
            "op": "len_gte",
            "value": 3
          }
        },
        {
          "kind": "attr",
          "select": {
            "types": [
              "AWS::Config::ConformancePack"
            ]
          },
          "cond": {
            "path": "TemplateBody",
            "op": "regex",
            "value": "(?s)((^|\\n)Parameters:|\"Parameters\"\\s*:).*Default"
          }
        }
      ]
    },
    {
