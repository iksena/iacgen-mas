    },
    {
      "id": "policy_delete",
      "tier": "extra",
      "kind": "attr",
      "select": "pols",
      "cond": {
        "path": "PolicyDocument.Statement.*.Action.*",
        "op": "glob_covers",
        "value": "dynamodb:DeleteItem"
      }
