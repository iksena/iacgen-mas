{
  "lang": "cfn",
  "row_number": 264,
  "source_hash": {
    "gt": "0fb1a15e5f3cc4ee5beda88b64120250ac0417d8f16ed552c509ce31dd23c6a7",
    "prompt": "992f940cd991cabd1e5279e395dbc4fdce9339a03faa4901f31a1fb2db74f270"
  },
  "selectors": {
    "tables": {
      "types": [
        "AWS::DynamoDB::Table",
        "AWS::DynamoDB::GlobalTable"
      ]
    }
  },
  "checks": [
    {
      "id": "six_tables",
      "kind": "exists",
      "tier": "core",
      "select": "tables",
      "min": 6,
      "max": 6,
      "quote": "consisting of six on-demand tables"
    },
    {
      "id": "pay_per_request",
      "kind": "attr",
      "tier": "core",
      "select": "tables",
      "quantifier": "all",
      "cond": {
        "path": "BillingMode",
        "op": "eq",
        "value": "PAY_PER_REQUEST"
      },
      "quote": "pay-per-request billing rather than provisioned capacity"
    },
    {
      "id": "prefix",
      "kind": "attr",
      "tier": "core",
      "select": "tables",
      "quantifier": "all",
      "cond": {
        "path": "TableName",
        "op": "regex",
        "value": "^socless_"
      },
      "quote": "use the socless_ naming prefix"
    },
    {
      "id": "k_event",
      "kind": "exists",
      "tier": "core",
      "quote": "an events table keyed on an event identifier",
      "select": {
        "types": [
          "AWS::DynamoDB::Table",
          "AWS::DynamoDB::GlobalTable"
        ],
        "where": [
          {
            "path": "TableName",
            "op": "regex",
            "value": "(?i)event"
          },
          {
            "path": "KeySchema.*",
            "op": "match",
            "value": [
              {
                "path": "AttributeName",
                "op": "regex",
                "value": "(?i)^(event[-_]?)?(id|identifier|uuid|guid)$"
              },
              {
                "path": "KeyType",
                "op": "eq",
                "value": "HASH"
              }
            ]
          }
        ]
      },
      "justify": "keyed on means the partition (HASH) key; the table is recognised by the purpose word the prompt gives it, and on such a table a bare id is that entity identifier"
    },
    {
      "id": "k_exec",
      "kind": "exists",
      "tier": "core",
      "quote": "an execution results table keyed on an execution identifier",
      "select": {
        "types": [
          "AWS::DynamoDB::Table",
          "AWS::DynamoDB::GlobalTable"
        ],
        "where": [
          {
            "path": "TableName",
            "op": "regex",
            "value": "(?i)execution|result"
          },
          {
            "path": "KeySchema.*",
            "op": "match",
            "value": [
              {
                "path": "AttributeName",
                "op": "regex",
                "value": "(?i)^(execution[-_]?)?(id|identifier|uuid|guid)$"
              },
              {
                "path": "KeyType",
                "op": "eq",
                "value": "HASH"
              }
            ]
          }
        ]
      },
      "justify": "keyed on means the partition (HASH) key; the table is recognised by the purpose word the prompt gives it, and on such a table a bare id is that entity identifier"
    },
    {
      "id": "k_msg",
      "kind": "exists",
      "tier": "core",
      "quote": "a message responses table keyed on a message identifier",
      "select": {
        "types": [
          "AWS::DynamoDB::Table",
          "AWS::DynamoDB::GlobalTable"
        ],
        "where": [
          {
            "path": "TableName",
            "op": "regex",
            "value": "(?i)message|response"
          },
          {
            "path": "KeySchema.*",
            "op": "match",
            "value": [
              {
                "path": "AttributeName",
                "op": "regex",
                "value": "(?i)^(message[-_]?)?(id|identifier|uuid|guid)$"
              },
              {
                "path": "KeyType",
                "op": "eq",
                "value": "HASH"
              }
            ]
          }
        ]
      },
      "justify": "keyed on means the partition (HASH) key; the table is recognised by the purpose word the prompt gives it, and on such a table a bare id is that entity identifier"
    },
    {
      "id": "k_playbook",
      "kind": "exists",
      "tier": "core",
      "quote": "a playbooks table keyed on the state machine name",
      "select": {
        "types": [
          "AWS::DynamoDB::Table",
          "AWS::DynamoDB::GlobalTable"
        ],
        "where": [
          {
            "path": "TableName",
            "op": "regex",
            "value": "(?i)playbook"
          },
          {
            "path": "KeySchema.*",
            "op": "match",
            "value": [
              {
                "path": "AttributeName",
                "op": "regex",
                "value": "(?i)^state[-_]?machine([-_]?name)?$"
              },
              {
                "path": "KeyType",
                "op": "eq",
                "value": "HASH"
              }
            ]
          }
        ]
      },
      "justify": "keyed on means the partition (HASH) key; the table is recognised by the purpose word the prompt gives it"
    },
    {
      "id": "k_mapping",
      "kind": "exists",
      "tier": "core",
      "quote": "a custom mappings table keyed on a lookup key",
      "select": {
        "types": [
          "AWS::DynamoDB::Table",
          "AWS::DynamoDB::GlobalTable"
        ],
        "where": [
          {
            "path": "TableName",
            "op": "regex",
            "value": "(?i)mapping|lookup"
          },
          {
            "path": "KeySchema.*",
            "op": "match",
            "value": [
              {
                "path": "AttributeName",
                "op": "regex",
                "value": "(?i)^(lookup.*|.*key)$"
              },
              {
                "path": "KeyType",
                "op": "eq",
                "value": "HASH"
              }
            ]
          }
        ]
      },
      "justify": "keyed on means the partition (HASH) key; the table is recognised by the purpose word the prompt gives it"
    },
    {
      "id": "k_dedup",
      "kind": "exists",
      "tier": "core",
      "quote": "a deduplication table keyed on a dedup hash",
      "select": {
        "types": [
          "AWS::DynamoDB::Table",
          "AWS::DynamoDB::GlobalTable"
        ],
        "where": [
          {
            "path": "TableName",
            "op": "regex",
            "value": "(?i)dedup|duplicat"
          },
          {
            "path": "KeySchema.*",
            "op": "match",
            "value": [
              {
                "path": "AttributeName",
                "op": "regex",
                "value": "(?i)^(dedup(lication)?[-_]?)?hash$"
              },
              {
                "path": "KeyType",
                "op": "eq",
                "value": "HASH"
              }
            ]
          }
        ]
      },
      "justify": "keyed on means the partition (HASH) key; the table is recognised by the purpose word the prompt gives it"
    },
    {
      "id": "outputs",
      "kind": "exists",
      "tier": "detail",
      "quote": "have their names published as stack outputs",
      "select": {
        "types": [
          "__output__"
        ],
        "where": [
          {
            "path": "value",
            "op": "present"
          },
          {
            "path": "value.attr",
            "op": "absent"
          },
          {
            "path": "value",
            "op": "regex",
            "value": "^\\{\"ref\"|^socless_|^\\$\\{[^}]+\\}$"
          }
        ]
      },
      "distinct_path": "value",
      "min": 6,
      "justify": "six tables stated, so six distinct name outputs; Ref to a DynamoDB table returns its name, while GetAtt returns an ARN or stream ARN"
    },
    {
      "id": "x_hash_keytype",
      "kind": "attr",
      "tier": "extra",
      "select": "tables",
      "quantifier": "all",
      "cond": {
        "path": "KeySchema.*.KeyType",
        "op": "eq",
        "value": "HASH",
        "every": true
      }
    },
    {
      "id": "x_string_keys",
      "kind": "attr",
      "tier": "extra",
      "select": "tables",
      "quantifier": "all",
      "cond": {
        "path": "AttributeDefinitions.*.AttributeType",
        "op": "eq",
        "value": "S",
        "every": true
      }
    }
  ],
  "notes": "Table purpose is only observable through TableName, so each k_* check binds a purpose word from the prompt to the key on the same table. Names are matched loosely because the prompt gives no exact names (socless_results and socless_mappings pass). A bare id counts as the identifier on the events, execution and message tables (ground truth events uses id). outputs cannot tie a Ref target to the table type in one leaf, so a Ref to a non-table resource would count. Export is not required: the prompt asks for stack outputs only. Core share is high because the prompt is short and each of the six tables is a primary resource. Reviewed against 5 real templates: all pass every core and detail check."
}
