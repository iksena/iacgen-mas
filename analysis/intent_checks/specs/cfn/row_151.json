      "tier": "core",
      "kind": "ref",
      "from": "flow",
      "to": "vpc",
      "quote": "a VPC flow log capturing all traffic for the VPC"
    },
    {
      "id": "flow_lg",
      "tier": "core",
      "kind": "any_of",
      "checks": [
        {
          "kind": "ref",
          "from": "flow",
          "to": "lg"
