    {
      "id": "x_dns_hostnames",
      "tier": "extra",
      "kind": "attr",
      "select": "vpc",
      "cond": {
        "path": "EnableDnsHostnames",
        "op": "eq",
        "value": true
      }
    },
    {
      "id": "x_dns_support",
      "tier": "extra",
      "kind": "attr",
      "select": "vpc",
      "cond": {
        "path": "EnableDnsSupport",
        "op": "eq",
        "value": true
