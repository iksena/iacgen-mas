      "tier": "detail",
      "kind": "any_of",
      "checks": [
        {
          "kind": "ref",
          "from": "flow_role",
          "to": "key"
        },
        {
          "kind": "attr",
          "select": "flow_role",
          "cond": {
            "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "kms:GenerateDataKey"
          }
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "AWS::IAM::Policy"
            ],
            "where": [
              {
                "path": "PolicyDocument.Statement.*.Action.*",
                "op": "glob_covers",
                "value": "kms:GenerateDataKey"
              }
            ]
          },
          "to": "flow_role"
        },
        {
          "kind": "attr",
          "select": "key",
          "cond": {
            "path": "KeyPolicy.Statement.*.Principal.Service.*",
            "op": "regex",
            "value": "(?i)(vpc-flow-logs|logs\\.)"
