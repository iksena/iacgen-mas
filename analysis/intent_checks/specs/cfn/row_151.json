      "quote": "an IAM role allowing the VPC Flow Logs service to write to CloudWatch Logs"
    },
    {
      "id": "flow_role_logs",
      "tier": "core",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "flow_role",
          "cond": {
            "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "logs:PutLogEvents"
          }
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "AWS::IAM::Policy"
            ],
            "where": [
              {
                "path": "PolicyDocument.Statement.*.Action.*",
                "op": "glob_covers",
                "value": "logs:PutLogEvents"
              }
            ]
          },
          "to": "flow_role"
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "AWS::IAM::ManagedPolicy"
            ],
            "where": [
              {
                "path": "PolicyDocument.Statement.*.Action.*",
                "op": "glob_covers",
                "value": "logs:PutLogEvents"
              }
            ]
          },
          "to": "flow_role",
          "bidirectional": true
        },
        {
          "kind": "attr",
          "select": "flow_role",
          "cond": {
            "path": "ManagedPolicyArns.*",
            "op": "regex",
            "value": "CloudWatchLogsFullAccess"
          }
        }
      ],
      "quote": "an IAM role allowing the VPC Flow Logs service to write to CloudWatch Logs using that key",
      "justify": "write to CloudWatch Logs requires logs:PutLogEvents"
    },
    {
