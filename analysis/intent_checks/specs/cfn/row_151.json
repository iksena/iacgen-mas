          "to": "lg",
          "to_path": "LogGroupName"
        }
      ],
      "quote": "a CloudWatch Log Group for the flow log data"
    },
    {
      "id": "flow_role_ref",
      "tier": "detail",
      "kind": "ref",
      "from": "flow",
      "to": "flow_role",
      "quote": "an IAM role allowing the VPC Flow Logs service to write to CloudWatch Logs"
    },
