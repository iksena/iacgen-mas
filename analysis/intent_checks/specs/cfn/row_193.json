        {
          "kind": "attr",
          "select": "role_appsync",
          "cond": {
            "path": "Policies.*.PolicyDocument.Statement.*",
            "op": "match",
            "value": [
              {
                "path": "Action.*",
                "op": "regex",
                "value": "(?i)^(dynamodb:|\\*$)"
              },
              {
                "path": "Resource.*",
                "op": "regex",
                "value": "index/\\*|table/\\*|^\\*$"
              }
            ]
