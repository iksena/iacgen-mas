              {
                "path": "AssumeRolePolicyDocument",
                "op": "regex",
                "value": "appsync\\.amazonaws\\.com"
              },
              {
                "path": "",
                "op": "regex",
                "value": "(?i)AmazonDynamoDBFullAccess|(^|[^:])dynamodb:(\\*|Put\\*|PutItem\\*?)([^A-Za-z0-9_]|$)"
              },
              {
                "path": "",
                "op": "regex",
                "value": "(?i)AmazonDynamoDBFullAccess|(^|[^:])dynamodb:(\\*|Update\\*|UpdateItem\\*?)([^A-Za-z0-9_]|$)"
