   "kind": "attr",
   "select": "lc",
   "tier": "detail",
   "quote": "registers a Jupyter kernel on notebook creation and start",
   "cond": {
    "path": "OnStart",
    "op": "regex",
    "value": "(?i)(ipykernel|kernelspec|kernel)"
   },
   "justify": "registering a Jupyter kernel is done with ipykernel/kernelspec"
  }
 ],
