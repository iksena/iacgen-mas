          {
            "path": "",
            "op": "regex",
            "value": "(?is)per.{0,3}user|\\bby\\b[^|]*user|by.{0,3}user"
          }
        ]
      },
      "justify": "a rate is per minute (TPM, a rate word or 1-minute bins), grouped per user"
    },
    {
