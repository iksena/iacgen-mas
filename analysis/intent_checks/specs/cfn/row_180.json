    },
    {
     "kind": "attr",
     "select": "fnc",
     "cond": {
      "path": "Code",
      "op": "regex",
      "value": "(?i)UpdateItem|\\bupdate\\s*\\("
     }
    },
    {
     "kind": "attr",
     "select": "fnc",
     "cond": {
      "path": "Code",
      "op": "regex",
      "value": "(?i)DeleteItem|\\b(remove|delete)\\s*\\("
     }
    },
    {
     "kind": "attr",
     "select": "fnc",
     "cond": {
      "path": "Code",
      "op": "regex",
      "value": "(?i)GetItem|\\bget\\s*\\("
     }
    },
    {
     "kind": "attr",
     "select": "fnc",
     "cond": {
      "path": "Code",
      "op": "regex",
      "value": "(?is)query.*index|index.*query"
     }
    }
   ],
   "justify": "create/update/delete/get/query map to the DynamoDB put/update/delete/get/query operations; helper-module call names accepted"
  }
 ],
 "notes": "GraphQL field names are not stated in the prompt, so schema checks accept common verb prefixes (create/add/put, update/edit, delete/remove, get, list/all) and any Query field taking an owner argument. Function code checks assume inline Code (the prompt asks for a self-contained template)."
}
