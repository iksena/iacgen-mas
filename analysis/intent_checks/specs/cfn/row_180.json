     "kind": "attr",
     "select": {
      "types": [
       "AWS::AppSync::GraphQLSchema"
      ]
     },
     "cond": {
      "path": "Definition",
      "op": "regex",
      "value": "(?s)type\\s+Mutation\\s*\\{[^}]*\\b(delete|remove)\\w*\\s*\\("
     }
