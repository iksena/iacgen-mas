     "kind": "attr",
     "select": {
      "types": [
       "AWS::AppSync::GraphQLSchema"
      ]
     },
     "cond": {
      "path": "Definition",
      "op": "regex",
      "value": "@aws_subscribe\\(\\s*mutations\\s*:\\s*\\[[^\\]]*\"(update|edit)\\w*\""
     }
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "AWS::AppSync::GraphQLSchema"
      ]
     },
     "cond": {
      "path": "Definition",
      "op": "regex",
      "value": "@aws_subscribe\\(\\s*mutations\\s*:\\s*\\[[^\\]]*\"(delete|remove)\\w*\""
     }
