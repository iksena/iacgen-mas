   "quote": "individual JavaScript functions for each data operation",
   "checks": [
    {
     "kind": "attr",
     "select": "fnc",
     "cond": {
      "path": "Code",
      "op": "regex",
      "value": "(?i)PutItem|\\bput\\s*\\("
