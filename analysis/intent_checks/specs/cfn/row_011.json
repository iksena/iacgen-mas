{
  "lang": "cfn",
  "row_number": 11,
  "source_hash": {
    "gt": "30b23cc3b8a1b6d90e8260c82a14642d2bbd2f6c85d6118947d4850f3380e5c7",
    "prompt": "22bf57e9c67dd20327ad8b7a70f96e24905f022d221a2ea760c9cf3da3738610"
  },
  "selectors": {
    "ca": {
      "types": [
        "AWS::CodePipeline::CustomActionType"
      ]
    }
  },
  "checks": [
    {
      "id": "custom_action",
      "kind": "exists",
      "select": "ca",
      "tier": "core",
      "quote": "creates a CodePipeline custom action type"
    },
    {
      "id": "category_deploy",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "Category",
        "op": "eq",
        "value": "Deploy"
      },
      "tier": "core",
      "quote": "for deploying to AWS OpsWorks"
    },
    {
      "id": "provider_stack_name",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "Provider",
        "op": "eq",
        "value": "stack"
      },
      "tier": "core",
      "quote": "a provider name equal to the stack name",
      "justify": "stack name resolves to the pseudo-parameter value 'stack'"
    },
    {
      "id": "version_1",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "Version",
        "op": "eq",
        "value": 1
      },
      "tier": "core",
      "quote": "a default version of 1"
    },
    {
      "id": "prop_bucket",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "ConfigurationProperties.*",
        "op": "match",
        "value": [
          {
            "path": "Name",
            "op": "eq",
            "value": "Deploy-Bucket"
          }
        ]
      },
      "tier": "detail",
      "quote": "configuration properties for Deploy-Bucket"
    },
    {
      "id": "prop_stack_id",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "ConfigurationProperties.*",
        "op": "match",
        "value": [
          {
            "path": "Name",
            "op": "eq",
            "value": "OpsWorks-Stack-ID"
          }
        ]
      },
      "tier": "detail",
      "quote": "OpsWorks-Stack-ID"
    },
    {
      "id": "prop_app_id",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "ConfigurationProperties.*",
        "op": "match",
        "value": [
          {
            "path": "Name",
            "op": "eq",
            "value": "OpsWorks-App-ID"
          },
          {
            "path": "Key",
            "op": "truthy"
          }
        ]
      },
      "tier": "detail",
      "quote": "OpsWorks-App-ID (with the latter flagged as a key property)"
    },
    {
      "id": "input_one",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "InputArtifactDetails.MaximumCount",
        "op": "eq",
        "value": 1
      },
      "tier": "core",
      "quote": "accept one input artifact",
      "justify": "one artifact = maximum count 1"
    },
    {
      "id": "output_none",
      "kind": "attr",
      "select": "ca",
      "cond": {
        "path": "OutputArtifactDetails.MaximumCount",
        "op": "eq",
        "value": 0
      },
      "tier": "core",
      "quote": "produce no output artifacts",
      "justify": "no artifacts = maximum count 0"
    }
  ],
  "notes": "PROMPT_GT_MISMATCH: the prompt says 'via a Lambda function', but the ground truth has no Lambda resource and a custom action type does not reference one, so it is not checked. input_one tests the maximum, because 'accept one' does not fix the minimum."
}
