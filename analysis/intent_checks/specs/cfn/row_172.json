    "op": "in",
    "value": [
     "aws:kms",
     "aws:kms:dsse"
    ]
   },
   "tier": "core",
   "quote": "an encrypted S3 bucket for file assets"
  },
  {
   "id": "bucket_versioning",
   "kind": "attr",
   "select": "bucket",
   "cond": {
    "path": "VersioningConfiguration.Status",
    "op": "eq",
    "value": "Enabled"
