                  "AWS::IAM::ManagedPolicy",
                  "AWS::IAM::RolePolicy"
                ]
              },
              {
                "path": "properties.PolicyDocument",
                "op": "regex",
                "value": "(?i)logs:(PutLogEvents|Put\\*|\\*)"
