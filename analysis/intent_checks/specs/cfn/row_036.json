        "AWS::Cognito::IdentityPool"
      ]
    },
    "role": {
      "types": [
        "AWS::IAM::Role"
      ]
    },
    "att": {
      "types": [
        "AWS::Cognito::IdentityPoolRoleAttachment"
      ]
    },
    "out": {
      "types": [
        "__output__"
      ]
    },
    "role_cog": {
      "types": [
        "AWS::IAM::Role"
      ],
      "where": [
        {
          "path": "AssumeRolePolicyDocument",
          "op": "contains",
          "value": "cognito-identity.amazonaws.com"
        }
      ]
    },
    "att_unauth": {
      "types": [
        "AWS::Cognito::IdentityPoolRoleAttachment"
      ],
      "where": [
        {
          "path": "Roles.unauthenticated",
          "op": "present"
        }
      ]
    },
    "out_id": {
      "types": [
        "__output__"
      ],
      "where": [
        {
          "path": "value.attr",
          "op": "none_eq",
          "value": "Name"
        }
      ]
    }
  },
  "checks": [
    {
      "id": "pool",
      "tier": "core",
      "quote": "creates a Cognito Identity Pool",
      "kind": "exists",
      "select": "pool"
    },
    {
      "id": "unauth",
      "tier": "core",
      "quote": "must allow unauthenticated guest access",
      "kind": "attr",
      "select": "pool",
      "cond": {
        "path": "AllowUnauthenticatedIdentities",
        "op": "eq",
        "value": true
      }
    },
    {
      "id": "role_assoc",
      "tier": "core",
      "quote": "the associated IAM role",
      "kind": "ref",
      "from": "att_unauth",
      "to": "role",
      "justify": "the prompt's role serves the unauthenticated guests, so it fills the unauthenticated slot"
    },
    {
