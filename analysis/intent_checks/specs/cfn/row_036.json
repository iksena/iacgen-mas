      "quote": "Amazon Lex",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "role_cog",
          "cond": {
            "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
            "op": "regex",
            "value": "(?i)^(lex:|\\*$)"
          }
        },
        {
          "kind": "ref",
          "from": {
            "types": [
              "AWS::IAM::Policy",
              "AWS::IAM::ManagedPolicy"
            ],
            "where": [
              {
                "path": "PolicyDocument.Statement.*.Action.*",
                "op": "regex",
                "value": "(?i)^(lex:|\\*$)"
              }
            ]
          },
          "to": "role_cog",
          "bidirectional": true
        },
        {
          "kind": "attr",
          "select": "role_cog",
          "cond": {
            "path": "ManagedPolicyArns.*",
            "op": "regex",
            "value": ":aws:policy/.*Lex"
          }
        }
      ],
      "justify": "the prompt says the associated role grants this; a role associated with an identity pool is one that trusts cognito-identity"
    },
