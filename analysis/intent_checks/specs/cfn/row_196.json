        }
      ]
    },
    "ep_sg_only_https": {
      "types": [
        "AWS::EC2::SecurityGroup"
      ],
      "where": [
        {
          "path": "SecurityGroupIngress",
          "op": "len_eq",
          "value": 1
        },
        {
          "path": "SecurityGroupIngress.*",
          "op": "match",
          "value": [
            {
              "path": "IpProtocol",
              "op": "eq",
              "value": "tcp"
            },
            {
              "path": "FromPort",
              "op": "eq",
              "value": 443
            },
            {
              "path": "ToPort",
              "op": "eq",
              "value": 443
            }
          ]
        }
      ]
    },
    "sg_one_rule": {
      "types": [
        "AWS::EC2::SecurityGroup"
      ],
      "where": [
        {
          "path": "SecurityGroupIngress",
          "op": "len_eq",
          "value": 1
        }
      ]
    },
    "ep_sg_vpc_cidr_ref": {
      "types": [
        "AWS::EC2::SecurityGroup"
      ],
      "where": [
        {
          "path": "SecurityGroupIngress",
          "op": "len_eq",
          "value": 1
        },
        {
          "path": "SecurityGroupIngress.*.CidrIp",
          "op": "regex",
          "value": "(?i)CidrBlock"
        }
      ]
    }
  },
  "checks": [
    {
      "id": "vpc",
      "kind": "exists",
      "tier": "core",
      "quote": "creates a shared VPC",
      "select": "vpc"
    },
    {
      "id": "four_subnets",
      "kind": "exists",
      "tier": "core",
      "quote": "two public subnets and two private subnets",
      "justify": "2+2 subnets",
      "select": "subnets",
      "min": 4
    },
    {
      "id": "two_azs",
      "kind": "exists",
      "tier": "core",
      "quote": "spread across two Availability Zones",
      "justify": "two AZs",
      "select": "subnets",
      "distinct_path": "AvailabilityZone",
      "min": 2
    },
    {
      "id": "subnet_cidrs",
      "kind": "exists",
      "tier": "detail",
      "quote": "each with its own CIDR block parameter",
      "justify": "four subnets, each its own CIDR",
      "select": "subnets",
      "distinct_path": "CidrBlock",
      "min": 4
    },
    {
      "id": "cidr_params",
      "kind": "any_of",
      "tier": "detail",
      "quote": "each with its own CIDR block parameter",
      "justify": "four subnets each with its own CIDR parameter; subnet ranges are narrower than the VPC's, so the VPC parameter is not counted",
      "checks": [
        {
          "kind": "exists",
          "min": 4,
          "select": {
            "types": [
              "__parameter__"
            ],
            "where": [
              {
                "path": "default",
                "op": "regex",
                "value": "^[0-9.]+/(1[7-9]|2[0-8])$"
              }
            ]
          }
        },
        {
          "kind": "exists",
          "min": 4,
          "select": {
            "types": [
              "__parameter__"
            ],
            "where": [
              {
                "path": "name",
                "op": "regex",
                "value": "(?i)subnet.*(cidr|range|block)|(cidr|range|block).*subnet"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "igw",
      "kind": "exists",
      "tier": "core",
      "quote": "an Internet Gateway for the public subnets",
      "select": "igw"
    },
    {
      "id": "igw_route",
      "kind": "ref",
      "tier": "core",
      "quote": "an Internet Gateway for the public subnets",
      "from": {
        "types": [
          "AWS::EC2::Route"
        ]
      },
      "to": "igw"
    },
    {
      "id": "nat_per_az",
      "kind": "exists",
      "tier": "core",
      "quote": "a NAT Gateway per Availability Zone",
      "justify": "two AZs, one NAT each",
      "select": "nat",
      "min": 2
    },
    {
      "id": "nat_distinct_subnets",
      "kind": "exists",
      "tier": "detail",
      "quote": "a NAT Gateway per Availability Zone",
      "justify": "one NAT per AZ",
      "select": "nat",
      "distinct_path": "SubnetId",
      "min": 2
    },
    {
      "id": "private_route_nat",
      "kind": "ref",
      "tier": "core",
      "quote": "a NAT Gateway per Availability Zone for outbound access from the private subnets",
      "from": {
        "types": [
          "AWS::EC2::Route"
        ],
        "where": [
          {
            "path": "DestinationCidrBlock",
            "op": "eq",
            "value": "0.0.0.0/0"
          }
        ]
      },
      "to": "nat",
      "justify": "outbound access implies a default route"
    },
    {
      "id": "private_routes_each_nat",
      "kind": "exists",
      "tier": "detail",
      "quote": "a NAT Gateway per Availability Zone for outbound access from the private subnets",
      "justify": "two AZs, so routes point at two different NAT gateways",
      "select": {
        "types": [
          "AWS::EC2::Route"
        ],
        "where": [
          {
            "path": "NatGatewayId",
            "op": "present"
          }
        ]
      },
      "distinct_path": "NatGatewayId",
      "min": 2
    },
    {
      "id": "route_tables",
      "kind": "exists",
      "tier": "detail",
      "quote": "the associated route tables and subnet associations",
      "justify": "public and private tables",
      "select": "rts",
      "min": 2
    },
    {
      "id": "assoc",
      "kind": "exists",
      "tier": "detail",
      "quote": "the associated route tables and subnet associations",
      "justify": "four subnets associated",
      "select": {
        "types": [
          "AWS::EC2::SubnetRouteTableAssociation"
        ]
      },
      "min": 4
    },
    {
      "id": "s3_gateway",
      "kind": "any_of",
      "tier": "core",
      "quote": "an S3 gateway endpoint",
      "checks": [
        {
          "kind": "attr",
          "select": "s3ep",
          "cond": {
            "path": "VpcEndpointType",
            "op": "eq",
            "value": "Gateway"
