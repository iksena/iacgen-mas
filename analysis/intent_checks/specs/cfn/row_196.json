        },
        {
          "kind": "attr",
          "select": "s3ep",
          "cond": {
            "path": "VpcEndpointType",
            "op": "absent"
          }
        }
      ]
    },
    {
      "id": "s3_route_tables",
      "kind": "ref",
      "tier": "core",
      "quote": "reachable from all route tables",
