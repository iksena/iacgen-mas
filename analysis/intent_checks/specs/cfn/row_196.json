    {
      "id": "s3_all_rts",
      "kind": "attr",
      "tier": "detail",
      "quote": "reachable from all route tables",
      "justify": "public plus one private table per AZ",
      "select": "s3ep",
      "cond": {
        "path": "RouteTableIds",
        "op": "len_gte",
        "value": 3
      }
    },
    {
