    {
      "id": "ep_monitoring",
      "kind": "exists",
      "tier": "core",
      "quote": "for Systems Manager, EC2, CloudWatch Logs, CloudWatch Monitoring, STS, EMR, and KMS",
      "justify": "service name suffix for CloudWatch Monitoring",
      "select": {
        "types": [
          "AWS::EC2::VPCEndpoint"
        ],
        "where": [
          {
            "path": "VpcEndpointType",
            "op": "eq",
