    {
      "id": "ep_sts",
      "kind": "exists",
      "tier": "core",
      "quote": "for Systems Manager, EC2, CloudWatch Logs, CloudWatch Monitoring, STS, EMR, and KMS",
      "justify": "service name suffix for STS",
      "select": {
        "types": [
          "AWS::EC2::VPCEndpoint"
        ],
        "where": [
          {
            "path": "VpcEndpointType",
            "op": "eq",
            "value": "Interface"
          },
          {
            "path": "ServiceName",
            "op": "regex",
            "value": "(?i)\\.sts$"
          }
        ]
      }
