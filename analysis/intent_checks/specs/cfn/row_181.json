        },
        {
          "kind": "attr",
          "select": "dms",
          "cond": {
            "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
            "op": "glob_covers",
            "value": "kinesis:PutRecords"
          }
        },
        {
          "kind": "attr",
          "select": "dms",
          "cond": {
