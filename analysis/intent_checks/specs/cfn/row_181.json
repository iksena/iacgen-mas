            "op": "regex",
            "value": "(?i)kinesis.*fullaccess"
          }
        },
        {
          "kind": "ref",
          "from": "kin_pol",
          "to": "dms",
          "bidirectional": true
        }
      ],
      "tier": "core",
      "quote": "Provision roles for DMS to write to Kinesis",
      "justify": "writing to Kinesis means granting a Kinesis put action"
    },
