    {
      "id": "policy_connect",
      "kind": "attr",
      "select": "pol",
      "tier": "core",
      "quote": "allowing Connect, Publish, Subscribe, and Receive actions",
      "justify": "iot:Connect is the IoT action named in the prompt",
      "cond": {
        "path": "PolicyDocument.Statement.*",
        "op": "match",
        "value": [
          {
            "path": "Effect",
            "op": "eq",
            "value": "Allow"
          },
          {
            "path": "Action.*",
            "op": "glob_covers",
            "value": "iot:Connect"
          }
        ]
      }
    },
