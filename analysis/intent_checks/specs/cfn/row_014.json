   },
   "tier": "core",
   "quote": "a custom message defaulting to \"Hello from CloudFormation\""
  },
  {
   "id": "value_approval_enabled",
   "kind": "attr",
   "select": "param",
   "cond": {
    "path": "Value",
    "op": "regex",
    "value": "(?i)approval[^,}]*(enabled|true)"
   },
   "tier": "core",
   "quote": "an indication that the approval workflow is enabled"
  },
  {
   "id": "output_parameter_name",
   "kind": "ref",
   "from": "out",
   "to": "param",
