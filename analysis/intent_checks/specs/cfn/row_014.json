    "op": "contains",
    "value": "arn:aws:cloudformation:"
   },
   "tier": "detail",
   "quote": "a JSON string including the stack name, stack ID",
   "justify": "\"stack ID\" = AWS::StackId, which resolves to a CloudFormation stack ARN"
  },
  {
   "id": "value_stack_name",
   "kind": "attr",
   "select": "param",
   "cond": {
