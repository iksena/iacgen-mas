    "op": "regex",
    "value": ":\\s*\"stack\"\\s*[,}\\n]"
   },
   "tier": "detail",
   "quote": "a JSON string including the stack name"
  },
  {
   "id": "value_message",
   "kind": "attr",
   "select": "param",
   "cond": {
