   "kind": "attr",
   "select": {
    "types": [
     "__parameter__"
    ]
   },
   "cond": {
    "path": "default",
    "op": "eq",
    "value": "World"
   },
   "tier": "detail",
   "quote": "a name parameter that defaults to \"World\""
  },
  {
   "id": "value_stack_id",
   "kind": "attr",
   "select": "param",
   "cond": {
