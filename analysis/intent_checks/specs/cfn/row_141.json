  {
   "id": "alarm_error_metric",
   "tier": "detail",
   "quote": "error rates",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": "decl_alarms",
     "cond": {
      "path": "properties.MetricName",
      "op": "regex",
      "value": "(?i)error"
     }
    },
    {
     "kind": "attr",
     "select": "decl_alarms",
     "cond": {
      "path": "properties.Metrics.*.MetricStat.Metric.MetricName",
      "op": "regex",
      "value": "(?i)error"
     }
    }
