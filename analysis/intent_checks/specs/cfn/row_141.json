     "kind": "exists",
     "select": {
      "types": [
       "__parameter__"
      ],
      "where": [
       {
        "path": "name",
        "op": "regex",
        "value": "(?i)on.?demand|pay.?per.?request"
       }
      ]
     }
    }
   ],
   "tier": "detail",
   "quote": "with the ability to switch to on-demand"
