  {
   "id": "encryption_optional_cmk",
   "tier": "core",
   "quote": "Support optional server-side encryption using a customer-managed KMS key",
   "kind": "any_of",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__parameter__"
      ],
      "where": [
       {
        "path": "name",
        "op": "regex",
        "value": "(?i:kms|encrypt|cmk)|SSE|Sse"
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "__declared__"
      ],
      "where": [
