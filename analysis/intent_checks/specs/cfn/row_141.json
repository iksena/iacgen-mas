   "justify": "throttling alarms and error-rate alarms are two groups"
  },
  {
   "id": "alarm_throttle_metric",
   "tier": "detail",
   "quote": "throttling",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": "decl_alarms",
     "cond": {
