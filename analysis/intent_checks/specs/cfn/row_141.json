        "path": "type",
        "op": "eq",
        "value": "AWS::KMS::Key"
       },
       {
        "path": "gated",
        "op": "truthy"
       },
       {
        "path": "gate",
        "op": "regex",
        "value": "(?i:kms|encrypt|cmk)|SSE|Sse"
       }
      ]
     }
    }
   ]
  },
  {
