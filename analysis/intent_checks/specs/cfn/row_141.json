 "checks": [
  {
   "id": "table_exists",
   "kind": "exists",
   "select": "table",
   "tier": "core",
   "quote": "creates a DynamoDB table"
  },
  {
   "id": "partition_key_id",
   "kind": "all_of",
   "checks": [
    {
     "kind": "attr",
     "select": "table",
     "cond": {
      "path": "KeySchema.*",
      "op": "match",
      "value": [
       {
        "path": "KeyType",
        "op": "eq",
        "value": "HASH"
       },
       {
        "path": "AttributeName",
        "op": "eq",
        "value": "id"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "table",
     "cond": {
      "path": "AttributeDefinitions.*",
      "op": "match",
      "value": [
       {
        "path": "AttributeName",
        "op": "eq",
        "value": "id"
       },
       {
        "path": "AttributeType",
        "op": "eq",
        "value": "S"
       }
      ]
     }
    }
   ],
   "tier": "core",
   "quote": "partition key (defaulting to type String S and name 'id')",
   "justify": "partition key is the HASH key"
  },
  {
   "id": "partition_key_configurable",
   "kind": "exists",
   "select": {
    "types": [
     "__parameter__"
    ],
    "where": [
     {
      "path": "default",
      "op": "eq",
      "value": "id"
     }
    ]
   },
   "tier": "detail",
   "quote": "a configurable partition key"
  },
  {
   "id": "sort_key_default_number",
   "tier": "detail",
   "quote": "an optional sort key (defaulting to type Number N)",
   "kind": "any_of",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__parameter__"
      ],
      "where": [
       {
        "path": "default",
        "op": "eq",
        "value": "N"
       }
      ]
     }
    },
    {
     "kind": "attr",
     "select": "table",
     "cond": {
      "path": "AttributeDefinitions.*.AttributeType",
      "op": "eq",
      "value": "N"
     }
    }
   ]
  },
  {
   "id": "billing_provisioned_default",
   "kind": "any_of",
   "checks": [
    {
     "kind": "attr",
     "select": "table",
     "cond": {
      "path": "BillingMode",
      "op": "eq",
      "value": "PROVISIONED"
