    },
    {
     "kind": "attr",
     "select": "table",
     "cond": {
      "path": "ProvisionedThroughput.ReadCapacityUnits",
      "op": "present"
     }
    }
   ],
   "tier": "core",
   "quote": "using PROVISIONED billing by default"
  },
  {
   "id": "billing_switchable",
   "kind": "any_of",
   "checks": [
    {
     "kind": "exists",
     "select": {
      "types": [
       "__parameter__"
      ],
      "where": [
       {
        "path": "allowed_values.*",
        "op": "regex",
        "value": "(?i)^(on[- _]?demand|pay[-_ ]?per[-_ ]?request)$"
       }
      ]
     }
    },
    {
     "kind": "exists",
     "select": {
      "types": [
       "__parameter__"
      ],
      "where": [
       {
        "path": "default",
        "op": "regex",
        "value": "(?i)^provisioned$"
       }
      ]
     }
    },
