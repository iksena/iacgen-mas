      "checks": [
        {
          "kind": "attr",
          "select": "docpol",
          "cond": {
            "path": "PolicyDocument.Statement.*",
            "op": "match",
            "value": [
              {
                "path": "Effect",
                "op": "eq",
                "value": "Allow"
              },
              {
                "path": "Action.*",
                "op": "regex",
                "value": "(?i)^ec2:(describe|get|list)"
              },
              {
                "path": "Action.*",
                "op": "regex",
                "value": "(?i)^s3:(get|list)"
              },
              {
                "path": "Action.*",
                "op": "none_eq",
