    {
      "id": "repo_param",
      "kind": "attr",
      "tier": "core",
      "quote": "a repository root URL parameter, with a default value pointing to the standard AWS Service Catalog reference architectures S3 location",
      "justify": "the default points at the standard reference architectures S3 location",
      "select": "param",
      "cond": {
        "path": "default",
        "op": "regex",
        "value": "(?i)aws-service-catalog-reference-architectures"
      }
    },
    {
      "id": "stacks_use_repo",
      "kind": "attr",
      "tier": "detail",
      "quote": "pull the IAM templates from a repository root URL parameter",
      "justify": "URL resolves from the parameter default",
      "select": "stk",
      "quantifier": "all",
      "cond": {
        "path": "TemplateURL",
        "op": "regex",
        "value": "(?i)aws-service-catalog-reference-architectures"
      }
    },
    {
      "id": "output_group",
      "kind": "any_of",
      "tier": "detail",
      "quote": "expose the generated group and launch role references as outputs",
      "justify": "a group output either reads the nested stack's output, or references the IAM group directly",
      "checks": [
        {
          "kind": "exists",
          "select": {
            "types": [
              "__output__"
            ],
            "where": [
              {
                "path": "value.attr",
                "op": "regex",
                "value": "(?i)^Outputs\\..*group"
              }
            ]
          }
        },
        {
          "kind": "ref",
          "from": "out",
          "to": {
            "types": [
              "AWS::IAM::Group"
            ]
          }
        }
      ]
    },
    {
      "id": "output_roles",
      "kind": "any_of",
      "tier": "detail",
      "quote": "expose the generated group and launch role references as outputs",
      "justify": "four launch roles are named: EC2-VPC, EMR, RDS and S3",
      "checks": [
        {
          "kind": "exists",
          "min": 4,
          "select": {
            "types": [
              "__output__"
            ],
            "where": [
              {
                "path": "value.attr",
                "op": "regex",
                "value": "(?i)^Outputs\\..*role"
              }
            ]
          }
        },
        {
          "kind": "exists",
          "min": 4,
          "select": {
            "types": [
              "__output__"
            ],
            "where": [
              {
                "path": "name",
                "op": "regex",
                "value": "(?i)role"
              },
              {
                "path": "value.ref",
                "op": "present"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "x_timeout",
      "kind": "attr",
      "tier": "extra",
      "select": "stk",
      "quantifier": "all",
      "cond": {
        "path": "TimeoutInMinutes",
        "op": "present"
      }
    }
  ],
  "notes": "stacks_use_repo cannot separate a TemplateURL built from the parameter from a hard-coded one: a Ref to a parameter resolves to its default in both the resources and __declared__, so the same text appears either way. A template with hard-coded URLs and an unused parameter passes. Seen in the fixture, where the resolved URL is the same text in both views."
