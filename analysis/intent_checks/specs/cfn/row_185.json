              {
                "path": "DefinitionString",
                "op": "regex",
                "value": "(?s)\"States\"\\s*:\\s*\\{\\s*\"[^\"]+\"\\s*:\\s*\\{[^{}]*(\\{[^{}]*\\}[^{}]*)?\\}\\s*\\}"
              }
            ]
          }
        },
