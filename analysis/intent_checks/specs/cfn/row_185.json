          "kind": "exists",
          "select": {
            "types": [
              "AWS::StepFunctions::StateMachine"
            ],
            "where": [
              {
                "path": "Definition",
                "op": "regex",
                "value": "\"Type\"\\s*:\\s*\"Pass\""
