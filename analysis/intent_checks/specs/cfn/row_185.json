  "checks": [
    {
      "id": "state_machine",
      "kind": "exists",
      "select": "sm",
      "tier": "core",
      "quote": "creates a standard Step Functions state machine"
    },
    {
      "id": "standard_type",
      "kind": "any_of",
      "checks": [
        {
          "kind": "attr",
          "select": "sm",
          "cond": {
            "path": "StateMachineType",
            "op": "eq",
            "value": "STANDARD"
