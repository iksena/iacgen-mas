     "cond": {
      "path": "properties",
      "op": "contains",
      "value": "SMTPUser"
     }
    },
    {
     "kind": "attr",
     "select": "fn",
     "cond": {
      "path": "Environment",
      "op": "contains",
      "value": "SMTPUser"
     }
    }
   ]
  },
  {
   "id": "iam_username_default",
   "kind": "all_of",
   "tier": "core",
   "quote": "the desired IAM username (defaulting to SMTPUser)",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "__parameter__"
      ]
     },
     "cond": {
      "path": "default",
      "op": "eq",
      "value": "SMTPUser"
     }
    },
    {
     "kind": "attr",
     "select": "user",
     "cond": {
