      "op": "eq",
      "value": "SMTPUser"
     }
    }
   ]
  },
  {
   "id": "rotation_version_param",
   "kind": "any_of",
   "tier": "detail",
   "quote": "an access key rotation version number",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "__parameter__"
      ]
     },
     "cond": {
      "path": "name",
      "op": "regex",
      "value": "(?i)(version|serial|rotat)"
     }
    },
    {
     "kind": "join",
     "from": "key",
     "from_path": "Serial",
     "to": {
      "types": [
       "__parameter__"
      ]
     },
     "to_path": "default"
    }
   ]
  },
  {
   "id": "log_retention_param",
   "kind": "any_of",
   "tier": "detail",
   "quote": "the Lambda function's log retention period",
   "checks": [
    {
     "kind": "attr",
     "select": {
      "types": [
       "__parameter__"
      ]
     },
     "cond": {
      "path": "name",
      "op": "regex",
      "value": "(?i)retention"
     }
    },
    {
     "kind": "join",
     "from": "lg",
     "from_path": "RetentionInDays",
     "to": {
      "types": [
       "__parameter__"
      ]
     },
     "to_path": "default"
    }
   ]
  },
  {
   "id": "kms_arn_param",
   "kind": "attr",
   "tier": "detail",
   "quote": "an optional ARN of a customer-managed KMS key",
   "select": {
    "types": [
     "__parameter__"
    ]
   },
   "cond": {
    "path": "name",
    "op": "regex",
    "value": "(?i)kms|cmk|customer.?managed|encryption.?key"
   }
  },
  {
   "id": "lambda_role",
   "kind": "exists",
   "tier": "core",
   "quote": "the Lambda function's execution role",
   "select": "fn_role",
   "justify": "a Lambda execution role is assumed by the Lambda service"
  },
  {
   "id": "fn_uses_role",
   "kind": "ref",
   "tier": "detail",
   "quote": "the Lambda function's execution role",
   "from": "fn",
   "to": "role"
  },
  {
   "id": "role_trusts_lambda",
   "kind": "attr",
   "tier": "detail",
   "quote": "the Lambda function's execution role",
   "justify": "a Lambda execution role is assumed by the Lambda service",
   "select": "role",
   "cond": {
    "path": "AssumeRolePolicyDocument",
    "op": "contains",
    "value": "lambda.amazonaws.com"
   }
  },
  {
   "id": "role_ssm_write",
   "kind": "any_of",
   "tier": "core",
   "quote": "permissions to write to Parameter Store",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "AWS::IAM::Policy",
       "AWS::IAM::ManagedPolicy",
       "AWS::IAM::UserPolicy",
       "AWS::IAM::GroupPolicy",
       "AWS::IAM::RolePolicy"
      ],
      "where": [
       {
        "path": "PolicyDocument.Statement.*.Action.*",
        "op": "glob_covers",
        "value": "ssm:PutParameter"
       }
      ]
     },
     "to": "fn_role",
     "bidirectional": true
    },
    {
     "kind": "attr",
     "select": "fn_role",
     "cond": {
      "path": "Policies.*.PolicyDocument.Statement.*.Action.*",
      "op": "glob_covers",
      "value": "ssm:PutParameter"
     }
    },
    {
     "kind": "attr",
     "select": "fn_role",
     "cond": {
      "path": "ManagedPolicyArns.*",
      "op": "regex",
      "value": "AmazonSSMFullAccess$"
     }
    }
   ],
   "justify": "AmazonSSMFullAccess is the AWS-managed policy that includes ssm:PutParameter"
  },
  {
   "id": "log_group",
   "kind": "exists",
   "tier": "core",
   "quote": "a CloudWatch Log Group for its execution logs",
   "select": "lg"
  },
  {
   "id": "log_group_for_fn",
   "kind": "any_of",
   "tier": "detail",
   "quote": "a CloudWatch Log Group for its execution logs",
   "checks": [
    {
     "kind": "ref",
     "from": {
      "types": [
       "AWS::Logs::LogGroup"
      ]
     },
     "to": "fn"
    },
    {
     "kind": "attr",
     "select": {
      "types": [
       "AWS::Logs::LogGroup"
      ]
